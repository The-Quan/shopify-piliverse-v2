{% assign block_settings = block.settings %}

<div
  class="accordion{% if block_settings.dividers %} accordion--dividers{% endif %}"
  {{ block.shopify_attributes }}
>
  {% if closest.product.metafields.custom.feature_items.value != blank %}
    {% for item in closest.product.metafields.custom.feature_items.value %}
      <div class="accordion-item">
        <button type="button" class="accordion-header">
          <span class="accordion-title">
            {{ item.title }}
          </span>

          <span class="accordion-icon">
            <span class="icon-arrow">^</span>
          </span>
        </button>

        <div class="accordion-content">
          <div class="accordion-content-inner">
            {{ item.description }}
          </div>
        </div>
      </div>
    {% endfor %}
  {% endif %}
</div>

{% stylesheet %}
                  .accordion {
                    width: 100%;
                  }

                  .accordion-item {
                    margin-bottom: 18px;
                  }

                  .icon-arrow{
      display:inline-block;
      font-size:18px;
      transition:transform .3s ease;
    }

    .accordion-item.active .icon-arrow{
      transform:rotate(180deg);
    }

                  /* HEADER */
                .accordion-header {
                  width: 100%;
                  background: none;
                  border: none;
                  cursor: pointer;
                  display: flex;
                  justify-content: space-between;
                  align-items: flex-start;
                  text-align: left;
                  font-size: 17px;
                  font-weight: 400; /* bỏ in đậm */
                  padding: 0;
                  line-height: 1.6;
                }

                  /* TITLE */
              .accordion-title {
                display: flex;
                align-items: flex-start;
                gap: 8px;
              }

              .accordion-title::before {
              content: "✓";
              margin-right: 6px;
            }

         .accordion-title,
        .accordion-title a{
          color:#fff !important;
          text-decoration:none !important;
        }

        .accordion-header{
        color:#fff !important;
      }

      .accordion-header span{
        color:#fff !important;
      }

                  /* ICON */
                  .accordion-icon {
                    transition: transform 0.3s ease;
                  }

                  /* CONTENT ANIMATION */
                  .accordion-content {
                    max-height: 0;
                    overflow: hidden;
                    transition: max-height 0.4s ease;
                  }

                  .accordion-content-inner {
                    padding-top: 12px;
                    font-size: 16px;
                    line-height: 1.6;
                    color: #fff !important;
                  }

                  .accordion-content-inner * {
                    color: #fff !important;
                  }

                  .accordion-icon{
    min-width:20px;
    text-align:center;
  }
{% endstylesheet %}

<script>
  (() => {
    const initAccordion = (root = document) => {
      const sections = root.querySelectorAll('.accordion');

      sections.forEach((section) => {
        const items = section.querySelectorAll('.accordion-item');
        if (!items.length) return;

        items.forEach((item, index) => {
          const header = item.querySelector('.accordion-header');
          const content = item.querySelector('.accordion-content');
          if (!header || !content) return;

          if (!header.dataset.accordionBound) {
            header.dataset.accordionBound = 'true';

            header.addEventListener('click', () => {
              const isActive = item.classList.contains('active');

              items.forEach((i) => {
                i.classList.remove('active');
                const c = i.querySelector('.accordion-content');
                if (c) c.style.maxHeight = null;
              });

              if (!isActive) {
                item.classList.add('active');
                content.style.maxHeight = content.scrollHeight + 'px';
              }
            });
          }

          // Open first row only when there is no active row yet.
          if (index === 0 && !section.querySelector('.accordion-item.active')) {
            item.classList.add('active');
            content.style.maxHeight = content.scrollHeight + 'px';
          }
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initAccordion(document));
    } else {
      initAccordion(document);
    }

    // Re-bind when Shopify Theme Editor re-renders a section.
    document.addEventListener('shopify:section:load', (event) => {
      initAccordion(event.target || document);
    });
  })();
</script>

