{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ai_gen_id}} {
    display: block;
    background-color: {{ block.settings.background_color }};
    width: 100%;
  }

  .ai-footer-container-{{ai_gen_id}} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.top_padding }}px 20px 40px;
  }

  /* ================= MAIN LAYOUT ================= */

  .ai-footer-main-{{ai_gen_id}} {
    display: grid;
    grid-template-columns: 3fr 1fr 1fr 1fr;
    gap: 20px;
    margin-bottom: 40px;
  }

  /* ================= LOGO ================= */

  .ai-footer-logo-column-{{ai_gen_id}} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-footer-logo-{{ai_gen_id}} {
    max-width: 150px;
  }

  .ai-footer-logo-{{ai_gen_id}} img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ================= CONTACT ================= */

  .ai-footer-contact-{{ai_gen_id}} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-footer-contact-item-{{ai_gen_id}} {
    display: flex;
    align-items: flex-start;
    gap: 12px;

    color: {{ block.settings.link_color }};
    font-size: 14px;        /* FIX CỨNG */
    font-weight: 400;       /* FIX CỨNG */
    line-height: 1.5;
  }

  .ai-footer-contact-icon-{{ai_gen_id}} {
    width: 24px;
    height: 24px;
    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ICON GRAPHIC */
  .ai-footer-contact-icon-{{ai_gen_id}} img {
    width: 24px;
    height: 24px;
    display: block;
    object-fit: contain;
  }

  /* TEXT – CĂN THEO ICON */
  .ai-footer-contact-item-{{ai_gen_id}} > span,
  .ai-footer-contact-item-{{ai_gen_id}} > a {
    display: block;
    padding-top: 4px; /* KEY FIX – KHÔNG PHỤ THUỘC FONT */
    line-height: 1.5;
  }

  .ai-footer-contact-item-{{ai_gen_id}} a {
    color: {{ block.settings.link_color }};
    text-decoration: none;
  }

  .ai-footer-contact-item-{{ai_gen_id}} a:hover {
    text-decoration: underline;
  }

  /* ================= SOCIAL ================= */

  .ai-footer-social-{{ai_gen_id}} {
    display: flex;
    gap: 12px;
  }

  .ai-footer-social-link-{{ai_gen_id}} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: {{ block.settings.social_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-footer-social-link-{{ai_gen_id}} svg {
    width: 20px;
    height: 20px;
    fill: {{ block.settings.social_icon_color }};
  }

  /* ================= MENUS ================= */

  .ai-footer-menu-column-{{ai_gen_id}} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-footer-menu-heading-{{ai_gen_id}} {
    color: {{ block.settings.heading_color }};
    font-size: 15px;   /* FIX CỨNG */
    font-weight: 400;  /* FIX CỨNG */
    margin: 0;
  }

  .ai-footer-menu-list-{{ai_gen_id}} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-footer-menu-link-{{ai_gen_id}} {
    color: {{ block.settings.link_color }};
    font-size: 14px;   /* FIX CỨNG */
    font-weight: 400;  /* FIX CỨNG */
    text-decoration: none;
  }

  /* ================= BOTTOM ================= */

  .ai-footer-bottom-{{ai_gen_id}} {
    border-top: 1px solid {{ block.settings.border_color }};
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .ai-footer-copyright-{{ai_gen_id}} {
    color: {{ block.settings.copyright_color }};
    font-size: 12px; /* FIX CỨNG */
    margin: 0;
  }

  .ai-footer-legal-{{ai_gen_id}} {
    display: flex;
    gap: 16px;
  }

  .ai-footer-legal-link-{{ai_gen_id}} {
    color: {{ block.settings.copyright_color }};
    font-size: 12px;
    text-decoration: none;
  }
  
.ai-footer-company-detail-{{ai_gen_id}} span,
.ai-footer-company-detail-{{ai_gen_id}} span span {
  color: #5f5e6f;
}
  /* ================= MOBILE ================= */

  @media screen and (max-width: 749px) {
    .ai-footer-main-{{ai_gen_id}} {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .ai-footer-contact-{{ai_gen_id}},
    .ai-footer-social-{{ai_gen_id}} {
      display: none;
    }

    .ai-footer-mobile-menus-{{ai_gen_id}} {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .ai-footer-mobile-contact-{{ai_gen_id}} {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .ai-footer-bottom-{{ai_gen_id}} {
      flex-direction: column;
      align-items: flex-start;
    }

    .ai-footer-main-{{ai_gen_id}} > .ai-footer-menu-column-{{ai_gen_id}} {
      display: none;
    }

      /* MOBILE SOCIAL – NẰM NGANG */
  .ai-footer-mobile-social-{{ai_gen_id}} {
    display: flex;
    flex-direction: row;
    gap: 12px;
    align-items: center;
  }

  .ai-footer-mobile-contact-{{ai_gen_id}} .ai-footer-company-dropdown-{{ai_gen_id}} {
    width: 100%;
  }

  .ai-footer-mobile-contact-{{ai_gen_id}} .ai-footer-company-summary-{{ai_gen_id}} {
    width: 100%;
  }

  .ai-footer-mobile-contact-{{ai_gen_id}} .ai-footer-company-content-{{ai_gen_id}} {
    margin-left: 36px;
    padding-top: 12px;
  }

  .ai-footer-mobile-contact-{{ai_gen_id}} .ai-footer-company-arrow-{{ai_gen_id}} {
    display: block;
  }

  }

  @media screen and (min-width: 750px) {
    .ai-footer-mobile-menus-{{ai_gen_id}},
    .ai-footer-mobile-contact-{{ai_gen_id}},
    .ai-footer-mobile-social-{{ai_gen_id}} {
      display: none;
    }
  }

  /* ================= COMPANY DROPDOWN ================= */

.ai-footer-company-dropdown-{{ai_gen_id}} {
  color: {{ block.settings.link_color }};
}

.ai-footer-company-summary-{{ai_gen_id}} {
  width: 450px;
  display: flex;
  align-items: flex-start;
  gap: 12px;
  cursor: pointer;
  list-style: none;

  color: {{ block.settings.link_color }};
  font-size: 14px;
  font-weight: 400;
  line-height: 1.5;
}
.ai-footer-company-content-{{ai_gen_id}} {
  margin-left: 36px;
  padding-top: 4px;
  padding-left: 16px;
  border-left: 1px solid {{ block.settings.link_color }};

  display: flex;
  flex-direction: column;
  gap: 8px;
}

.ai-footer-company-arrow-{{ai_gen_id}} {
  color: {{ block.settings.link_color }};
}

.ai-footer-company-summary-{{ai_gen_id}}:hover > span:not(.ai-footer-contact-icon-{{ai_gen_id}}):not(.ai-footer-company-arrow-{{ai_gen_id}}) {
  color: {{ block.settings.link_color }};
  text-decoration: underline;
  text-underline-offset: 4px;
}

.ai-footer-company-summary-{{ai_gen_id}}::-webkit-details-marker {
  display: none;
}

.ai-footer-company-summary-{{ai_gen_id}} > span:not(.ai-footer-contact-icon-{{ai_gen_id}}) {
  display: block;
  padding-top: 4px;
}

.ai-footer-company-arrow-{{ai_gen_id}} {
  margin-left: auto;
  padding-top: 4px;
  font-size: 12px;
  transition: transform 0.2s ease;
}

.ai-footer-company-dropdown-{{ai_gen_id}}[open] .ai-footer-company-arrow-{{ai_gen_id}} {
  transform: rotate(180deg);
}

.ai-footer-company-content-{{ai_gen_id}} {
  margin-left: 36px;
  padding-top: 4px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.ai-footer-company-detail-{{ai_gen_id}} {
  display: flex;
  align-items: flex-start;
  gap: 12px;

  /*color: {{ block.settings.link_color }};*/
  color: #5f5e6f;
  font-size: 14px;
  font-weight: 400;
  line-height: 1.5;
}

.ai-footer-company-detail-{{ai_gen_id}} > span:not(.ai-footer-contact-icon-{{ai_gen_id}}) {
  display: block;
  padding-top: 4px;
}

{% endstyle %}

<footer-block-{{ ai_gen_id }} class="ai-footer-{{ai_gen_id}}" {{ block.shopify_attributes }}>
  <div class="ai-footer-container-{{ai_gen_id}}">
    <div class="ai-footer-main-{{ai_gen_id}}">
      <div class="ai-footer-logo-column-{{ai_gen_id}}">
        {% if block.settings.logo %}
          <div class="ai-footer-logo-{{ai_gen_id}}">
            <img
              src="{{ block.settings.logo | image_url: width: 300 }}"
              alt="{{ shop.name }}"
              loading="lazy"
              width="{{ block.settings.logo.width }}"
              height="{{ block.settings.logo.height }}"
            >
          </div>
        {% endif %}

        <div class="ai-footer-contact-{{ai_gen_id}}">
          {% if block.settings.company_name != blank %}
  <details class="ai-footer-company-dropdown-{{ai_gen_id}}" open>
    <summary class="ai-footer-company-summary-{{ai_gen_id}}">
      {% if block.settings.icon_company %}
        <span class="ai-footer-contact-icon-{{ai_gen_id}}">
          <img
            src="{{ block.settings.icon_company | image_url: width: 32 }}"
            alt="Company"
            loading="lazy"
            width="40"
            height="40"
          >
        </span>
      {% endif %}

      <span>{{ block.settings.company_name }}</span>
      <span class="ai-footer-company-arrow-{{ai_gen_id}}">⮟</span>
    </summary>

    <div class="ai-footer-company-content-{{ai_gen_id}}">
      {% if block.settings.address_1 != blank %}
        <div class="ai-footer-company-detail-{{ai_gen_id}}">
          {% if block.settings.icon_address %}
            <span class="ai-footer-contact-icon-{{ai_gen_id}}">
              <img
                src="{{ block.settings.icon_address | image_url: width: 32 }}"
                alt="Address"
                loading="lazy"
                width="40"
                height="40"
              >
            </span>
          {% endif %}
          <span>{{ block.settings.address_1 }}</span>
        </div>
      {% endif %}

      {% if block.settings.tax_code != blank %}
        <div class="ai-footer-company-detail-{{ai_gen_id}}">
          {% if block.settings.icon_tax %}
            <span class="ai-footer-contact-icon-{{ai_gen_id}}">
              <img
                src="{{ block.settings.icon_tax | image_url: width: 32 }}"
                alt="Tax"
                loading="lazy"
                width="40"
                height="40"
              >
            </span>
          {% endif %}
          <span>{{ block.settings.tax_code }}</span>
        </div>
      {% endif %}
    </div>
  </details>
{% endif %}

