<script>
  (function() {
    class FooterBlock{{ai_gen_id}} extends HTMLElement {
      connectedCallback() {
        const groups = [
          this.querySelector('.ai-footer-contact-{{ai_gen_id}}'),
          this.querySelector('.ai-footer-mobile-contact-{{ai_gen_id}}')
        ];

        groups.forEach((group) => {
          if (!group) return;

          const dropdowns = group.querySelectorAll('.ai-footer-company-dropdown-{{ai_gen_id}}');

          dropdowns.forEach((dropdown) => {
            dropdown.addEventListener('toggle', () => {
              if (!dropdown.open) return;

              dropdowns.forEach((otherDropdown) => {
                if (otherDropdown !== dropdown) {
                  otherDropdown.removeAttribute('open');
                }
              });
            });
          });
        });
      }
    }

    customElements.define('footer-block-{{ai_gen_id}}', FooterBlock{{ai_gen_id}});
  })();
</script>

