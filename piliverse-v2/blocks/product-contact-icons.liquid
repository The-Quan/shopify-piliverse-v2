{% assign block_settings = block.settings %}

<div
  class="product-contact-icons spacing-style"
  style="
    --product-contact-icons-gap: {{ block_settings.gap }}px;
    --product-contact-icons-size: {{ block_settings.icon_size }}px;
    --product-contact-icons-alignment: {{ block_settings.alignment }};
    {% render 'spacing-style', settings: block_settings %}
  "
  {{ block.shopify_attributes }}
>
  {% if block_settings.text != blank %}
    <p class="product-contact-icons__text">
      {{ block_settings.text }}
    </p>
  {% endif %}

  <div class="product-contact-icons__row">
    {% for index in (1..6) %}
      {% liquid
        assign icon_key = 'icon_' | append: index
        assign link_key = 'link_' | append: index
        assign label_key = 'label_' | append: index

        assign icon_image = block_settings[icon_key]
        assign icon_link = block_settings[link_key]
        assign icon_label = block_settings[label_key]
      %}

      {% if icon_image != blank %}
        <a
          href="{{ icon_link | default: '#' }}"
          class="product-contact-icons__item"
          aria-label="{{ icon_label | default: 'Contact icon' }}"
          {% if icon_link != blank %}
            target="_blank"
            rel="noopener noreferrer"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          {{
            icon_image
            | image_url: width: 160
            | image_tag:
              class: 'product-contact-icons__image',
              loading: 'lazy',
              widths: '48, 80, 120, 160',
              alt: icon_label
          }}
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .product-contact-icons {
    width: 100%;
  }

  .product-contact-icons__text {
    margin: 0 0 12px;
    font-size: 14px;
    line-height: 1.6;
    color: #fff;
    opacity: 0.85;
    text-align: center;
  }

  .product-contact-icons__row {
    display: flex;
    align-items: center;
    justify-content: var(--product-contact-icons-alignment);
    gap: var(--product-contact-icons-gap);
    flex-wrap: wrap;
  }

  .product-contact-icons__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--product-contact-icons-size);
    height: var(--product-contact-icons-size);
    border-radius: 999px;
    overflow: hidden;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .product-contact-icons__item:hover {
    transform: translateY(-3px);
    opacity: 0.9;
  }

  .product-contact-icons__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-contact-icons__item[aria-disabled='true'] {
    cursor: default;
  }
{% endstylesheet %}

