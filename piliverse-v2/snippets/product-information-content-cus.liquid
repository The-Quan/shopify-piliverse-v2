{% doc %}
  Product Information Content

  Renders the product information layout with media gallery and product details.
  Used by both product-information and featured-product-information sections.

  @param {number} product_media_size - Number of media items in the product
  @param {string} section_id - Unique section ID
  @param {object} settings - Section settings object
  @param {string} media_gallery - Captured HTML for the product media gallery block
  @param {string} product_details - Captured HTML for the product details block
  @param {string} additional_blocks - Captured HTML for additional section blocks

  @example
  {% capture media_gallery %}
    {% content_for 'block', type: '_product-media-gallery', id: 'media-gallery', closest.product: product %}
  {% endcapture %}

  {% capture product_details %}
    {% content_for 'block', type: '_product-details', id: 'product-details', closest.product: product %}
  {% endcapture %}

  {% capture additional_blocks %}
    {% content_for 'blocks' %}
  {% endcapture %}

  {% render 'product-information-content',
    product_media_size: product.media.size,
    section_id: section.id,
    settings: section.settings,
    media_gallery: media_gallery,
    product_details: product_details,
    additional_blocks: additional_blocks
  %}
{% enddoc %}

{% liquid
  # Determine render order based on media position
  if settings.desktop_media_position == 'left'
    assign render_order = 'media,product-details'
  else
    assign render_order = 'product-details,media'
  endif

  # Check if product has media
  assign product_has_media = true
  if product_media_size == 0
    assign product_has_media = false
  endif

  # Build product grid class
  assign product_grid_class = 'product-information-cus__grid'

  if product_has_media == false
    assign product_grid_class = product_grid_class | append: ' product-information-cus--media-none'
  elsif settings.desktop_media_position == 'right'
    assign product_grid_class = product_grid_class | append: ' product-information-cus--media-right'
  else
    assign product_grid_class = product_grid_class | append: ' product-information-cus--media-left'
  endif

  if settings.equal_columns
    assign product_grid_class = product_grid_class | append: ' product-information-cus__grid--half'

    if settings.limit_details_width
      assign product_grid_class = product_grid_class | append: ' product-information-cus__grid--limit-details'
    endif
  endif

  # Determine content width
  case settings.content_width
    when 'content-center-aligned'
      assign content_width = 'page-width'
    when 'content-full-width'
      assign content_width = 'full-width'
  endcase
%}

<div class="section-background color-{{ settings.color_scheme }}"></div>
<div
  class="product-information-cus section section--{{ content_width }} spacing-style color-{{ settings.color_scheme }} relative"
  style="{% render 'spacing-style', settings: settings %} --gap: {{ settings.gap }}px;"
  data-testid="product-information"
>
  {% if settings.cus_background_image != blank %}
    <div
      class="product-information-cus__bg"
      style="--cus-bg-opacity: {{ settings.cus_background_image_opacity | divided_by: 100.0 }};"
      aria-hidden="true"
    >
      {{
        settings.cus_background_image
        | image_url: width: 2400
        | image_tag:
          class: 'product-information-cus__bg-image',
          loading: 'lazy',
          widths: '720, 1080, 1440, 1920, 2400',
          sizes: '100vw',
          alt: ''
      }}
    </div>
  {% endif %}

  {% if settings.desktop_media_position == 'left' and product_has_media and request.page_type == 'product' %}
    {% assign product_href = '#ProductInformation-' | append: section_id %}
    {% render 'skip-to-content-link', href: product_href, text: 'accessibility.skip_to_product_info' %}
  {% endif %}
  <div
    class="{{ product_grid_class }}"
    data-product-grid-content
  >
    {% assign render_order_array = render_order | split: ',' %}
    {% capture media %}
      <div
        class="product-information-cus__media"
        data-testid="product-information-media"
      >
        {{ media_gallery }}
      </div>
    {% endcapture %}

    {% for block in render_order_array %}
      {% if block == 'media' and product_has_media %}
        {{ media }}
      {% elsif block == 'product-details' %}
        {{ product_details }}
      {% endif %}
    {% endfor %}
  </div>

  {{ additional_blocks }}
</div>

{% stylesheet %}
  .product-information-cus {
    gap: var(--gap) 0;
    isolation: isolate;
  }

  .product-information-cus__bg {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .product-information-cus__bg-image {
    width: 520px;
    height: 520px;
    max-width: none;
    max-height: none;
    flex: 0 0 auto;
    opacity: var(--cus-bg-opacity, 0.35);
    object-fit: contain;
    transform: none;
  }

  @media (max-width: 749px) {
    .product-information-cus__bg-image {
      width: 300px;
      height: 300px;
    }
  }

  .product-information-cus > :not(.product-information-cus__bg) {
    position: relative;
    z-index: 1;
  }

  /* Base grid layout */
  .product-information-cus__grid {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }

  /* Default column positions */
  .product-details {
    order: 1;
  }

  .product-information-cus__media {
    order: 0;
    width: 0;
    min-width: 100%;
  }

  .product-information-cus__media .placeholder-image {
    width: 100%;
    height: 100%;
  }

  /* Mobile styles */
  @media screen and (max-width: 749px) {
    .product-information-cus__media {
      grid-column: 1 / -1;
    }

    .product-details {
      grid-column: 2 / 3;
    }
  }

  /* Desktop styles */
  @media screen and (min-width: 750px) {
    .product-information-cus__grid {
      grid-column: 2;
    }

    /* Position when there is no media */
    .product-information-cus__grid.product-information-cus--media-none {
      .product-details {
        width: var(--narrow-content-width);
        margin: 0 auto;
      }
    }

    /* Position when there is media */
    .product-information-cus__grid:not(.product-information-cus--media-none) {
      /* Media on the left side */
      &.product-information-cus--media-left {
        grid-template-columns: 1fr min(50vw, var(--sidebar-width));

        .product-information-cus__media {
          padding-right: calc(var(--gap, 0) / 2);
        }

        .product-details {
          padding-left: calc(var(--gap, 0) / 2);
        }

        &:has(.media-gallery--extend) {
          grid-column: 1 / 3;
        }
      }

      /* Media on the right side */
      &.product-information-cus--media-right {
        grid-template-columns: min(50vw, var(--sidebar-width)) 1fr;

        .product-information-cus__media {
          padding-left: calc(var(--gap, 0) / 2);
          order: 1;
        }

        .product-details {
          padding-right: calc(var(--gap, 0) / 2);
          order: 0;
        }

        &:has(.media-gallery--extend) {
          grid-column: 2 / -1;
        }
      }

      /* Equal width columns */
      &.product-information-cus__grid--half,
      &.product-information-cus__grid--half:has(.media-gallery--extend) {
        grid-column: 1 / -1;
        grid-template-columns:
          var(--full-page-grid-margin) calc(var(--full-page-grid-central-column-width) / 2) calc(
            var(--full-page-grid-central-column-width) / 2
          )
          var(--full-page-grid-margin);

        &.product-information-cus--media-left {
          .product-information-cus__media {
            grid-column: 2 / 3;

            &:has(.media-gallery--extend) {
              grid-column: 1 / 3;
            }
          }

          .product-details {
            grid-column: 3 / 4;
          }
        }

        &.product-information-cus--media-right {
          .product-information-cus__media {
            grid-column: 3 / 4;

            &:has(.media-gallery--extend) {
              grid-column: 3 / -1;
            }
          }

          .product-details {
            grid-column: 2 / 3;
          }
        }
      }
    }

    /* Handle full width section */
    .section--full-width {
      .product-information-cus__grid:not(.product-information-cus--media-none) {
        &.product-information-cus--media-left,
        &.product-information-cus--media-right {
          grid-column: 1 / -1;
        }

        &.product-information-cus--media-left .product-details {
          padding-inline-end: var(--padding-lg);
        }

        &.product-information-cus--media-right .product-details {
          padding-inline-start: var(--padding-lg);
        }

        &.product-information-cus__grid--half.product-information-cus--media-left {
          .product-information-cus__media {
            grid-column: 1 / 3;
          }

          .product-details {
            grid-column: 3 / -1;
          }
        }

        &.product-information-cus__grid--half.product-information-cus--media-right {
          .product-information-cus__media {
            grid-column: 3 / -1;
          }

          .product-details {
            grid-column: 1 / 3;
          }
        }
      }
    }
  }

  /* Wider sidebar for large screens */
  @media screen and (min-width: 1200px) {
    .product-information-cus__grid:not(
        .product-information-cus__grid--half,
        .product-information-cus--media-none
      ).product-information-cus--media-left {
      grid-template-columns: 2fr 1fr;
    }

    .product-information-cus__grid:not(
        .product-information-cus__grid--half,
        .product-information-cus--media-none
      ).product-information-cus--media-right {
      grid-template-columns: 1fr 2fr;
    }
  }

  .product-information-cus__grid--limit-details .product-details > .group-block {
    max-width: var(--sidebar-width);
  }

  /* If the header is sticky, make product details content stick underneath the header */
  body:has(#header-group #header-component[data-sticky-state='active']) .product-details.sticky-content--desktop {
    --sticky-header-offset: var(--header-height);
  }

  .product-information-cus.section {
    max-width: 1500px;
    border: 1px solid rgba(125, 84, 198, 0.2);
    border-radius: 28px;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 40%, #010314 83%);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12) inset, 0 30px 80px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    margin-inline: auto;
    padding: 28px;
    overflow: hidden;
  }

  .product-information-cus.section .product-information-cus__media {
    display: flex;
    justify-content: center;
  }

  .product-information-cus.section .product-media-container {
    max-width: 520px;
    max-height: 520px;
    width: 100%;
    margin: 0 auto;
    padding: 0;
    overflow: hidden;
  }

  /* Override shared media background so CUS section stays transparent. */
  #shopify-section-{{ section_id }} .product-information-cus .product-media-container.constrain-height {
    background-color: transparent !important;
  }

  #shopify-section-{{ section_id }} .product-information-cus .media-fit-contain :is(img, .deferred-media__poster-image) {
    background-color: transparent !important;
  }

  /* CUS-only: force product title + price to white on dark background */
  #shopify-section-{{ section_id }} .product-information-cus .product-details {
    --color-foreground-heading: #fff;
    --font-h1-color: #fff;
    --font-h2-color: #fff;
    --font-h3-color: #fff;
    --font-h4-color: #fff;
    --font-h5-color: #fff;
    --font-h6-color: #fff;
  }

  #shopify-section-{{ section_id }} .product-information-cus .product-details .text-block:is(.h1, .h2, .h3, .h4, .h5, .h6),
  #shopify-section-{{ section_id }} .product-information-cus .product-details .text-block:is(.h1, .h2, .h3, .h4, .h5, .h6) > *,
  #shopify-section-{{ section_id }} .product-information-cus .product-details .text-block:is(.h1, .h2, .h3, .h4, .h5, .h6) a,
  #shopify-section-{{ section_id }} .product-information-cus .product-details product-price,
  #shopify-section-{{ section_id }} .product-information-cus .product-details product-price * {
    color: #fff !important;
  }

  #shopify-section-{{ section_id }} .product-information-cus .product-details more-payment-options-link a,
  #shopify-section-{{ section_id }} .product-information-cus .product-details .shopify-payment-button__more-options {
    color: #fff !important;
    text-decoration-color: #fff !important;
  }

  .product-information-cus.section .product-media {
    width: 100%;
    height: 100%;
  }

  .product-information-cus.section .product-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-information-cus.section {
    margin-top: 120px;
  }

  @media (max-width: 749px) {
    .product-information-cus.section {
      margin-top: 70px;
    }
  }
  @media (max-width: 749px) {
    .product-information-cus.section {
      max-width: 95vw;
      padding: 16px;
      border-radius: 20px;
    }
  }
{% endstylesheet %}

{% style %}
  #shopify-section-{{ section_id }} {
    background: #020313;
    padding-block: 32px;
  }

  #shopify-section-{{ section_id }} .section-background {
    background: transparent;
  }

  #shopify-section-{{ section_id }} .product-information-cus.section {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 40%, #010314 83%);
    border-radius: 28px;
    border: 1px solid rgba(125, 84, 198, 0.2);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12) inset, 0 30px 80px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    margin-inline: auto;
  }
{% endstyle %}
