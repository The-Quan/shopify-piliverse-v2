<div class="contact-fab" data-open="false">
  <button class="contact-fab__main" aria-label="Contact">
    {% if settings.floating_icon_main %}
      <img
        src="{{ settings.floating_icon_main | image_url: width: 80 }}"
        alt="Chat"
        width="26"
        height="26"
      >
    {% else %}
      💬
    {% endif %}
  </button>

  <div class="contact-fab__list">
    {% for i in (1..4) %}
      {% assign icon_key = "floating_icon_" | append: i %}
      {% assign link_key = "floating_link_" | append: i %}

      {% assign icon = settings[icon_key] %}
      {% assign link = settings[link_key] %}

      {% if icon != blank and link != blank %}
        <a class="contact-fab__item" href="{{ link }}" target="_blank">
          <img
            src="{{ icon | image_url: width: 80 }}"
            alt=""
            width="22"
            height="22"
            loading="lazy"
          >
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>
{% style %}
.contact-fab {
  position: fixed;
  right: 25px;
  bottom: 24px;
  z-index: 9999;
}

/* NÚT CHÍNH */
.contact-fab__main {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: transparent; /* ❌ bỏ background */
  border: none;
  cursor: pointer;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-fab__main img {
  width: 55px;
  height: 55px;
}

/* LIST ICON */
.contact-fab__list {
  position: absolute;
  right: 6px;
  bottom: 80px;

  display: flex;
  flex-direction: column;
  gap: 16px;

  opacity: 0;
  transform: translateY(32px); /* 👈 trượt rõ hơn */
  pointer-events: none;

  transition: opacity 0.3s ease, transform 0.3s ease;
}

.contact-fab[data-open="true"] .contact-fab__list {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.contact-fab__item {
  width: 55px;
  height: 55px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;

  background: transparent;
}

.contact-fab__item img {
  position: absolute;
  width: 44px;
  height: 44px;
  object-fit: contain; 
  display: block;
  transition: transform 0.2s ease;
}

.contact-fab__item:hover img {
  transform: scale(1.15);
}

/* MOBILE */
@media (max-width: 768px) {
  .contact-fab {
    right: 16px;
    bottom: 16px;
  }

  .contact-fab__main {
    width: 56px;
    height: 56px;
  }

  .contact-fab__main img {
    width: 30px;
    height: 30px;
  }

  .contact-fab__item img {
    width: 28px;
    height: 28px;
  }

  .contact-fab__list {
  position: absolute;
  right: 6px;
  bottom: 60px;

  display: flex;
  flex-direction: column;
  gap: 0;
}
}
{% endstyle %}

{% javascript %}
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".contact-fab").forEach(function (fab) {
    var mainBtn = fab.querySelector(".contact-fab__main");

    if (!mainBtn) return;

    function closeProductSubscribeChat() {
      var chat = document.getElementById("product-subscribe-chat");

      if (!chat) return;

      chat.classList.remove("is-active");
      chat.setAttribute("aria-hidden", "true");
    }

    function openProductSubscribeChat() {
  var chat = document.getElementById("product-subscribe-chat");

  if (!chat) return;

  chat.classList.add("is-active");
  chat.setAttribute("aria-hidden", "false");
}

    mainBtn.addEventListener("click", function (e) {
  e.stopPropagation();

  fab.dataset.open = fab.dataset.open === "true" ? "false" : "true";

  if (fab.dataset.open === "true") {
    document.body.classList.add("contact-fab-open");
    openProductSubscribeChat();
  } else {
    document.body.classList.remove("contact-fab-open");
    closeProductSubscribeChat();
  }
});

    document.addEventListener("click", function () {
  fab.dataset.open = "false";
  document.body.classList.remove("contact-fab-open");
  closeProductSubscribeChat();
});
  });
});
{% endjavascript %}