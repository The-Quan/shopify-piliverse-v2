<section class="image-rows-section">
  <div class="image-rows-heading">
    {% if section.settings.image-rows-title != blank %}
      <h2 class="image-rows-title fade-up">
        {{ section.settings.image-rows-title }}
      </h2>
    {% endif %}

    {% if section.settings.image-rows-description != blank %}
      <p class="image-rows-description fade-up">
        {{ section.settings.image-rows-description }}
      </p>
    {% endif %}
  </div>

  <div class="image-rows-container">
    <div class="left">
      {% if section.settings.main_image %}
        <img
          src="{{ section.settings.main_image | image_url: width: 900 }}"
          width="{{ section.settings.main_image.width }}"
          height="{{ section.settings.main_image.height }}"
          alt="{{ section.settings.main_image.alt | escape }}"
          loading="lazy">
      {% endif %}
    </div>

    <div class="right">
      {% for block in section.blocks %}
        <div class="row" {{ block.shopify_attributes }}>
          <div class="row-title">

            {% if block.settings.icon %}
              <img
                src="{{ block.settings.icon | image_url: width: 40 }}"
                alt="{{ block.settings.title }}"
                width="20"
                height="20"
                loading="lazy">
            {% endif %}

            <span>{{ block.settings.title }}</span>
          </div>

          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

<style>
  .image-rows-section {
    width: 100%;
    height: auto;
    background: #020414;
    padding: 100px 0;
    display: flex;
    flex-direction: column;
    gap: 50px;
  }
  .image-rows-section .image-rows-heading {
    max-width: 1200px;
    margin: auto;
    padding: 0 10px;
    text-align: center;
  }
  .image-rows-heading .image-rows-title{
    font-size: 32px;
  }
  .image-rows-heading .image-rows-title,
  .image-rows-description {
    color: white;
  }
  .image-rows-section .image-rows-container {
    display: flex;
    gap: 30px;
    max-width: 1200px;
    padding: 0 10px;
    margin: auto;
  }

  .image-rows-section .left {
    flex: 1;
  }

  .image-rows-section .left img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
  }

  .image-rows-section .right {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .image-rows-section .row {
    flex: 1;
    background: #f5f5f5;
    padding: 20px;
    border-radius: 10px;
  }

  .image-rows-section .row span {
    color: black;
    font-size: 20px;
    font-weight: bold;
  }
  .image-rows-section .row p {
    color: black;
  }

  .image-rows-section .row-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 5px;
  }

  .image-rows-section .row-title img {
    width: 37px;
    height: 37px;
    object-fit: contain;
  }

  .fade-up {
    opacity: 0;
    transform: translateY(60px);
    transition: all 1.6s ease;
  }

  .fade-up.show {
    opacity: 1;
    transform: translateY(0);
  }

  @media(max-width: 768px) {
    .image-rows-section .image-rows-container {
      margin: 0 10px;
      flex-direction: column;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
  
  const elements = document.querySelectorAll(
    ".fade-up, .image-rows-section .left, .image-rows-section .row"
  );
  
  document.querySelector(".image-rows-section .left")?.classList.add("fade-up");
  
  document.querySelectorAll(".image-rows-section .row").forEach((el, i) => {
    el.classList.add("fade-up");
    el.style.transitionDelay = `${i * 0.15}s`; 
  });
  
  function revealOnScroll() {
    const windowHeight = window.innerHeight;
  
    elements.forEach(el => {
      const top = el.getBoundingClientRect().top;
  
      if (top < windowHeight - 100) {
        el.classList.add("show");
      }
    });
  }
  
  window.addEventListener("scroll", revealOnScroll);
  revealOnScroll();
  });
</script>

{% schema %}
  {
    "name": "Image Left 4 Rows Right",
    "settings": [
      {
        "type": "image_picker",
        "id": "main_image",
        "label": "Main Image"
      }, {
        "type": "text",
        "id": "image-rows-title",
        "label": "Tiêu đề"
      }, {
        "type": "textarea",
        "id": "image-rows-description",
        "label": "Mô tả"
      }
    ],
    "blocks": [
      {
        "type": "row",
        "name": "Row",
        "settings": [
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          }, {
            "type": "text",
            "id": "title",
            "label": "Title"
          }, {
            "type": "textarea",
            "id": "text",
            "label": "Text"
          }
        ]
      }
    ],
    "max_blocks": 4,
    "presets": [
      {
        "name": "Image + 4 Rows"
      }
    ]
  }
{% endschema %}