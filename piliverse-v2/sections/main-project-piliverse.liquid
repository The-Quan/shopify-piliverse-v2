<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<blog-posts-list section-id="{{ section.id }}" class="project-pili-posts-list--default">
  <div class="project-pili-posts project-pili-posts--dark">
    {%- paginate blog.articles by 13 -%}

    <div class="header-project-pili">
      <div>
        <h3>{{ 'content.header-project-pili' | t | default: 'DỰ ÁN NỔI BẬT ĐÃ THỰC HIỆN' }}</h3>
      </div>
      <span>{{ 'content.discription-project-pili' | t | default: 'Một số dự án tiêu biểu mà tôi đã triển khai' }}</span>
    </div>


    <div class="project-pili-posts-container project-pili-posts-container--grid">
        {% for article in blog.articles %}

          <div class="project-pili-card">
            {% if article.image %}
              <span class="project-pili-card__image-link">
                {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy' }}
              </span>
            {% endif %}

            <div class="project-pili-card__body">

              <span class="project-pili-card__title" >
                {{ article.title }}
              </span>

              <div style="width: 100%; margin: 5px 0; text-align: center; border-bottom: 1px solid rgba(255, 255, 255, .12) "></div>


              <ul>
                <li>
                  <span class="project-pili-card__customer_project" >
                    {{'content.customer-project-pili' | t | default: 'Khách hàng'}}: {{ article.metafields.custom.customer_project }}
                  </span>
                </li>
                <li>
                   <span class="project-pili-card__date">
                    {{'content.start-project-pili' | t | default: 'Ngày bắt đầu'}}: {{ article.published_at | time_tag: format: 'date' }}
                  </span>
                </li>
                <li>
                  {% if article.tags.size >= 0 %}
                    <span class="project-pili-card__platform">
                    {{'content.platform-project-pili' | t | default: 'Ngày kết thúc'}}: {{ article.tags | join: ', ' }}
                    </span>
                  {% endif %}
                </li>
                <li>
                    <span class="project-pili-card__spending">
                    {{'content.spending-project-pili' | t | default: 'Chi tiêu'}}: {{ article.metafields.custom.spending_project | join: ', ' }}
                    </span>
                </li>
              </ul>


              <p class="project-pili-card__excerpt">
                {{ article.excerpt_or_content | strip_html | truncate: 280 }}
              </p>

            </div>
          </div>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="project-pili-pagination">
          {% if paginate.previous %}
            <a class="project-pili-page-btn prev" href="{{ paginate.previous.url }}">← Prev</a>
          {% endif %}

          {% for part in paginate.parts %}
            {% if part.is_link %}
              <span class="project-pili-page-btn" href="{{ part.url }}">{{ part.title }}</span>
            {% else %}
              <span class="project-pili-page-btn active">{{ part.title }}</span>
            {% endif %}
          {% endfor %}

          {% if paginate.next %}
            <a class="project-pili-page-btn next" href="{{ paginate.next.url }}">Next →</a>
          {% endif %}
        </nav>
      {% endif %}
    {%- endpaginate -%}
  </div>
</blog-posts-list>

{% stylesheet %}

  .project-pili-pagination {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 64px;
  }

  .project-pili-page-btn {
    padding: 10px 16px;
    border-radius: 999px;
    font-size: 14px;
    color: white;
    border: 1px solid rgba(255,255,255,0.15);
    text-decoration: none;
  }

  .project-pili-page-btn.active {
    background: white;
    color: #010314;
  }

  .project-pili-page-btn:hover {
    background: transparent;
  }


  .header-project-pili{
    display: flex;
    margin: 2% 0 auto;
    gap: 10px;
    color: #fff;
    text-align: center;
    align-content: space-around;
    flex-wrap: nowrap;
    flex-direction: column;
  }


  
  .project-pili-posts-list--default {
    background: #010314;
  }

  .project-pili-posts {
    background: #010314;
    padding: 96px 16px 120px;
    display: flex;
    flex-direction: column;
    gap: 96px;
  }


  .project-pili-posts-container--grid {
    max-width: 1280px;
    margin: 0 auto;
    border-radius: 30px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .project-pili-card {
    background: #151b2e;
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease
    , box-shadow 0.25s ease;
  }


  .project-pili-card__image-link img {
    width: 100%;
    height: 220px;
    object-fit: cover;
  }

  .project-pili-card__body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-grow: 1;
  }

  .project-pili-card__body ul {
    color: white;
    padding: 0;
    margin: 0 5%;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }


  /* .project-pili-card__date {
    font-size: 12px;
    color: #5c7cfa;
  } */

  

  .project-pili-card__title {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
    color: #e6eded;
    text-decoration: none;
  }

  .project-pili-card__customer_project, .project-pili-card__platform, .project-pili-card__date, .project-pili-card__spending{
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    color: #e6eded;
    text-decoration: none;
  }

  .project-pili-card__excerpt {
    font-size: 14px;
    line-height: 1.6;
    color: #a7acc2;
    flex-grow: 1;
  }

  .project-pili-card__cta {
    margin-top: 12px;
    width: fit-content;
    padding: 8px 16px;
    font-size: 13px;
    color: white;
    background: transparent;
    text-decoration: none;
    border: thin solid rgba(255, 255, 255, 0.15);
    border-radius: 50px;
  }

  .project-pili-card__cta:hover {
    background: #e6e8f2;
  }

  /* ================= RESPONSIVE ================= */

  @media (max-width: 1024px) {
    .project-pili-posts-container--grid {
      width: 100%;
      margin-left: auto;
      margin-right: auto;
      padding: 0;
    }

    .project-pili-posts-container--grid {
      grid-template-columns: repeat(2, 1fr);
      padding: 32px;
    }
  }

  @media (max-width: 768px) {
    .project-pili-posts-container--grid {
      width: 100%;
      margin-left: auto;
      margin-right: auto;
      padding: 0;
    }
    .project-pili-posts {
      padding: 64px 16px 96px;
      gap: 64px;
    }

    .project-pili-posts-container--grid {
      grid-template-columns: 1fr;
      border-radius: 24px;
    }

    .project-pili-card__body {
      padding: 16px;
    }
    
    .header-project-pili h3{
      font-size: 25px;
     }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Project PiLi Grid",
  "disabled_on": {
    "groups": ["header"]
  },
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Title text"
        }
      ]
    }
  ],
  "settings": []
}
{% endschema %}
