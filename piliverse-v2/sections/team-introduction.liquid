{% style %}
  .team-introduction {
    padding: 180px 0;
    position: relative;
    background: #020313;
    text-align: center;
    overflow: hidden;
  }

  /* ===== CONTAINER ===== */
  .team-introduction__container {
    max-width: 1088px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
    padding: 0 16px;
  }

  /* ===== ELLIPSE TOP ===== */
  .team-introduction__ellipse-top {
    position: absolute;
    top: -40px;
    left: 50%;
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 0;
  }

  /* ===== BACKGROUND ===== */
  .team-introduction__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .team-introduction__bg-glow {
    position: absolute;
    left: 50%;
    top: 530px;
    transform: translateX(-50%);
    width: 680px;
    height: 680px;
    filter: blur(100px);
  }

  .team-introduction__bg-image {
    position: absolute;
    left: 50%;
    top: 450px;
    transform: translateX(-50%);
  }

  .team-introduction__bg-image img {
    width: 560px;
    max-width: 100%;
    opacity: 0.9;
  }

  /* ===== ELLIPSE BOTTOM ===== */
  .team-introduction__ellipse {
    position: absolute;
    left: 50%;
    bottom: 140px;
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 0;
  }

  .team-introduction__ellipse img {
    width: 361px;
    max-width: 100%;
    opacity: 0.9;
  }

  /* ===== TITLE ===== */
  .team-introduction__title {
    font-size: 48px;
    font-weight: 500;
    margin-top: 140px;
    margin-bottom: 20px;
    background: radial-gradient(50% 100%, #ffffff 30%, rgba(255, 255, 255, 0.5) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.2;
    opacity: 0;
    transform: translateY(80px);
    transition: opacity 1.4s cubic-bezier(0.22, 1, 0.36, 1), transform 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .team-introduction__title.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .team-introduction__title.is-visible-no-anim {
    opacity: 1;
    transform: translateY(0);
    transition: none;
  }

  .team-introduction__title.is-hidden-no-anim {
    opacity: 0;
    transform: translateY(40px);
    transition: none;
  }

  .team-introduction__desc {
    max-width: 640px;
    margin: 0 auto 96px;
    font-size: 14px;
    line-height: 22px;
    color: #dfe1f4;

    opacity: 0;
    transform: translateY(62px);
    transition: opacity 1.3s cubic-bezier(0.22, 1, 0.36, 1), transform 1.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .team-introduction__desc.is-visible {
    opacity: 0.85;
    transform: translateY(0);
  }

  .team-introduction__desc.is-visible-no-anim {
    opacity: 0.85;
    transform: translateY(0);
    transition: none;
  }

  .team-introduction__desc.is-hidden-no-anim {
    opacity: 0;
    transform: translateY(32px);
    transition: none;
  }

  .team-grid {
    display: flex;
    justify-content: center;
    gap: 32px;
    margin-top: 80px;
    position: relative;
    z-index: 3;
  }

  /* ===== CARD ===== */
  .team-card {
    width: 325px;
    height: 420px;
    border-radius: 28px;
    position: relative;
    overflow: hidden;

    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 40%, #010314 83%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(125, 84, 198, 0.2);

    opacity: 0;
    transform: translateY(24px) scale(0.96);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08) inset;

    transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1), transform 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .team-card.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12) inset, 0 30px 80px rgba(0, 0, 0, 0.6);
  }

  .team-card:hover {
    transform: scale(1.05);
  }

  .team-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .team-info {
    position: absolute;
    bottom: 28px;
    left: 0;
    right: 0;
    text-align: center;
  }

  .team-name {
    font-size: 20px;
    font-weight: 600;
    color: #fff;
    margin-bottom: 6px;
  }

  .team-role {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.75);
  }

  /* ===== MOBILE SLIDER ===== */
  @media (max-width: 768px) {
    .team-introduction {
      padding: 96px 0 120px;
    }

    .team-introduction__title {
      font-size: 32px;
      margin-top: 80px;
    }

    .team-grid {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      justify-content: flex-start;
      gap: 20px;
      padding: 0 16px 40px;
    }

    .team-grid::-webkit-scrollbar {
      display: none;
    }

    .team-card {
      flex: 0 0 80%;
      max-width: 80%;
      scroll-snap-align: center;
    }
  }
{% endstyle %}

<section class="team-introduction js-team-introduction">
  {% if section.settings.ellipse_top_image %}
    <img
      src="{{ section.settings.ellipse_top_image | image_url: width: 2000 }}"
      width="361"
      height="191"
      class="team-introduction__ellipse-top"
      loading="lazy"
    >
  {% endif %}

  {% if section.settings.background_image %}
    <div class="team-introduction__bg">
      <div class="team-introduction__bg-glow"></div>
      <div class="team-introduction__bg-image">
        {{ section.settings.background_image | image_url: width: 2000 | image_tag }}
      </div>
    </div>
  {% endif %}

  <div class="team-introduction__container">
    <h2 class="team-introduction__title">{{ section.settings.title }}</h2>

    {% if section.settings.description != blank %}
      <p class="team-introduction__desc">{{ section.settings.description }}</p>
    {% endif %}

    <div class="team-grid">
      {% for block in section.blocks %}
        <div class="team-card" {{ block.shopify_attributes }}>
          {% if block.settings.avatar %}
            {{ block.settings.avatar | image_url: width: 800 | image_tag: class: 'team-avatar' }}
          {% endif %}
          <div class="team-info">
            <div class="team-name">{{ block.settings.name }}</div>
            <div class="team-role">{{ block.settings.role }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  {% if section.settings.ellipse_image %}
    <div class="team-introduction__ellipse">
      {{ section.settings.ellipse_image | image_url: width: 800 | image_tag }}
    </div>
  {% endif %}
</section>

<script>
  (function () {
    let lastY = window.scrollY;
    let scrollDown = true;

    window.addEventListener(
      'scroll',
      () => {
        const currentY = window.scrollY;
        scrollDown = currentY > lastY;
        lastY = currentY;
      },
      { passive: true }
    );

    document.querySelectorAll('.js-team-introduction').forEach((section) => {
      const title = section.querySelector('.team-introduction__title');
      const desc = section.querySelector('.team-introduction__desc');
      const cards = section.querySelectorAll('.team-card');
      const isMobile = window.matchMedia('(max-width: 768px)').matches;

      if (!title) return;

      const SHOW_THRESHOLD = 0.35;
      const HIDE_THRESHOLD = 0.08;

      const headerObserver = new IntersectionObserver(
        ([entry]) => {
          const ratio = entry.intersectionRatio;

          if (ratio >= SHOW_THRESHOLD) {
            if (scrollDown) {
              title.classList.add('is-visible');
              title.classList.remove('is-visible-no-anim');
              title.classList.remove('is-hidden-no-anim');

              if (desc) {
                desc.classList.add('is-visible');
                desc.classList.remove('is-visible-no-anim');
                desc.classList.remove('is-hidden-no-anim');
              }
            } else {
              title.classList.add('is-visible-no-anim');
              title.classList.remove('is-visible');
              title.classList.remove('is-hidden-no-anim');

              if (desc) {
                desc.classList.add('is-visible-no-anim');
                desc.classList.remove('is-visible');
                desc.classList.remove('is-hidden-no-anim');
              }
            }

            return;
          }

          if (ratio <= HIDE_THRESHOLD) {
            title.classList.remove('is-visible', 'is-visible-no-anim');
            title.classList.add('is-hidden-no-anim');
            if (desc) {
              desc.classList.remove('is-visible', 'is-visible-no-anim');
              desc.classList.add('is-hidden-no-anim');
            }

            requestAnimationFrame(() => {
              title.classList.remove('is-hidden-no-anim');
              if (desc) desc.classList.remove('is-hidden-no-anim');
            });
          }
        },
        { threshold: [0, HIDE_THRESHOLD, SHOW_THRESHOLD, 1] }
      );

      headerObserver.observe(title);

      if (!isMobile) {
        const gridObserver = new IntersectionObserver(
          ([entry]) => {
            if (entry.isIntersecting) {
              cards.forEach((card, i) => {
                setTimeout(() => card.classList.add('is-visible'), i * 220);
              });
            } else {
              cards.forEach((card) => card.classList.remove('is-visible'));
            }
          },
          { threshold: 0.25 }
        );

        gridObserver.observe(section.querySelector('.team-grid'));
      }

      if (isMobile) {
        const cardObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              entry.target.classList.toggle('is-visible', entry.isIntersecting);
            });
          },
          { threshold: 0.6 }
        );

        cards.forEach((card) => cardObserver.observe(card));
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Team Introduction",
  "settings": [
    { "type": "image_picker", "id": "ellipse_top_image", "label": "Top ellipse image" },
    { "type": "image_picker", "id": "ellipse_image", "label": "Ellipse behind cards" },
    { "type": "text", "id": "title", "label": "Title", "default": "Team Introduction" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "image_picker", "id": "background_image", "label": "Background planet image" }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Member",
      "settings": [
        { "type": "image_picker", "id": "avatar", "label": "Avatar" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team Introduction",
      "blocks": [{ "type": "member" }, { "type": "member" }, { "type": "member" }]
    }
  ]
}
{% endschema %}
