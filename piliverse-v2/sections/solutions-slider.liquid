<section class="solutions-section">

  {% if section.settings.bg_image != blank %}
    <div class="solutions-bg">
      <img
        src="{{ section.settings.bg_image | image_url: width: 2000 }}"
        alt=""
        width="{{ section.settings.bg_image.width }}"
        height="{{ section.settings.bg_image.height }}"
        loading="lazy">
    </div>
  {% endif %}

  <div class="solutions-content">

    {% if section.settings.title != blank %}
      <h2 class="solutions-title">{{ section.settings.title }}</h2>
    {% endif %}

    {% if section.settings.subtitle != blank %}
      <p class="solutions-subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}

    <div class="solutions-slider">
      {% for block in section.blocks %}
        <div class="solution-card" {{ block.shopify_attributes }}>

          {% if block.settings.card_image != blank %}
            <div class="solution-image">
              <img
                src="{{ block.settings.card_image | image_url: width: 800 }}"
                alt=""
                width="{{ block.settings.card_image.width }}"
                height="{{ block.settings.card_image.height }}"
                loading="lazy">
            </div>
          {% endif %}

          <!-- TEXT WRAPPER (KHÔNG ĐÈ BORDER) -->
          <div class="solution-text">
            <div class="solution-text-inner">

              <h3 class="solution-card-title">
                {{ block.settings.card_title }}
              </h3>

              <p class="solution-desc">
                {{ block.settings.card_desc }}
              </p>

              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="solution-btn">
                  {{ block.settings.link_text }}
                </a>
              {% endif %}

            </div>
          </div>

        </div>
      {% endfor %}
    </div>
    <div class="solutions-dots"></div>

  </div>
</section>

<style>


  /*

   =============================== 
   SECTION BASE 
   ================================ 
*/
  .solutions-section {
    position: relative;
    overflow: hidden;
    background: #020414;
    padding-bottom: 120px;
    text-align: center;
    height: 100vh;
  }


  /*

   =============================== 
   TOP IMAGE 
   ================================ 
*/
  .solutions-bg img {
    width: 100%;
    height: auto;
    display: block;
  }


  /*

   =============================== 
   CONTENT OVERLAY 
   ================================ 
*/
  .solutions-content {
    position: absolute;
    top: 10%;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 1400px;
    padding: 0 20px;
    z-index: 2;
    margin-bottom: 10px;
  }


  /*

   =============================== 
   TITLE 
   ================================ 
*/
  .solutions-title,
  .solutions-subtitle {
    margin: 0;
    font-size: 48px;
    font-weight: 500;
    background: linear-gradient(90deg, #9398a2 0%, #ffffff 50%, #9398a2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .solutions-subtitle {
    margin-top: 6px;
    margin-bottom: 56px;
  }


  /*

   =============================== 
   GRID 
   ================================ 
*/
  .solutions-slider {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: center;
    gap: 20px;
  }


  /*

   =============================== 
   CARD 
   ================================ 
*/
  .solution-card {
    position: relative;
    max-width: 360px;
    min-height: 480px;
    border-radius: 18px;
    overflow: hidden;
    background: #020414;
    box-shadow: rgba(255, 255, 255, 0.12) 0 0 0 1px inset;
  }


  /*

   =============================== 
   IMAGE 
   ================================ 
*/
  .solution-image {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .solution-image img {
    margin-top: 28px;
    width: 80%;
    height: auto;
    display: block;
  }


  /*

   =============================== 
   TEXT OVERLAY (OUTER) 
   ================================ 
*/
  .solution-text {
    position: absolute;
    left: 12px;
    /* CHỪA KHOẢNG CÁCH BORDER */
    right: 12px;
    bottom: 12px;

    height: 60%;
    z-index: 2;
  }


  /*

   =============================== 
   TEXT INNER (BACKGROUND) 
   ================================ 
*/
  .solution-text-inner {
    height: 100%;
    padding: 24px;

    background: #010314;
    border-radius: 12px;

    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    text-align: left;
  }


  /*

   =============================== 
   TEXT STYLE 
   ================================ 
*/
  .solution-card-title {
    margin: 0;
    font-size: 24px;
    font-weight: 600;
    color: #ffffff;
  }

  .solution-desc {
    margin: 12px 0 16px;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
  }


  /*

   =============================== 
   BUTTON 
   ================================ 
*/
  .solution-btn {
    align-self: flex-start;
    margin-top: auto;

    padding: 0;
    background: none;
    border: none;

    font-size: 14px;
    font-weight: 500;
    color: rgb(201, 183, 249);

    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.2s ease
    , text-decoration 0.2s ease;
  }
  .solution-btn:hover {
    opacity: 0.85;
    text-decoration: underline;
    background: rgba(255, 255, 255, 0.18);
  }


  /*

   =============================== 
   TOP BLUR OVERLAY 
   ================================ 
*/
  .solution-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 50%;

    background: linear-gradient(rgba(2, 4, 20, 0) 0%, rgba(2, 4, 20, 0.9) 90%);

    filter: blur(10px);
    z-index: 1;
    pointer-events: none;
  }

  .solutions-dots {
    display: none;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
  }

  .solution-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .solution-dot.active {
    background: #b48cff;
    transform: scale(1.2);
  }

  .solutions-bg,
  .solutions-title,
  .solutions-subtitle,
  .solution-card {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 1.5s ease
    , transform 1.5s ease;
  }

  /* Khi active */
  .solutions-section.is-visible .solutions-bg,
  .solutions-section.is-visible .solutions-title,
  .solutions-section.is-visible .solutions-subtitle,
  .solutions-section.is-visible .solution-card {
    opacity: 1;
    transform: translateY(0);
  }

  /* Delay card lần lượt */
  .solutions-section.is-visible .solution-card:nth-child(1) {
    transition-delay: 0.3s;
  }
  .solutions-section.is-visible .solution-card:nth-child(2) {
    transition-delay: 0.6s;
  }
  .solutions-section.is-visible .solution-card:nth-child(3) {
    transition-delay: 0.9s;
  }


  /*

   =============================== 
   SLIDER RESPONSIVE MODE 
   ================================ 
*/
  @media (max-width: 1024px) {
    .solutions-dots {
      display: flex;
    }
    .solutions-slider {
      display: flex;
      justify-content: flex-start;
      gap: 12px;
      overflow: hidden;
      scroll-behavior: smooth;
    }

    .solution-card {
      flex: 0 0 calc(50% - 6px);
      /* 2 card */
      max-width: calc(50% - 6px);
    }
  }

  /* MOBILE – 1 card */
  @media (max-width: 640px) {

    .solutions-section {
      height: 80vh;
    }


    .solution-card-title {
      font-size: 18px;
      line-height: 1.3;
    }

    .solution-desc {
      font-size: 13px;
      line-height: 1.5;
    }
    .solutions-title {
      font-size: 23px;
      line-height: 1.2;
    }

    .solutions-subtitle {
      font-size: 14px;
      line-height: 1.4;
      margin-bottom: 32px;
    }

    .solution-card {
      min-height: 440px;
    }
    .solution-card {
      flex: 0 0 100%;
      max-width: 100%;
      height: auto;
    }
  }

</style>

{% schema %}
  {
    "name": "Solutions Slider",
    "settings": [
      {
        "type": "image_picker",
        "id": "bg_image",
        "label": "Top gradient image"
      }, {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Comprehensive Solutions:"
      }, {
        "type": "text",
        "id": "subtitle",
        "label": "Subtitle",
        "default": "Website Design, Ad Management & Sales Optimization"
      }
    ],
    "blocks": [
      {
        "type": "solution",
        "name": "Solution Card",
        "settings": [
          {
            "type": "image_picker",
            "id": "card_image",
            "label": "Card image"
          },
          {
            "type": "text",
            "id": "card_title",
            "label": "Card title",
            "default": "Custom Website Development"
          },
          {
            "type": "textarea",
            "id": "card_desc",
            "label": "Description",
            "default": "Get a tailored website that fits your brand and business needs."
          },
          {
            "type": "url",
            "id": "link",
            "label": "Learn more link"
          }, {
            "type": "text",
            "id": "link_text",
            "label": "Button text",
            "default": "Learn more"
          }

        ]
      }
    ],
    "max_blocks": 3,
    "presets": [
      {
        "name": "Solutions Slider",
        "blocks": [
          {
            "type": "solution"
          }, {
            "type": "solution"
          }, {
            "type": "solution"
          }
        ]
      }
    ]
  }
{% endschema %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
  const slider = document.querySelector('.solutions-slider');
  if (!slider) return;
  
  let autoTimer;
  let isDragging = false;
  let startX = 0;
  let startScroll = 0;
  
  function getVisibleCount() {
    if (window.innerWidth <= 640) return 1;
    if (window.innerWidth <= 1024) return 2;
    return 0; 
  }
  
  function initSlider() {
    currentIndex = 0;
  buildDots();
  updateDots();
  
    clearInterval(autoTimer);
  
    // reset
    slider.scrollLeft = 0;
    slider.querySelectorAll('.clone').forEach(el => el.remove());
  
    const visibleCount = getVisibleCount();
    if (visibleCount === 0) return;
  
    const cards = Array.from(slider.children);
    const cardWidth = cards[0].offsetWidth + 12;
  
    /* ===== CLONE ===== */
    const headClones = cards.slice(0, visibleCount).map(c => {
      const clone = c.cloneNode(true);
      clone.classList.add('clone');
      return clone;
    });
  
    const tailClones = cards.slice(-visibleCount).map(c => {
      const clone = c.cloneNode(true);
      clone.classList.add('clone');
      return clone;
    });
  
    tailClones.forEach(c => slider.insertBefore(c, slider.firstChild));
    headClones.forEach(c => slider.appendChild(c));
  
    slider.scrollLeft = cardWidth * visibleCount;
  
    /* ===== LOOP FIX ===== */
    slider.onscroll = () => {
      const maxScroll =
        cardWidth * (cards.length + visibleCount);
  
      if (slider.scrollLeft <= cardWidth * (visibleCount - 1)) {
        slider.scrollLeft = cardWidth * cards.length;
      }
  
      if (slider.scrollLeft >= maxScroll) {
        slider.scrollLeft = cardWidth * visibleCount;
      }
    };
  
    /* ===== AUTO SLIDE ===== */
    autoTimer = setInterval(() => {
  slider.scrollBy({
    left: cardWidth,
    behavior: 'smooth'
  });
  
  const index =
  Math.round(
    (slider.scrollLeft / cardWidth) - visibleCount
  );
  
  currentIndex =
  ((index % cards.length) + cards.length) % cards.length;
  
  updateDots();
  
  }, 3500);
  
  }
  const dotsWrap = document.querySelector('.solutions-dots');
  let currentIndex = 0;
  
  function buildDots() {
  if (!dotsWrap) return;
  dotsWrap.innerHTML = '';
  
  const visibleCount = getVisibleCount();
  if (visibleCount === 0) return;
  
  const realCards = slider.querySelectorAll('.solution-card:not(.clone)');
  const slideCount = realCards.length;
  
  for (let i = 0; i < slideCount; i++) {
    const dot = document.createElement('div');
    dot.className = 'solution-dot';
    if (i === currentIndex) dot.classList.add('active');
  
    dot.addEventListener('click', () => {
      currentIndex = i;
      const cardWidth =
        realCards[0].offsetWidth + 12;
  
      slider.scrollTo({
        left: cardWidth * (i + visibleCount),
        behavior: 'smooth'
      });
  
      updateDots();
    });
  
    dotsWrap.appendChild(dot);
  }
  }
  
  function updateDots() {
  if (!dotsWrap) return;
  dotsWrap.querySelectorAll('.solution-dot')
    .forEach((dot, i) => {
      dot.classList.toggle('active', i === currentIndex);
    });
  }
  
  /* ===== DRAG ===== */
  slider.addEventListener('mousedown', e => {
    isDragging = true;
    startX = e.pageX;
    startScroll = slider.scrollLeft;
    clearInterval(autoTimer);
  });
  
  window.addEventListener('mouseup', () => {
    if (!isDragging) return;
    isDragging = false;
    initSlider();
  });
  
  slider.addEventListener('mousemove', e => {
    if (!isDragging) return;
    slider.scrollLeft = startScroll - (e.pageX - startX);
  });
  
  slider.addEventListener('touchstart', e => {
    startX = e.touches[0].pageX;
    startScroll = slider.scrollLeft;
    clearInterval(autoTimer);
  });
  
  slider.addEventListener('touchmove', e => {
    slider.scrollLeft =
      startScroll - (e.touches[0].pageX - startX);
  });
  
  slider.addEventListener('touchend', initSlider);
  
  initSlider();
  window.addEventListener('resize', () => {
  initSlider();
  buildDots();
  });
  
  });
  
   document.addEventListener('DOMContentLoaded', () => {
  const section = document.querySelector('.solutions-section');
  if (!section) return;
  
  let lastScrollY = window.scrollY;
  
  const observer = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        const currentScrollY = window.scrollY;
        const scrollingDown = currentScrollY > lastScrollY;
        const scrollingUp = currentScrollY < lastScrollY;
  
        if (entry.isIntersecting && scrollingDown) {
          section.classList.add('is-visible');
        }
  
        if (!entry.isIntersecting && scrollingUp) {
          section.classList.remove('is-visible');
        }
  
        lastScrollY = currentScrollY;
      });
    },
    {
      threshold: 0.3
    }
  );
  
  observer.observe(section);
  });
</script>