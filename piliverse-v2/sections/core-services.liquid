<script>
  document.addEventListener('DOMContentLoaded', () => {
  const sections = document.querySelectorAll('.core-services');
  if (!sections.length) return;
  
  document.documentElement.classList.add('js-animate');
  
  sections.forEach(section => {
    let lastScrollY = window.scrollY;
  
    section.classList.add('is-prepare');
  
    const observer = new IntersectionObserver(
      ([entry]) => {
        const currentScrollY = window.scrollY;
        const scrollingDown = currentScrollY > lastScrollY;
        lastScrollY = currentScrollY;
  
        if (entry.isIntersecting) {
          if (scrollingDown) {
            section.classList.remove('is-prepare');
            section.classList.add('is-animate');
          } else {
            section.classList.remove('is-prepare', 'is-animate');
          }
        } else {
          section.classList.remove('is-animate');
          section.classList.add('is-prepare');
        }
      },
      { threshold: 0.3 }
    );
  
    observer.observe(section);
  });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
  const section = document.querySelector('.core-services');
  if (!section) return;
  
  const viewport = section.querySelector('.core-slider-viewport');
  const grid = section.querySelector('.core-grid');
  const cards = [...section.querySelectorAll('.core-card')];
  const dotsWrap = section.querySelector('.core-dots');
  
  let slideIndex = 0;
  let perView = getPerView();
  let slideCount = getSlideCount();
  let autoTimer;
  let isDragging = false;
  let startX = 0;
  let currentX = 0;
  
  function getPerView() {
    return window.innerWidth <= 640 ? 1 : 2;
  }
  function getTranslateX(index) {
  return index * slideWidth();
  }
  
  
  function getSlideCount() {
    return Math.ceil(cards.length / perView);
  }
  
  function slideWidth() {
  return cards[0].offsetWidth;
  }
  
  
   function updateSlider(animate = true) {
  if (!isSliderActive()) {
    grid.style.transform = 'none';
    return;
  }
  
  grid.style.transition = animate
    ? 'transform 0.6s cubic-bezier(0.22,1,0.36,1)'
    : 'none';
  
  grid.style.transform =
    `translateX(-${getTranslateX(slideIndex)}px)`;
  
  updateDots();
  }
  
  
  
  /* ---------- DOTS ---------- */
  function buildDots() {
    dotsWrap.innerHTML = '';
    for (let i = 0; i < slideCount; i++) {
      const dot = document.createElement('div');
      dot.className = 'core-dot';
      if (i === slideIndex) dot.classList.add('active');
  
      dot.addEventListener('click', () => {
        slideIndex = i;
        updateSlider();
      });
  
      dotsWrap.appendChild(dot);
    }
  }
  
  function updateDots() {
    dotsWrap.querySelectorAll('.core-dot').forEach((dot, i) => {
      dot.classList.toggle('active', i === slideIndex);
    });
  }
  
  /* ---------- AUTO LOOP ---------- */
  function startAuto() {
    stopAuto();
    autoTimer = setInterval(() => {
      slideIndex = (slideIndex + 1) % slideCount;
      updateSlider();
    }, 2000);
  }
  
  function stopAuto() {
    clearInterval(autoTimer);
  }
  
  /* ---------- DRAG ---------- */
  function onStart(e) {
    stopAuto();
    isDragging = true;
    startX = e.touches ? e.touches[0].clientX : e.clientX;
    currentX = startX;
    grid.style.transition = 'none';
  }
  
  function onMove(e) {
    if (!isDragging) return;
    const x = e.touches ? e.touches[0].clientX : e.clientX;
    const delta = x - startX;
    grid.style.transform =
  `translateX(${-(getTranslateX(slideIndex)) + delta}px)`;
  
    currentX = x;
  }
  
  function onEnd() {
  if (!isDragging) return;
  
  const delta = currentX - startX;
  const threshold = slideWidth() * 0.25;
  
  if (delta < -threshold) {
    slideIndex = Math.min(slideIndex + 1, slideCount - 1);
  } else if (delta > threshold) {
    slideIndex = Math.max(slideIndex - 1, 0);
  }
  
  isDragging = false;
  updateSlider();
  startAuto();
  }
  
  /* ---------- EVENTS ---------- */
  grid.addEventListener('mousedown', onStart);
  grid.addEventListener('mousemove', onMove);
  window.addEventListener('mouseup', onEnd);
  
  grid.addEventListener('touchstart', onStart, { passive: true });
  grid.addEventListener('touchmove', onMove, { passive: true });
  grid.addEventListener('touchend', onEnd);
  
  section.addEventListener('mouseenter', stopAuto);
  section.addEventListener('mouseleave', startAuto);
  
  window.addEventListener('resize', () => {
    perView = getPerView();
    slideCount = getSlideCount();
    slideIndex = 0;
    buildDots();
    updateSlider(false);
  });
  
  /* ---------- INIT ---------- */
  slideCount = getSlideCount();
  buildDots();
  updateSlider(false);
  function isSliderActive() {
  return window.innerWidth <= 1024;
  }
  if (isSliderActive()) {
  startAuto();
  }
  });
</script>