{% comment %} 
                                                          Core Services Section 
{% endcomment %}

<section class="core-services">
  <div class="core-services-inner">

    {% if section.settings.title != blank %}
      <h2 class="core-title" style="
      margin-bottom:
      {% if section.settings.subtitle == blank %}
        {{ section.settings.title_margin_bottom }}px
      {% else %}
        12px
      {% endif %}
    ">
        {{ section.settings.title }}
      </h2>
    {% endif %}


    {% if section.settings.subtitle != blank %}
      <p class="core-subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}

    {% assign icon_blocks = section.blocks | where: 'type', 'icon' %}
    {% if icon_blocks.size > 0 %}
      <div class="core-icons">
        {% for block in icon_blocks %}
          <div class="core-icon" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <img
                src="{{ block.settings.icon | image_url: width: 80 }}"
                alt=""
                width="{{ block.settings.logo.width }}"
                height="{{ block.settings.logo.height }}"
                loading="lazy">
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
    <div class="core-slider-viewport">
      <div class="core-grid">
        {% for block in section.blocks %}
          {% if block.type == 'service' %}
            <div class="core-card" {{ block.shopify_attributes }}>
              <h3 class="core-card-title">
                {{ block.settings.title }}
              </h3>
              <p class="core-card-desc">
                {{ block.settings.desc }}
              </p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="core-dots"></div>


  </div>
</section>

<style>
  .core-services {
    background: #020414;
    padding: 50px 20px;
  }

  .core-services-inner {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  /* Title */
  .core-title {
    font-size: 42px;
    font-weight: 600;
    color: #fff;
    margin-bottom: 12px;
  }

  .core-subtitle {
    max-width: 700px;
    margin: 0 auto 40px;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
  }

  /* Icons */
  .core-icons {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-bottom: 50px;
    flex-wrap: wrap;
  }

  .core-icon {
    width: 60px;
    height: 60px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .core-icon img {
    width: 100%;
    height: 100%;
  }

  .core-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 320px));
    gap: 16px;
    justify-content: center;
  }


  /* Card */
  .core-card {
    padding: 28px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: rgba(0, 0, 0, 0.04) 0 0 0 1px;
    text-align: center;
  }

  .core-card-title {
    font-size: 16px;
    font-weight: 600;
    color: #b48cff;
    margin-bottom: 10px;
  }

  .core-card-desc {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
  }
  .core-dots {
    display: none;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
  }

  .core-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transition: all 0.3s ease;
  }

  .core-dot.active {
    background: #b48cff;
    transform: scale(1.2);
  }

  @media (max-width: 1024px) {
    .core-slider-viewport {
      overflow: hidden;
      width: 100%;
    }

    .core-grid {
      display: flex;
      transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }
    .core-dots {
      display: flex;
    }
    .core-grid {
      justify-content: flex-start;
    }


  }


  /*

   =============================== 
   CORE SERVICES SLIDER (MOBILE) ================================ 
*/
  @media (max-width: 1024px) {
    .core-slider-viewport {
      overflow: hidden;
      width: 100%;
    }

    .core-grid {
      display: flex;
      transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
      gap: 0
    }

    .core-card {
      flex: 0 0 50%;
      box-sizing: border-box;
    }

  }


  @media (max-width: 640px) {
    .core-grid {
      padding: 0;
    }
    .core-services .core-title {
      font-size: 26px;
    }
    .core-icons {
      flex-wrap: nowrap;
      justify-content: center;
      padding: 0;
      gap: 2px;
    }


    .core-card {
      flex: 0 0 100%;
    }
  }


  /*

   ================================= 
   CORE SERVICES SCROLL ANIMATION 
   – SAFE VERSION (LIKE VISION) 
   ================================= 
*/

  /* trạng thái gốc – KHÔNG ẨN */
  .core-title,
  .core-subtitle,
  .core-icon,
  .core-card {
    opacity: 1;
    transform: translateY(0);
  }

  /* chỉ chuẩn bị khi JS active */
  .js-animate .core-services.is-prepare .core-title,
  .js-animate .core-services.is-prepare .core-subtitle,
  .js-animate .core-services.is-prepare .core-icon,
  .js-animate .core-services.is-prepare .core-card {
    opacity: 0;
    transform: translateY(40px);
  }

  /* animate khi scroll xuống */
  .js-animate .core-services.is-animate .core-title,
  .js-animate .core-services.is-animate .core-subtitle,
  .js-animate .core-services.is-animate .core-icon,
  .js-animate .core-services.is-animate .core-card {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 1.5s ease
    , transform 1.5s ease;
  }

  /* delay icon */
  .js-animate .core-services.is-animate .core-icon:nth-child(1) {
    transition-delay: 0.2s;
  }
  .js-animate .core-services.is-animate .core-icon:nth-child(2) {
    transition-delay: 0.35s;
  }
  .js-animate .core-services.is-animate .core-icon:nth-child(3) {
    transition-delay: 0.5s;
  }
  .js-animate .core-services.is-animate .core-icon:nth-child(4) {
    transition-delay: 0.65s;
  }
  .js-animate .core-services.is-animate .core-icon:nth-child(5) {
    transition-delay: 0.8s;
  }
  .js-animate .core-services.is-animate .core-icon:nth-child(6) {
    transition-delay: 0.95s;
  }

  /* delay card */
  .js-animate .core-services.is-animate .core-card:nth-child(1) {
    transition-delay: 0.3s;
  }
  .js-animate .core-services.is-animate .core-card:nth-child(2) {
    transition-delay: 0.45s;
  }
  .js-animate .core-services.is-animate .core-card:nth-child(3) {
    transition-delay: 0.6s;
  }
  .js-animate .core-services.is-animate .core-card:nth-child(4) {
    transition-delay: 0.75s;
  }
  .js-animate .core-services.is-animate .core-card:nth-child(5) {
    transition-delay: 0.9s;
  }
  .js-animate .core-services.is-animate .core-card:nth-child(6) {
    transition-delay: 1.05s;
  }


</style>

