{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}
{% style %}
  .ai-cta-section-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    display: flex;
    align-items: stretch;
  }

  .ai-cta-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
    background: var(--ai-cta-bg);
  }

  /* ===== IMAGE ===== */
  .ai-cta-bg-image-{{ ai_gen_id }} {
    width: 100%;
    height: 420px;
    background: var(--ai-cta-bg);
    border-radius: 40px;
    overflow: hidden;
  }

  .ai-cta-bg-image-{{ ai_gen_id }}
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ===== CONTENT ===== */
  .ai-cta-middle-section-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .ai-cta-content-container-{{ ai_gen_id }} {
    pointer-events: auto;
    max-width: 677px;
    /* padding: 121px 20px; */
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  /* ===== TEXT ===== */
  .ai-cta-heading-{{ ai_gen_id }}
  , .ai-cta-description-{{ ai_gen_id }} {
    transition: opacity 1.2s cubic-bezier(0.22,1,0.36,1)
    , transform 1.2s cubic-bezier(0.22,1,0.36,1);
  }

  /* ===== TOP IMAGE ANIMATION ===== */
  .ai-cta-bg-image-{{ ai_gen_id }} .is-top {
    transition: opacity 1.3s cubic-bezier(0.22,1,0.36,1)
    , transform 1.3s cubic-bezier(0.22,1,0.36,1);
  }


  .ai-cta-heading-{{ ai_gen_id }} {
    font-size: 48px;
    line-height: 52px;
    text-align: center;
    margin: 0;
    background: radial-gradient(50% 100%, #fff 30%, rgba(255,255,255,.5));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .ai-cta-description-{{ ai_gen_id }} {
    text-align: center;
    max-width: 477px;
    font-size: 14px;
    color: #DFE1F4;
  }

  /* ===== BUTTON ===== */
  .ai-cta-button-{{ ai_gen_id }} {
    height: 40px;
    padding: 8px 16px;
    border-radius: 36px;
    background: #fff;
    color: #010314;
    font-size: 12px;
    text-decoration: none;
  }

  .ai-cta-logo-{{ ai_gen_id }}
  img {
    width: 89px;
    height: auto;
  }

  /* ===== MOBILE ===== */
  @media (max-width: 749px) {

    .ai-cta-logo-{{ ai_gen_id }}img {
      width: 64px;
    }
    .ai-cta-bg-image-{{ ai_gen_id }} {
      height: 220px;
      border-radius: 32px;
    }

    .ai-cta-content-container-{{ ai_gen_id }} {
      padding: 20px;
      gap: 20px;
    }

    .ai-cta-heading-{{ ai_gen_id }} {
      font-size: 28px;
      line-height: 32px;
    }
    .ai-cta-button-{{ ai_gen_id }} {
      height: auto;
      width: 50%;
      padding: 8px 0;
      text-align: center;
    }
  }
{% endstyle %}

<section class="ai-cta-section-{{ ai_gen_id }}" style="--ai-cta-bg: {{ section.settings.section_bg_color }};">
  <div class="ai-cta-wrapper-{{ ai_gen_id }}">
    <div class="ai-cta-bg-image-{{ ai_gen_id }} is-top">
      {{ section.settings.top_image | image_url: width: 2000 | image_tag }}
    </div>

    <div class="ai-cta-middle-section-{{ ai_gen_id }}">
      <div class="ai-cta-content-container-{{ ai_gen_id }}">
        {% if section.settings.logo %}
          <div class="ai-cta-logo-{{ ai_gen_id }}">
            {{ section.settings.logo | image_url: width: 200 | image_tag: loading: 'lazy' }}
          </div>
        {% endif %}
        <h2 class="ai-cta-heading-{{ ai_gen_id }}">
          {{ section.settings.heading }}
        </h2>

        <p class="ai-cta-description-{{ ai_gen_id }}">
          {{ section.settings.regular_description }}
        </p>

        <a href="{{ section.settings.button_url }}" class="ai-cta-button-{{ ai_gen_id }}">
          {{ section.settings.button_text }} →
        </a>
      </div>
    </div>

    <div class="ai-cta-bg-image-{{ ai_gen_id }}">
      {{ section.settings.bottom_image | image_url: width: 2000 | image_tag }}
    </div>
  </div>
</section>

<script>
  (function () {
    const section = document.querySelector('.ai-cta-wrapper-{{ ai_gen_id }}');
    if (!section) return;
  
    const heading = section.querySelector('.ai-cta-heading-{{ ai_gen_id }}');
    const desc = section.querySelector('.ai-cta-description-{{ ai_gen_id }}');
    const topImage = section.querySelector('.ai-cta-bg-image-{{ ai_gen_id }}.is-top');
  
    function reset() {
      if (topImage) {
        topImage.style.opacity = 0;
        topImage.style.transform = 'translateY(60px)';
      }
  
      heading.style.opacity = 0;
      heading.style.transform = 'translateY(40px)';
  
      desc.style.opacity = 0;
      desc.style.transform = 'translateX(-40px)';
    }
  
    function animateIn() {
      if (topImage) {
        topImage.style.opacity = 1;
        topImage.style.transform = 'translateY(0)';
      }
  
      heading.style.opacity = 1;
      heading.style.transform = 'translateY(0)';
  
      setTimeout(() => {
        desc.style.opacity = 1;
        desc.style.transform = 'translateX(0)';
      }, 240);
    }
  
    reset();
  
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateIn();
          } else {
            reset();
          }
        });
      },
      {
        threshold: 0.35,
      }
    );
  
    observer.observe(section);
  })();
</script>

{% schema %}
  {
    "name": "Call to action",
    "settings": [
      {
        "type": "image_picker",
        "id": "top_image",
        "label": "Top image"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "text",
        "id": "bold_description",
        "label": "Bold description"
      }, {
        "type": "textarea",
        "id": "regular_description",
        "label": "Description"
      }, {
        "type": "text",
        "id": "button_text",
        "label": "Button text"
      }, {
        "type": "url",
        "id": "button_url",
        "label": "Button link"
      }, {
        "type": "image_picker",
        "id": "bottom_image",
        "label": "Bottom image"
      }, {
        "type": "color",
        "id": "section_bg_color",
        "label": "Section background color",
        "default": "#020313"
      }
    ],
    "presets": [
      {
        "name": "Call to action"
      }
    ]
  }
{% endschema %}