{% stylesheet %}
  .contact-planet {
    position: relative;
    padding-top: 150px;
    padding-bottom: 120px;
    background: #020312;
    color: #ffffff;
    text-align: center;
    overflow: hidden;
  }
  /* Layout */
  .contact-planet__wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 1;
  }
  .contact-planet__head {
    max-width: 820px;
    margin: 0 auto 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  } /* ===== BADGE (FIX CỨNG – KHÔNG ĂN BACKGROUND) ===== */
  .contact-planet .contact-planet__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 16px;
    min-height: 28px;
    border-radius: 999px;
    background: #0b0d1a !important;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 8px 24px rgba(0, 0, 0, 0.45);
    color: #ffffff;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.2px;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  } /* Title */
  .contact-planet__title {
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: -1.04px;
    margin: 0;
    background: radial-gradient(50% 100% at 50% 50%, #ffffff 30%, rgba(255, 255, 255, 0.5) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  } /* Description */
  .contact-planet__desc {
    max-width: 620px;
    font-size: 16px;
    line-height: 24px;
    opacity: 0.9;
    margin: 0;
  } /* Form */
  .contact-planet__form-shell {
    display: flex;
    justify-content: center;
    margin-top: 48px;
  }
  .contact-planet__form {
    width: min(475px, 100%);
    padding: 32px;
    border-radius: 20px;
    background: rgba(1, 3, 20, 0.4);
    border: 1px solid rgba(144, 107, 242, 0.25);
    box-shadow: 0 4px 17.6px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  } /* Inputs */
  .contact-planet__input {
    width: 100%;
    padding: 14px 20px;
    border-radius: 46px;
    background: transparent;
    border: 1px solid rgba(154, 121, 244, 0.53);
    color: #ffffff;
    font-size: 14px;
    font-weight: 500;
  }
  .contact-planet__input::placeholder {
    color: rgba(255, 255, 255, 0.65);
  }
  .contact-planet__input:focus {
    outline: none;
    border-color: rgba(154, 121, 244, 0.9);
    box-shadow: 0 0 0 2px rgba(154, 121, 244, 0.25);
  }

  .contact-planet__input:-webkit-autofill,
  .contact-planet__input:-webkit-autofill:hover,
  .contact-planet__input:-webkit-autofill:focus,
  .contact-planet__input:-webkit-autofill:active {
    -webkit-text-fill-color: #ffffff !important;
    caret-color: #ffffff;

    box-shadow: 0 0 0 1000px rgba(1, 3, 20, 0.85) inset !important;
    border: 1px solid rgba(154, 121, 244, 0.53);

    transition: background-color 9999s ease-in-out 0s;
  }

  .shopify-challenge__container {
    animation: captchaFade 0.35s ease-out;
  }

  @keyframes captchaFade {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .contact-planet__textarea {
    border-radius: 18px;
    resize: vertical;
    min-height: 110px;
  } /* Button */
  .contact-planet__submit {
    align-self: center;
    padding: 10px 24px;
    border-radius: 46px;
    background: rgb(102, 51, 238);
    border: 1px solid rgba(154, 121, 244, 0.53);
    color: #ffffff;
    font-weight: 500;
    cursor: pointer;
  }
  .contact-planet__submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(102, 51, 238, 0.35);
  } /* Alerts */
  .contact-planet__alert {
    font-size: 14px;
    padding: 10px;
    border-radius: 12px;
    text-align: left;
  }
  .contact-planet__alert.success {
    border: 1px solid #4ade80;
  }
  .contact-planet__alert.error {
    border: 1px solid #f87171;
  } /* Social */
  .contact-planet__social {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 48px;
    flex-wrap: wrap;
  }
  .contact-planet__social-item img {
    width: 56px;
    height: 56px;
    object-fit: contain;
  }
  .contact-planet__social-item:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }
  .contact-planet__bg-image {
    position: absolute;
    inset: auto 0 0 0;
    width: 100%;
    height: auto;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }
  .contact-planet__bg-image img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }
  .js-contact-animate {
    opacity: 0;
    transform: translateY(120px);
    transition: opacity 2.2s cubic-bezier(0.16, 1, 0.3, 1), transform 2.2s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }
  .js-contact-animate.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .js-contact-animate.js-delay {
    transition-delay: 0.6s;
  }
  .js-social-item {
    opacity: 0;
    transform: translateY(80px) scale(0.9);
    transition: opacity 1.6s cubic-bezier(0.16, 1, 0.3, 1), transform 1.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i) * 0.18s);
    will-change: transform, opacity;
  }
  .js-social-animate.is-visible .js-social-item {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .contact-success-overlay {
    position: fixed;
    inset: 0;
    background: rgba(2, 3, 18, 0.75);
    backdrop-filter: blur(6px);
    z-index: 9999;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contact-success-popup {
    background: rgba(10, 12, 30, 0.95);
    border: 1px solid rgba(154, 121, 244, 0.35);
    border-radius: 20px;
    padding: 32px 28px;
    max-width: 360px;
    width: calc(100% - 48px);
    text-align: center;

    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    animation: popupIn 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-success-popup h3 {
    margin: 0 0 8px;
    font-size: 20px;
    font-weight: 600;
    color: #ffffff;
  }

  .contact-success-popup p {
    font-size: 14px;
    opacity: 0.85;
    margin-bottom: 20px;
  }

  .contact-success-close {
    padding: 10px 26px;
    border-radius: 999px;
    border: none;
    cursor: pointer;

    background: rgb(102, 51, 238);
    color: #fff;
    font-weight: 500;
  }

  .contact-success-close:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgba(102, 51, 238, 0.45);
  }

  @keyframes popupIn {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Mobile */
  @media (max-width: 767px) {
    .js-contact-animate {
      transform: translateY(80px);
      transition-duration: 1.6s;
    }
    .contact-planet {
      padding-top: 120px;
      padding-bottom: 100px;
    }
    .contact-planet__form {
      padding: 28px 24px;
    }
    .contact-planet__bg-image {
      height: auto;
    }
  }
{% endstylesheet %}
<section class="contact-planet section-wrapper" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="contact-planet__wrap">
    <!-- Header -->
    <header class="contact-planet__head js-contact-animate">
      {% if section.settings.navigate != blank %}
        <span class="contact-planet__badge"> {{ section.settings.navigate }} </span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="contact-planet__title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="contact-planet__desc">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>
    <!-- Form -->
    <div class="contact-planet__form-shell js-contact-animate js-delay">
      {% assign form_id = section.id | prepend: 'ContactForm-' %}
      {%- form 'contact', id: form_id, class: 'contact-planet__form' -%}
        <input type="hidden" name="return_to" value="{{ request.path }}">
        {% if form.posted_successfully? %}
          <div class="contact-planet__alert success">{{ 'blocks.contact_form.post_success' | t }}</div>
        {% endif %}
        {% if form.errors %}
          <div class="contact-planet__alert error">{{ form.errors | default_errors }}</div>
        {% endif %}
        <input class="contact-planet__input" type="text" name="contact[name]" placeholder="Name" autocomplete="name">
        <input
          class="contact-planet__input"
          type="email"
          name="contact[email]"
          placeholder="Email"
          autocomplete="email"
          required
        >
        <input class="contact-planet__input" type="tel" name="contact[phone]" placeholder="Phone" autocomplete="tel">
        <textarea
          class="contact-planet__input contact-planet__textarea"
          name="contact[body]"
          rows="3"
          placeholder="Message"
        ></textarea>
        <button type="submit" class="contact-planet__submit">{{ section.settings.button_label }}</button>
      {%- endform -%}
    </div>
    {% if section.blocks.size > 0 %}
      <div class="contact-planet__social js-social-animate">
        {% for block in section.blocks %}
          <a
            class="contact-planet__social-item js-social-item"
            href="{{ block.settings.link | default: '#' }}"
            target="_blank"
            rel="noopener"
            style="--i: {{ forloop.index0 }};"
          >
            {% if block.settings.icon != blank %}
              <img src="{{ block.settings.icon | image_url: width: 80 }}" alt="social icon" width="56" height="56">
            {% endif %}
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
  {% if section.settings.bottom_image %}
    <div class="contact-planet__bg-image">
      {{ section.settings.bottom_image | image_url: width: 2000 | image_tag: loading: 'lazy' }}
    </div>
  {% endif %}
  {% if request.params.contact_posted %}
    <div class="contact-success-overlay" id="contactSuccessPopup">
      <div class="contact-success-popup">
        <h3>Message sent!</h3>
        <p>Thank you for contacting us. We’ll get back to you shortly.</p>
        <button class="contact-success-close" onclick="closeContactSuccess()">OK</button>
      </div>
    </div>
  {% endif %}
</section>
<script>
  (function () {
    const items = document.querySelectorAll('.js-contact-animate');
    if (!items.length) return;
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.25 }
    );
    items.forEach((item) => observer.observe(item));
  })();
</script>
<script>
  (function () {
    const social = document.querySelector('.js-social-animate');
    if (!social) return;
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.25 }
    );
    observer.observe(social);
  })();
</script>
<script>
  if (window.location.search.includes('contact_posted')) {
    setTimeout(() => {
      const url = new URL(window.location);
      url.searchParams.delete('contact_posted');
      window.history.replaceState({}, '', url.pathname);
    }, 1000);
  }
</script>

{% schema %}
{
  "name": "Contact",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "navigate", "label": "Navigate label", "default": "Contact" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make it easy for potential customers to reach out."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get in touch with our sales and support teams for product questions, live architecture sessions, demos and more."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send" },
    { "type": "image_picker", "id": "bottom_image", "label": "Bottom background image" },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 148
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "social",
      "name": "Social icon",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "label", "label": "Label (fallback)" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Contact" }]
}
{% endschema %}
