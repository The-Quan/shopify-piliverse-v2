{% assign gen_id = section.id | replace: '_', '' | downcase %}

{% style %}
    .why-choose-section-{{ gen_id }} {
      width: 100%;
      position: relative;
      display: flex;
    }

    .why-choose-wrapper-{{ gen_id }} {
      width: 100%;
      position: relative;
      overflow: hidden;
      background: #030312;
    }

    .why-choose-bg-image-{{ gen_id }} {
      width: 100%;
      height: 700px;
      border-radius: 40px;
      overflow: hidden;
      position: relative;
      z-index: 1;
    }

    .why-choose-bg-image-{{ gen_id }} img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .why-choose-middle-{{ gen_id }} {
      position: relative;
      z-index: 2;
      display: flex;
      justify-content: center;
      pointer-events: none;
      margin-top: -600px;
    }

    .why-choose-content-{{ gen_id }} {
      pointer-events: auto;
      max-width: 1100px;
      width: 100%;
      padding: 180px 16px 140px;
      display: grid;
      grid-template-columns: 1fr 480px;
      gap: 96px;
      align-items: center;
    }

    .why-choose-title-{{ gen_id }} {
      font-size: 48px;
      line-height: 52px;
      font-weight: 500;
      margin-bottom: 24px;
      background: radial-gradient(50% 100%, #fff 30%, rgba(255,255,255,.5));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .why-choose-desc-{{ gen_id }} {
      font-size: 14px;
      line-height: 21px;
      color: #DFE1F4;
      max-width: 520px;
      margin-bottom: 56px;
    }

    .why-choose-items-{{ gen_id }} {
      display: grid;
      grid-template-columns: repeat(2,1fr);
      gap: 32px;
      max-width: 600px;
    }

    .why-choose-item-{{ gen_id }} {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .why-choose-item-head-{{ gen_id }} {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .why-choose-item-head-{{ gen_id }} img {
      width: 20px;
      height: 20px;
    }

    .why-choose-item-title-{{ gen_id }} {
      font-size: 16px;
      font-weight: 500;
      color: #fff;
    }

    .why-choose-item-desc-{{ gen_id }} {
      font-size: 13px;
      line-height: 20px;
      color: #BABCD2;
    }

    .why-choose-code-{{ gen_id }} {
      width: 100%;
      height: 420px;
      border-radius: 16px;
      overflow: hidden;
      background: #010314;
      box-shadow:
        0 0 0 1px rgba(255,255,255,.08) inset,
        0 30px 80px rgba(0,0,0,.5);
    }

    .why-choose-code-{{ gen_id }} img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .why-choose-bg-image-{{ gen_id }}.is-top {
        opacity: 0;
        transform: translateY(140px);
        transition:
        opacity 2.1s cubic-bezier(.22,1,.36,1),
        transform 2.1s cubic-bezier(.22,1,.36,1);
      }


    .why-choose-bg-image-{{ gen_id }}.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .wc-animate-up {
    opacity: 0;
    transform: translateY(80px);
    transition:
     opacity 1.3s cubic-bezier(.22,1,.36,1),
    transform 1.3s cubic-bezier(.22,1,.36,1);
  }

  .wc-animate-up.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .wc-animate-right {
    opacity: 0;
    transform: translateX(-80px);
    transition:
      opacity 1.1s cubic-bezier(.22,1,.36,1),
  transform 1.1s cubic-bezier(.22,1,.36,1);
  }

  .wc-animate-right.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

    @media (max-width: 768px) {

        .why-choose-middle-{{ gen_id }} {
            margin-top: -320px;
        }
      .why-choose-bg-image-{{ gen_id }} {
        height: 360px;
        border-radius: 32px;
      }

      .why-choose-content-{{ gen_id }} {
        grid-template-columns: 1fr;
        gap: 64px;
        padding: 120px 16px;
      }

      .why-choose-title-{{ gen_id }} {
        font-size: 32px;
        line-height: 36px;
        text-align: center;
      }

      .why-choose-desc-{{ gen_id }} {
        text-align: center;
        margin: 0 auto 40px;
      }

      .why-choose-items-{{ gen_id }} {
        grid-template-columns: 1fr;
      }

      .why-choose-code-{{ gen_id }} {
        height: 300px;
      }
    }
{% endstyle %}

<section class="why-choose-section-{{ gen_id }}">
  <div class="why-choose-wrapper-{{ gen_id }}">
    {% if section.settings.top_image %}
      <div class="why-choose-bg-image-{{ gen_id }} is-top">
        {{ section.settings.top_image | image_url: width: 2400 | image_tag }}
      </div>
    {% endif %}

    <div class="why-choose-middle-{{ gen_id }}">
      <div class="why-choose-content-{{ gen_id }}">
        <div>
          <h2 class="why-choose-title-{{ gen_id }} wc-animate-up">
            {{ section.settings.title }}
          </h2>

          <p class="why-choose-desc-{{ gen_id }} wc-animate-up">
            {{ section.settings.description }}
          </p>

          <div class="why-choose-items-{{ gen_id }}">
            {% for block in section.blocks %}
              <div
                class="why-choose-item-{{ gen_id }} wc-animate-right"
                data-delay="{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
                <div class="why-choose-item-head-{{ gen_id }}">
                  {{ block.settings.icon | image_url: width: 40 | image_tag }}
                  <div class="why-choose-item-title-{{ gen_id }}">
                    {{ block.settings.item_title }}
                  </div>
                </div>
                <div class="why-choose-item-desc-{{ gen_id }}">
                  {{ block.settings.item_description }}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

        <div class="why-choose-code-{{ gen_id }} wc-animate-up">
          {{ section.settings.code_image | image_url: width: 1200 | image_tag }}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const bg = document.querySelector('.why-choose-bg-image-{{ gen_id }}.is-top');
    if (!bg) return;

    const bgObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          bg.classList.add('is-visible');
        } else {
          bg.classList.remove('is-visible');
        }
      },
      { threshold: 0.05 }
    );

    bgObserver.observe(bg);
  })();
</script>

<script>
  (function () {
    const section = document.querySelector('.why-choose-section-{{ gen_id }}');
    if (!section) return;

    const animateUpEls = section.querySelectorAll('.wc-animate-up');
    const animateRightEls = section.querySelectorAll('.wc-animate-right');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const el = entry.target;

          if (!entry.isIntersecting || el._wcRevealed) return;

          if (el.dataset.delay) {
            const delay = parseInt(el.dataset.delay, 10) * 180;
            el._wcTimeout && clearTimeout(el._wcTimeout);
            el._wcTimeout = setTimeout(() => {
              el.classList.add('is-visible');
            }, delay);
          } else {
            el.classList.add('is-visible');
          }

          el._wcRevealed = true;
          observer.unobserve(el);
        });
      },
      {
        threshold: 0.25,
      }
    );

    animateUpEls.forEach((el) => observer.observe(el));
    animateRightEls.forEach((el) => observer.observe(el));
  })();
</script>

{% schema %}
{
  "name": "Why Choose Us",
  "settings": [
    { "type": "image_picker", "id": "top_image", "label": "Top background image" },
    { "type": "text", "id": "title", "label": "Title", "default": "Why Choose Us?" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "image_picker", "id": "code_image", "label": "Right image" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "item_title", "label": "Title" },
        { "type": "textarea", "id": "item_description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
