<style>
  .client-success {
    padding: 200px 0 180px;
    position: relative;
    text-align: center;
    background: #020313;
    overflow: hidden;
  }

  .client-success__container {
    max-width: 1088px;
    margin: 0 auto;
  }

  .client-success__ellipse-top {
    position: absolute;
    top: var(--ellipse-top-offset, -90px);
    left: 50%;
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 0;
  }

  .client-success__title {
    font-size: 48px;
    font-weight: 500;
    margin-bottom: 20px;
    padding-top: 80px;
    background: radial-gradient(50% 100%, #ffffff 30%, rgba(255, 255, 255, 0.5) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.2;
    opacity: 0;
    transform: translateY(120px);
    transition: opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1), transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .client-success__desc {
    max-width: 640px;
    margin: 0 auto 96px;
    font-size: 14px;
    line-height: 22px;
    color: #dfe1f4;
    opacity: 0.85;
    opacity: 0;
    transform: translateY(98px);
    transition: opacity 1.1s cubic-bezier(0.22, 1, 0.36, 1), transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .client-success__desc.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .client-success__desc.is-visible-no-anim {
    opacity: 1;
    transform: translateY(0);
    transition: none;
  }

  .client-success__title.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .client-success__title.is-visible-no-anim {
    opacity: 1;
    transform: translateY(0);
    transition: none;
  }

  /* ===== SLIDER STRUCTURE ===== */
  .client-success__slider-clip {
    overflow: hidden;
  }

  .client-success__slider-wrapper {
    position: relative;
    isolation: isolate;
    padding-bottom: 100px;
    z-index: 2;
  }

  .client-success__ellipse-top {
    position: absolute;
    transform: translateX(-50%);
    top: 10px;
    left: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .client-success-track {
    display: flex;
    gap: 21px;
    cursor: grab;
    transition: transform 2.55s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
    user-select: none;
  }

  .client-success-track:active {
    cursor: grabbing;
  }

  .client-slide {
    flex: 0 0 325px;
    display: flex;
    justify-content: center;
    opacity: 0.35;
    transform: scale(0.92);
    filter: blur(0.3px);
    transition: 0.35s ease;
    cursor: pointer;
  }

  .client-slide.is-active {
    opacity: 1;
    filter: none;
    cursor: default;
  }

  .client-slide.is-active .client-card {
    transform: translateY(0) scale(1.12);
    animation: client-card-enter 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .client-slide.is-near {
    opacity: 0.6;
  }

  .client-slide.is-near .client-card {
    transform: translateY(0) scale(0.98);
  }

  /* ===== CARD ===== */
  @keyframes client-card-enter {
    0% {
      opacity: 0;
      transform: translateY(48px) scale(0.92);
    }
    60% {
      opacity: 1;
      transform: translateY(-6px) scale(1.1);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1.12);
    }
  }

  .client-card {
    width: 325px;
    min-height: 320px;
    padding: 24px 20px;
    border-radius: 10px;
    background: linear-gradient(0deg, rgba(255, 255, 255, 0.002), rgba(255, 255, 255, 0.002)),
      linear-gradient(0deg, #010314, #010314);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12) inset, 0 20px 60px rgba(0, 0, 0, 0.4);
    color: #fff;
    display: flex;
    flex-direction: column;
    text-align: center;
    position: relative;
    z-index: 2;
    opacity: 0;
    transform: translateY(60px) scale(1);
    transition: opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1), transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity;
  }

  .client-card.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .client-card.is-visible-no-anim {
    opacity: 1;
    transform: translateY(0) scale(1);
    transition: none;
  }

  /* ===== ACTIVE CARD TEXT EMPHASIS ===== */
  .client-slide.is-active .client-content {
    font-size: 14px;
    line-height: 22px;
    color: #ffffff;
    opacity: 1;
  }

  .client-slide.is-active .client-name {
    font-size: 17px;
    color: #ffffff;
  }

  .client-slide.is-active .client-position {
    color: rgba(255, 255, 255, 0.85);
  }

  .client-avatar {
    width: 86px;
    height: 86px;
    border-radius: 50%;
    margin: 0 auto 14px;
    object-fit: cover;
  }

  .client-content {
    font-size: 13px;
    line-height: 20px;
    opacity: 0.85;
    margin-bottom: 12px;
  }

  .client-name {
    font-weight: 700;
    font-size: 16px;
  }

  .client-position {
    font-size: 13px;
    color: #aaa;
  }

  /* ===== ELLIPSE ===== */
  .client-success__ellipse {
    position: absolute;
    left: 50%;
    bottom: 150px;
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 0;
  }

  /* ===== PAGINATION ===== */
  .client-pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: -10px;
  }

  .client-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(135, 95, 241, 0.5);
    cursor: pointer;
  }

  .client-dot.active {
    background: #875ff1;
  }

  /* ===== MOBILE ===== */
  @media (max-width: 768px) {
    .client-success {
      padding: 96px 16px 120px;
    }

    .client-success__title {
      font-size: 32px;
      margin-bottom: 64px;
    }

    .client-success__ellipse-top {
      top: -10px;
      width: 420px;
      max-width: 100%;
      opacity: 0.9;
    }

    .client-slide {
      flex: 0 0 100%;
      opacity: 1 !important;
      filter: none !important;
      transform: none !important;
    }

    .client-slide.is-active .client-card {
      transform: translateY(0) scale(1);
      animation: none;
    }

    .client-success-track {
      gap: 0;
    }

    /* card full width */
    .client-card {
      width: 100%;
      min-height: auto;
      padding: 24px 20px 28px;
    }

    .client-avatar {
      width: 72px;
      height: 72px;
    }

    .client-content {
      font-size: 14px;
      line-height: 22px;
    }

    .client-name {
      margin-top: 8px;
    }

    .client-success__ellipse {
      display: none !important;
    }

    .client-pagination {
      margin-top: 24px;
    }

    .client-dot {
      width: 8px;
      height: 8px;
      opacity: 0.6;
      transition: all 0.25s ease;
    }

    .client-dot.active {
      width: 28px;
      border-radius: 999px;
      opacity: 1;
    }

    .client-success__desc {
      margin-bottom: 64px;
      font-size: 14px;
      line-height: 22px;
    }

    .client-slide.is-active .client-content,
    .client-slide.is-active .client-name,
    .client-slide.is-active .client-position {
      font-size: inherit;
      color: #ffffff;
    }
  }
</style>

<section class="client-success js-client-success">
  {% if section.settings.ellipse_top_image %}
    <img
      src="{{ section.settings.ellipse_top_image | image_url: width: 2000  }}"
      width="361"
      height="191"
      alt="Top ellipse"
      class="client-success__ellipse-top"
      loading="lazy"
    >
  {% endif %}

  <div class="client-success__container">
    <h2 class="client-success__title">
      {{ section.settings.title }}
    </h2>

    {% if section.settings.description != blank %}
      <p class="client-success__desc">
        {{ section.settings.description }}
      </p>
    {% endif %}

    <div class="client-success__slider-clip">
      <div class="client-success__slider-wrapper">
        <div class="client-success-track">
          {% for block in section.blocks %}
            <div class="client-slide" {{ block.shopify_attributes }}>
              <div class="client-card-wrap">
                <div class="client-card">
                  {% if block.settings.avatar %}
                    {{
                      block.settings.avatar
                      | image_url: width: 200
                      | image_tag: class: 'client-avatar', loading: 'lazy', alt: block.settings.name
                    }}
                  {% endif %}

                  <p class="client-content">
                    {{ block.settings.content }}
                  </p>

                  <h4 class="client-name">
                    {{ block.settings.name }}
                  </h4>

                  <p class="client-position">
                    {{ block.settings.position }}
                  </p>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    {% if section.settings.show_ellipse and section.settings.ellipse_image %}
      <img
        src="{{ section.settings.ellipse_image | image_url: width: 361 }}"
        width="361"
        height="191"
        alt="ellipse background"
        class="client-success__ellipse"
        loading="lazy"
      >
    {% endif %}

    <div class="client-pagination"></div>
  </div>
</section>

<script>
  (function () {
    function init(section) {
      const track = section.querySelector('.client-success-track');
      const slides = [...section.querySelectorAll('.client-slide')];
      const dotsWrap = section.querySelector('.client-pagination');
      const wrapper = section.querySelector('.client-success__slider-wrapper');

      let hasMoved = false;

      if (slides.length < 3) return;

      const GAP = 21;
      let index = Math.floor(slides.length / 2);

      /* ===== DRAG STATE ===== */
      let startX = 0;
      let isDragging = false;

      function slideWidth() {
        return slides[0].offsetWidth + GAP;
      }

      function clamp(i) {
        return Math.max(0, Math.min(i, slides.length - 1));
      }

      function update() {
        slides.forEach((s) => s.classList.remove('is-active', 'is-near'));

        slides[index].classList.add('is-active');
        slides[index - 1]?.classList.add('is-near');
        slides[index + 1]?.classList.add('is-near');

        let offset;

        if (window.innerWidth <= 768) {
          offset = -(index * wrapper.offsetWidth);
        } else {
          offset = -(index * slideWidth()) + wrapper.offsetWidth / 2 - slideWidth() / 2;
        }

        track.style.transform = `translateX(${offset}px)`;

        dotsWrap.querySelectorAll('.client-dot').forEach((d, i) => d.classList.toggle('active', i === index));
      }

      dotsWrap.innerHTML = '';
      slides.forEach((_, i) => {
        const dot = document.createElement('div');
        dot.className = 'client-dot';
        dot.onclick = () => {
          index = i;
          update();
        };
        dotsWrap.appendChild(dot);
      });

      /* ===== CLICK SLIDE ===== */
      slides.forEach((slide, i) => {
        slide.onclick = () => {
          if (hasMoved) return;
          index = i;
          update();
        };
      });

      /* ===== DRAG / SWIPE ===== */
      track.addEventListener('mousedown', dragStart);
      track.addEventListener('touchstart', dragStart, { passive: true });

      track.addEventListener('mouseup', dragEnd);
      track.addEventListener('mouseleave', dragEnd);
      track.addEventListener('touchend', dragEnd);

      function dragStart(e) {
        isDragging = true;
        hasMoved = false;
        startX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
      }

      function dragEnd(e) {
        if (!isDragging) return;
        isDragging = false;
        hasMoved = true;

        const endX = e.type.includes('touch') ? e.changedTouches[0].clientX : e.clientX;

        const diff = endX - startX;

        if (Math.abs(diff) < 50) return; // threshold

        if (diff < 0) {
          index = clamp(index + 1); // swipe left
        } else {
          index = clamp(index - 1); // swipe right
        }

        update();
      }

      update();
      window.addEventListener('resize', () => {
        index = clamp(index);
        update();
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.js-client-success').forEach(init);
    });

    document.addEventListener('shopify:section:load', (e) => {
      if (e.target.classList.contains('js-client-success')) {
        init(e.target);
      }
    });
  })();
</script>

  <script>
    (function () {
    const sections = document.querySelectorAll('.js-client-success');

      sections.forEach((section) => {
        const title = section.querySelector('.client-success__title');
        const desc = section.querySelector('.client-success__desc');
        const cards = section.querySelectorAll('.client-card');

        if (!title) return;

        const SHOW_THRESHOLD = 0.35;
        let revealed = false;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const ratio = entry.intersectionRatio;

            if (ratio >= SHOW_THRESHOLD && !revealed) {
              title.classList.add('is-visible');
              title.classList.remove('is-visible-no-anim');

              if (desc) {
                desc.classList.add('is-visible');
                desc.classList.remove('is-visible-no-anim');
              }

              cards.forEach((card) => {
                card.classList.add('is-visible');
                card.classList.remove('is-visible-no-anim');
              });

              revealed = true;
              observer.disconnect();
            }
            });
          },
        { threshold: [SHOW_THRESHOLD] }
        );

      observer.observe(title);
    });
  })();
</script>

{% schema %}
{
  "name": "Client Success Stories",
  "settings": [
    {
      "type": "image_picker",
      "id": "ellipse_top_image",
      "label": "Top ellipse image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Client Success Stories"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section description",
      "default": "Real feedback from businesses that achieved outstanding results with our solutions."
    },
    {
      "type": "checkbox",
      "id": "show_ellipse",
      "label": "Show ellipse background",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "ellipse_image",
      "label": "Ellipse background image"
    }
  ],
  "blocks": [
    {
      "type": "client",
      "name": "Client",
      "settings": [
        { "type": "image_picker", "id": "avatar", "label": "Avatar" },
        { "type": "textarea", "id": "content", "label": "Content" },
        { "type": "text", "id": "name", "label": "Client name" },
        { "type": "text", "id": "position", "label": "Position" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Client Success Stories",
      "blocks": [{ "type": "client" }, { "type": "client" }, { "type": "client" }]
    }
  ]
}
{% endschema %}
