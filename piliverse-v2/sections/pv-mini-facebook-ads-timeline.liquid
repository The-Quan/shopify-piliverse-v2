<script>
  (() => {
    const section = document.querySelector('.pv-timeline');
    if (!section) return;

    let lastScrollY = window.scrollY;
    let scrollingDown = true;

    window.addEventListener('scroll', () => {
      scrollingDown = window.scrollY > lastScrollY;
      lastScrollY = window.scrollY;
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        // CHỈ animate khi:
        // 1. Đang cuộn xuống
        // 2. Section bắt đầu đi vào viewport từ trên
        if (entry.isIntersecting && scrollingDown && entry.boundingClientRect.top > 0) {
          section.classList.add('is-animate');
        }

        // Reset khi cuộn ngược lên trên section
        if (!entry.isIntersecting && entry.boundingClientRect.top > 0) {
          section.classList.remove('is-animate');
        }
      },
      {
        threshold: 0.25,
      }
    );

    observer.observe(section);
  })();
</script>
