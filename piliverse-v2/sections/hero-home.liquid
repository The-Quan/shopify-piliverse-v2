{% comment %} 
      Hero Section – Home Hero (Centered Layout) 
{% endcomment %}

<section class="hero" style="
    --hero-padding-top: {{ section.settings.padding_top }}px;
    --hero-padding-bottom: {{ section.settings.padding_bottom }}px;
  ">
  {%- if section.settings.bg_image != blank -%}
    <div class="hero-bg">
      <img
        src="{{ section.settings.bg_image | image_url: width: 2000 }}"
        alt="{{ section.settings.bg_image.alt | escape }}"
        width="{{ section.settings.bg_image.width }}"
        height="{{ section.settings.bg_image.height }}"
        loading="lazy">
    </div>
  {%- endif -%}

  <div class="hero-container">
    <div class="hero-stack">
      {% for block in section.blocks %}
        {% case block.type %}

          {% when 'hero_image' %}
            {%- if block.settings.image != blank -%}
              <div class="hero-media animate-zoom" {{ block.shopify_attributes }}>
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy">
              </div>
            {%- endif -%}

          {% when 'content' %}
            <div class="hero-content animate-zoom" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h1 class="hero-title">
                  {{ block.settings.heading }}
                </h1>
              {% endif %}

              {% if block.settings.description != blank %}
                <p class="hero-desc">
                  {{ block.settings.description }}
                </p>
              {% endif %}

              {% if block.settings.button_text != blank %}
                <a href="{{ block.settings.button_link }}" class="hero-btn animate-btn">
                  {{ block.settings.button_text }}
                </a>
              {% endif %}
            </div>

        {% endcase %}
      {% endfor %}
    </div>
  </div>

  {%- if section.settings.bottom_image != blank -%}
    <div class="hero-bottom-image">
      <img
        src="{{ section.settings.bottom_image | image_url: width: 2000 }}"
        alt="{{ section.settings.bottom_image.alt | escape }}"
        width="{{ section.settings.bottom_image.width }}"
        height="{{ section.settings.bottom_image.height }}"
        loading="lazy">
    </div>
  {%- endif -%}
</section>

<style>
  /* ================= HERO BASE ================= */
  .hero {
    position: relative;
    overflow: hidden;
    background: #010312;
    padding-top: var(--hero-padding-top);
    padding-bottom: var(--hero-padding-bottom);
  }

  /* Background image */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* ================= ANIMATION BASE ================= */
  .animate-zoom {
    opacity: 0;
    transform: scale(1.15);
    transition: opacity 0.8s ease
    , transform 0.8s ease;
  }

  .animate-zoom.is-visible {
    opacity: 1;
    transform: scale(1);
  }

  .animate-btn {
    opacity: 0;
    transform: translateY(100px);
    transition: opacity 1.5s ease
    , transform 1.5s ease;
  }

  .animate-btn.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ================= CONTENT ================= */
  .hero-container {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .hero-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Hero image */
  .hero-media {
    margin-bottom: 40px;
  }

  .hero-media img {
    max-width: 380px;
    width: 100%;
    height: auto;
  }

  /* Text */
  .hero-content {
    max-width: 900px;
    color: #fff;
  }

  .hero-title {
    font-size: 55px;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 20px;
  }

  .hero-desc {
    font-size: 16px;
    line-height: 1.6;
    opacity: 0.85;
    margin-bottom: 30px;
  }

  /* Button */
  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 30px;
    border-radius: 999px;
    background: #fff;
    color: #000;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    text-transform: uppercase;
  }

  .hero-btn:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  /* ================= BOTTOM GRADIENT IMAGE ================= */
  .hero-bottom-image {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    z-index: 1;
    pointer-events: none;
  }

  .hero-bottom-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ================= RESPONSIVE ================= */
  @media (max-width: 991px) {
    .hero {
      position: relative;
      height: auto;
    }
    .hero-title {
      font-size: 32px;
    }
  }

  @media (max-width: 575px) {
    .hero-media img {
      max-width: 260px;
    }

    .hero-title {
      font-size: 26px;
    }

    .hero-desc {
      font-size: 14px;
    }
  }
</style>

{% schema %}
  {
    "name": "Hero Section",
    "tag": "section",
    "class": "section-hero",
    "settings": [
      {
        "type": "image_picker",
        "id": "bg_image",
        "label": "Background image"
      }, {
        "type": "image_picker",
        "id": "bottom_image",
        "label": "Bottom gradient image"
      }, {
        "type": "range",
        "id": "padding_top",
        "label": "Padding top",
        "min": 0,
        "max": 200,
        "step": 10,
        "default": 80
      }, {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding bottom",
        "min": 0,
        "max": 200,
        "step": 10,
        "default": 80
      }
    ],
    "blocks": [
      {
        "type": "hero_image",
        "name": "Hero Image",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Hero image"
          }
        ]
      }, {
        "type": "content",
        "name": "Hero Content",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "PILIVERSE – WHERE INNOVATION MEETS CREATIVITY"
          }, {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "Add your hero description here"
          }, {
            "type": "text",
            "id": "button_text",
            "label": "Button text",
            "default": "TALK TO EXPERT"
          }, {
            "type": "url",
            "id": "button_link",
            "label": "Button link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Hero – Home",
        "blocks": [
          {
            "type": "hero_image"
          }, {
            "type": "content"
          }
        ]
      }
    ]
  }
{% endschema %}
<script>
(function () {
  function initHeroAnimation(scope = document) {
    const zoomElements = scope.querySelectorAll('.animate-zoom');
    const btnElements  = scope.querySelectorAll('.animate-btn');

    if (!zoomElements.length && !btnElements.length) return;

    let lastScrollY = window.scrollY;

    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          const currentScrollY = window.scrollY;
          const scrollingDown = currentScrollY > lastScrollY;
          const scrollingUp   = currentScrollY < lastScrollY;

          if (entry.isIntersecting && scrollingDown) {
            entry.target.classList.add('is-visible');
          }

          if (!entry.isIntersecting && scrollingUp) {
            entry.target.classList.remove('is-visible');
          }

          lastScrollY = currentScrollY;
        });
      },
      { threshold: 0.35 }
    );

    [...zoomElements, ...btnElements].forEach(el => {
      el.classList.add('is-visible'); // 🔑 HIỂN THỊ NGAY TRONG EDITOR
      observer.observe(el);
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initHeroAnimation();
  });

  // 🔥 SHOPIFY THEME EDITOR SUPPORT
  document.addEventListener('shopify:section:load', e => {
    initHeroAnimation(e.target);
  });
})();
</script>
