{% comment %} 
      Image Divider Section 
{% endcomment %}

<section class="image-divider" style="
    background-color: {{ section.settings.background }};
    --divider-width: {{ section.settings.image_width }}%;
  ">

  {% if section.settings.image != blank %}
    <img
      src="{{ section.settings.image | image_url: width: 2000 }}"
      alt="{{ section.settings.image.alt | escape }}"
      width="{{ block.settings.logo.width }}"
      height="{{ block.settings.logo.height }}"
      loading="lazy">
  {% endif %}
</section>

<style>
  .image-divider {
    width: 100%;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0;
    margin: 0;
  }

  .image-divider img {
    width: var(--divider-width, 60%);
    height: auto;
    display: block;
    pointer-events: none;
    user-select: none;
  }
  @media (max-width: 767px) {
    .image-divider img {
      width: 100%;
    }
  }
  @media (max-width: 480px) {
    .image-divider img {
      width: 100%;
    }
  }

</style>

{% schema %}
  {
    "name": "Image Divider",
    "tag": "section",
    "class": "section-image-divider",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Divider image"
      }, {
        "type": "color",
        "id": "background",
        "label": "Background color",
        "default": "#010314"
      }, {
        "type": "range",
        "id": "image_width",
        "label": "Image width (desktop)",
        "min": 30,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 60
      }

    ],
    "presets": [
      {
        "name": "Image Divider"
      }
    ]
  }
{% endschema %}