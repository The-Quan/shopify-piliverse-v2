<section class="service-hero">
  {% if section.settings.gradient_image != blank %}
    <div class="service-hero__gradient">
      <img
        src="{{ section.settings.gradient_image | image_url: width: 2000 }}"
        alt=""
        loading="lazy">
    </div>
  {% endif %}

  <div class="service-hero__content">

    {% if section.settings.badge != blank %}
      <span class="service-hero__badge">
        {{ section.settings.badge }}
      </span>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="service-hero__title">
        {{ section.settings.heading }}
      </h1>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="service-hero__desc">
        {{ section.settings.description }}
      </p>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link | default: '#' }}" class="service-hero__btn">

        <span class="btn-text">
          {{ section.settings.button_label }}
        </span>

        <span class="btn-icon" aria-hidden="true">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none">
            <path
              d="M5 12H19M19 12L13 6M19 12L13 18"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round" />
          </svg>
        </span>
      </a>
    {% endif %}

    <div class="service-icon-link">
      {% if section.blocks.size > 0 %}
        <div class="service-icon-link-item">
          {% for block in section.blocks %}
            <a
              href="{{ block.settings.link | default: '#' }}"
              target="_blank"
              rel="noopener"
              style="--i: {{ forloop.index0 }};">
              {% if block.settings.icon != blank %}
                <img
                  src="{{ block.settings.icon | image_url: width: 80 }}"
                  alt="social icon"
                  width="56"
                  height="56">
              {% endif %}
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>

  </div>

</section>

<style>
  /* ================= BASE ================= */
  .service-hero {
    position: relative;
    min-height: 100vh;
    background: #010314;
    overflow: hidden;

    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  /* ================= GRADIENT IMAGE ================= */
  .service-hero__gradient {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 0;
    pointer-events: none;
  }

  .service-hero__gradient img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ================= CONTENT ================= */
  .service-hero__content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    padding: 0 20px;
  }

  /* ================= BADGE ================= */
  .service-hero__badge {
    display: inline-block;
    margin-bottom: 20px;
    padding: 6px 14px;

    font-size: 12px;
    letter-spacing: 0.05em;
    color: #fff;

    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(6px);
    box-shadow: inset 0 -4px 8px rgba(255, 255, 255, 0.1);
  }

  /* ================= TITLE ================= */
  .service-hero__title {
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 700;
    line-height: 1.25;
    /* giãn dòng */
    color: #fff;
    margin-bottom: 24px;
  }

  /* ================= DESCRIPTION ================= */
  .service-hero__desc {
    max-width: 720px;
    margin: 0 auto 40px;

    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.75);
  }

  /* ================= BUTTON ================= */
  .service-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;

    padding: 14px 30px;
    border-radius: 999px;

    background: #fff;
    color: #010314;

    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;

    transition: transform 0.25s ease
    , box-shadow 0.25s ease;
  }

  .service-hero__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(255, 255, 255, 0.25);
  }

  .service-hero__btn svg {
    transition: transform 0.25s ease;
  }

  .service-hero__btn:hover svg {
    transform: translateX(4px);
  }

  .service-icon-link {
    width: 100%;
    padding: 30px 0;
  }

  .service-icon-link-item {
    width: 100%;
    display: flex;
    justify-content: center;
    gap: 50px;
  }

  .service-icon-link-item a {
    width: 56px;
  }

  /* ================= MOBILE ================= */
  @media (max-width: 768px) {
    .service-hero__title {
      font-size: 26px;
    }
    .service-hero {
      min-height: 90vh;
    }

    .service-hero__desc {
      margin-bottom: 32px;
    }
    .service-hero__btn {
      padding: 10px 20px;
    }

    .service-icon-link-item {
      gap: 30px;
    }
  }
</style>

{% schema %}
  {
    "name": "Service Hero – Centered",
    "settings": [
      {
        "type": "image_picker",
        "id": "gradient_image",
        "label": "Bottom Gradient Image"
      },
      {
        "type": "text",
        "id": "badge",
        "label": "Badge",
        "default": "Service"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Facebook Agency Ads Accounts For Rent"
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "Pili Verse offers ad account rental services at the most competitive prices on the market. We accept ALL INDUSTRIES."
      }, {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "Talk to expert"
      }, {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
      }
    ],
    "presets": [
      {
        "name": "Facebook Ad Account Hero"
      }
    ],
    "blocks": [
      {
        "type": "social",
        "name": "Social icon",
        "settings": [
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          }, {
            "type": "text",
            "id": "label",
            "label": "Label (fallback)"
          }, {
            "type": "url",
            "id": "link",
            "label": "Link"
          }
        ]
      }
    ]
  }
{% endschema %}