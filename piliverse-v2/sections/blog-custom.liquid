<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<blog-posts-list
  section-id="{{ section.id }}"
  class="blog-posts blog-posts--custom"
>
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="
      section
      color-{{ section.settings.color_scheme }}
      blog-posts
      spacing-style
      size-style
    "
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% content_for 'blocks' %}

    {%- assign featured_article = blog.articles.first -%}

    {%- if featured_article -%}
      <section class="featured-blog-section">
        <div class="featured-blog">
          <div class="featured-blog__content">
            <span class="featured-blog__date">
              {{ featured_article.published_at | date: '%B %d, %Y' }}
            </span>

            <h1 class="featured-blog__title">
              {{ featured_article.title }}
            </h1>

            <p class="featured-blog__excerpt">
              {{ featured_article.excerpt_or_content | strip_html | truncate: 180 }}
            </p>

            <a href="{{ featured_article.url }}" class="featured-blog__btn">READ MORE →</a>
          </div>

          {%- if featured_article.image -%}
            <div class="featured-blog__image">
              {{ featured_article.image | image_url: width: 1800 | image_tag }}
            </div>
          {%- endif -%}
        </div>
      </section>
    {%- endif -%}

    {%- paginate blog.articles by 4 -%}
      <span ref="viewMorePrevious"></span>
      <div
        ref="grid"
        class="blog-posts-container"
        data-last-page="{{ paginate.pages }}"
      >
        {% for article in blog.articles offset: 1 %}
          <div
            class="blog-post-item"
            ref="cards[]"
            data-page="{{ paginate.current_page }}"
          >
            {% content_for 'block',
              id: 'static-blog-post-card-custom',
              type: '_blog-post-card-custom',
              article: article
            %}
          </div>
        {% endfor %}
      </div>
      <span ref="viewMoreNext"></span>

      <div class="blog-posts--custom__pagination">
        {{- paginate | default_pagination -}}
      </div>
    {%- endpaginate -%}
  </div>
</blog-posts-list>

{% stylesheet %}
  .blog-posts--custom .section-background {
    background: #010314;
  }

  .blog-posts--custom .blog-posts {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
    padding: 140px 24px 80px;
    background: #010314;
    display: grid;
    gap: 64px;
  }

  /* Ngăn size-style kéo section cao bất thường */
  .blog-posts--custom .section.size-style {
    min-height: auto;
  }

  .blog-posts--custom__pagination {
    display: flex;
    justify-content: center;
  }

  .blog-posts--custom__pagination .pagination {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .blog-posts--custom__pagination .pagination a,
  .blog-posts--custom__pagination .pagination .current {
    padding: 10px 14px;
    border-radius: 10px;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  .blog-posts--custom__pagination .pagination .current {
    background: #ffffff;
    color: #010314;
    font-weight: 700;
  }

  .blog-posts--custom .featured-blog-section {
    background: #010314;
    color: #ffffff;
  }

  .blog-posts--custom .featured-blog {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    align-items: center;
  }

  .blog-posts--custom .featured-blog__content {
    display: grid;
    gap: 16px;
  }

  .blog-posts--custom .featured-blog__date {
    width: fit-content;
    padding: 8px 12px;
    border-radius: 37px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 12px;
  }

  .blog-posts--custom .featured-blog__title {
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.1;
    font-weight: 500;
    background: radial-gradient(50% 100%, #fff 30%, rgba(255, 255, 255, 0.5) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .blog-posts--custom .featured-blog__excerpt {
    font-size: 16px;
    line-height: 24px;
    opacity: 0.9;
  }

  .blog-posts--custom .featured-blog__btn {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 18px;
    width: auto;
    max-width: max-content;
    white-space: nowrap;
    border-radius: 999px;
    background: #ffffff;
    color: #010314;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.3px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .blog-posts--custom .featured-blog__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
  }

  .blog-posts--custom .featured-blog__image img {
    width: 100%;
    height: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: 12px;
  }

  .blog-posts--custom .blog-posts-container {
    max-width: 1371px;
    margin: 0 auto;
    padding: 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    justify-content: center;
    gap: 24px;
    background: #ffffff;
    border-radius: 40px;
  }

  .blog-posts--custom .blog-post-item,
  .blog-posts--custom .blog-post-item:nth-child(2),
  .blog-posts--custom .blog-post-item:nth-child(3),
  .blog-posts--custom .blog-post-item:first-child {
    grid-column: auto;
  }

  .blog-posts--custom .blog-post-item {
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
  }

  .blog-posts--custom .blog-post-card-custom {
    height: 600px;
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    background: linear-gradient(180deg, #111024 0%, #231c3b 50%, #a489eb 100%);
    border: 1px solid rgba(125, 84, 198, 0.22);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .blog-posts--custom .blog-post-card-custom:hover {
    transform: translateY(-6px);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.35);
  }

  .blog-posts--custom .blog-post-card-custom__image-container {
    width: 100%;
  }

  .blog-posts--custom .blog-post-card-custom__image-container a,
  .blog-posts--custom .blog-post-card-custom__image-container img {
    display: block;
    width: 100%;
    height: 32%;
    min-height: 180px;
    object-fit: cover;
    border-radius: 20px 20px 0 0;
  }

  .blog-posts--custom .blog-post-card-custom__content {
    height: 68%;
    padding: 22px 24px 26px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-shrink: 0;
  }

  .blog-posts--custom .blog-post-card-custom__content .rte {
    display: flex;
    flex-direction: column;
    flex: 1;
    color: unset;
  }

  .blog-posts--custom .blog-post-card-custom__content .rte-formatter {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .blog-posts--custom .blog-post-card-custom__content .text-block--heading-1,
  .blog-posts--custom .blog-post-card-custom__content .text-block--heading-4 {
    font-size: var(--font-size--heading-4, 22px);
    font-weight: 700;
    line-height: 1.35;
    color: #ffffff;
    margin-bottom: 8px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    white-space: normal;
  }

  .blog-posts--custom .blog-post-card-custom__content > a {
    font-size: var(--font-size--heading-4, 22px);
    font-weight: 700;
    line-height: 1.35;
    color: #ffffff !important;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    white-space: normal;
  }

  .blog-posts--custom .blog-post-card-custom__content > a:hover,
  .blog-posts--custom .blog-post-card-custom__content > a:focus-visible {
    color: #ffffff !important;
    text-decoration: none;
  }

  .blog-posts--custom .blog-post-card-custom__content > a .text-block {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    white-space: normal;
  }

  .blog-posts--custom .blog-post-card-custom__content p {
    font-size: 14px;
    line-height: 22px;
    color: #ffffff;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: break-all;
    word-wrap: break-word;
  }

  .blog-posts--custom .blog-post-card-custom__content-text,
  .blog-posts--custom .blog-post-card-custom__content-text * {
    color: #ffffff !important;
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: break-all;
    word-wrap: break-word;
  }

  .blog-posts--custom .blog-post-card-custom__content-text a {
    color: #010314 !important;
  }

  .blog-posts--custom .blog-post-details,
  .blog-posts--custom .blog-post-info-text {
    font-size: 12px;
    color: #ffffff;
    opacity: 1;
    margin-top: -25px;
    margin-bottom: -5px;
  }

  .blog-posts--custom .blog-post-card-custom__content a {
    color: #ffffff;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    white-space: normal;
  }

  .blog-posts--custom .blog-post-card-custom__content a:hover,
  .blog-posts--custom .blog-post-card-custom__content a:focus-visible {
    color: #ffffff;
    text-decoration: none;
  }

  .blog-posts--custom .blog-post-card-custom__content .rte a {
    position: absolute;
    left: 24px;
    bottom: 26px;
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 18px;
    width: auto;
    max-width: fit-content;
    white-space: nowrap;
    border-radius: 999px;
    background: #ffffff;
    color: #010314;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 1100px) {
    .blog-posts--custom .featured-blog {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .blog-posts--custom .featured-blog__image img {
      max-height: 360px;
    }

    .blog-posts--custom .blog-posts-container {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
  }

  /* ===========================
   <= 768px (Mobile & Tablet dọc)
=========================== */
  @media (max-width: 768px) {
    /* SECTION */
    .blog-posts--custom .blog-posts {
      padding: 56px 16px 72px;
      gap: 40px;
    }

    /* FEATURED BLOG */
    .blog-posts--custom .featured-blog {
      grid-template-columns: 1fr;
    }

    .blog-posts--custom .featured-blog__image img {
      max-height: 240px;
      border-radius: 16px;
    }

    .blog-posts--custom .featured-blog__title {
      font-size: 28px;
      line-height: 1.2;
    }

    .blog-posts--custom .featured-blog__excerpt {
      font-size: 14px;
      line-height: 22px;
    }

    .blog-posts--custom .featured-blog__btn {
      height: 42px;
      font-size: 13px;
      padding: 0 16px;
    }

    /* GRID */
    .blog-posts--custom .blog-posts-container {
      max-width: 100%;
      padding: 16px;
      gap: 16px;
      grid-template-columns: 1fr;
      border-radius: 24px;
    }

    .blog-posts--custom .blog-post-item {
      max-width: 100%;
      margin: 0;
    }

    /* BLOG CARD */
    .blog-posts--custom .blog-post-card-custom {
      border-radius: 20px;
    }

    .blog-posts--custom .blog-post-card-custom__image-container img {
      aspect-ratio: 16 / 9;
      border-radius: 20px 20px 0 0;
    }

    .blog-posts--custom .blog-post-card-custom__content {
      padding: 18px 18px 22px;
      gap: 10px;
    }

    .blog-posts--custom .blog-post-card-custom__content > a {
      font-size: 18px;
      line-height: 1.3;
      -webkit-line-clamp: 2;
    }

    .blog-posts--custom .blog-post-card-custom__content p {
      font-size: 14px;
      line-height: 21px;
      -webkit-line-clamp: 3;
    }

    .blog-posts--custom .blog-post-card-custom__content .rte a {
      position: static;
      margin-top: auto;
      height: 40px;
      font-size: 13px;
    }
  }

  /* ===========================
   <= 480px (Mobile nhỏ)
=========================== */
  @media (max-width: 480px) {
    .blog-posts--custom .featured-blog__title {
      font-size: 24px;
    }

    .blog-posts--custom .featured-blog__date {
      font-size: 11px;
      padding: 6px 10px;
    }

    .blog-posts--custom .blog-post-card-custom__content > a {
      font-size: 17px;
    }

    .blog-posts--custom .blog-post-card-custom__content p {
      font-size: 13px;
    }

    .blog-posts--custom .blog-post-card-custom__content .rte a {
      height: 38px;
      padding: 0 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog posts (custom)",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Blog posts (custom)"
    }
  ]
}
{% endschema %}
