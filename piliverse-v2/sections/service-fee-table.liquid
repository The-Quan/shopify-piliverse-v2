<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('.service-fee');
    if (!section) return;

    document.documentElement.classList.add('js-animate');

    let lastScrollY = window.scrollY;

    const observer = new IntersectionObserver(
      ([entry]) => {
        const currentScrollY = window.scrollY;
        const scrollingDown = currentScrollY > lastScrollY;
        lastScrollY = currentScrollY;

        if (entry.isIntersecting) {
          if (scrollingDown) {
            // ⬇️ từ trên xuống → animate
            section.classList.remove('is-prepare');
            section.classList.add('is-animate');
          } else {
            // ⬆️ từ dưới lên → hiện ngay
            section.classList.remove('is-prepare', 'is-animate');
          }
        } else {
          // ra khỏi viewport → reset
          section.classList.remove('is-animate');
          section.classList.add('is-prepare');
        }
      },
      { threshold: 0.35 }
    );

    // trạng thái ban đầu
    section.classList.add('is-prepare');
    observer.observe(section);
  });
</script>
