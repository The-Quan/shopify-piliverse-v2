{% comment %}
  Service Fee Table Section
{% endcomment %}

<section
  id="service-fee-{{ section.id }}"
  class="service-fee"
>
  {% if section.settings.gradient_image != blank %}
    <div class="service-fee-gradient">
      <img
        src="{{ section.settings.gradient_image | image_url: width: 2400 }}"
        alt=""
        loading="lazy"
      >
    </div>
  {% endif %}

  {% if section.settings.scroll_pricing_table != blank %}
    <button
      type="button"
      class="price-scroll-float"
      data-target="#service-fee-{{ section.id }}"
    >
      {{ section.settings.scroll_pricing_table }}
    </button>
  {% endif %}

  <div class="service-fee-inner">
    {% if section.settings.title != blank %}
      <h2 class="service-fee-title">
        <span class="service-fee-title-inner">{{ section.settings.title }}</span>
      </h2>
    {% endif %}

    {% if section.settings.subtitle != blank %}
      <p class="service-fee-subtitle">
        <span class="service-fee-subtitle-inner">{{ section.settings.subtitle }}</span>
      </p>
    {% endif %}

    <div class="service-fee-table-wrapper">
      <table class="service-fee-table">
        <thead>
          <tr class="table-head-main">
            <th colspan="2">{{ section.settings.vnd_account_title }}</th>
            <th colspan="2">{{ section.settings.usd_account_title }}</th>
          </tr>
          <tr class="table-head-sub">
            <th>{{ section.settings.daily_expenditure }}</th>
            <th>{{ section.settings.account_rental_fee }}</th>
            <th>{{ section.settings.daily_expenditure }}</th>
            <th>{{ section.settings.account_rental_fee }}</th>
          </tr>
        </thead>

        <tbody>
          {% for block in section.blocks %}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.vnd_range }}</td>
              <td>{{ block.settings.vnd_fee }}</td>
              <td>{{ block.settings.usd_range }}</td>
              <td>{{ block.settings.usd_fee }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const buttons = document.querySelectorAll('.price-scroll-float');

    if (!buttons.length) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', function () {
        const targetSelector = btn.getAttribute('data-target');
        const target = document.querySelector(targetSelector);

        if (!target) return;

        const extraOffset = 0;

        const targetPosition = target.getBoundingClientRect().top + window.pageYOffset + extraOffset;

        window.scrollTo({
          top: targetPosition,
          behavior: 'smooth',
        });
      });
    });
  });
</script>

<style>
    /* ===== SECTION ===== */
    .service-fee {
      position: relative;
      background: #020414;
      padding: 140px 20px 120px;
      overflow: hidden;
    }

    /* ===== GRADIENT ===== */
    .service-fee-gradient {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      pointer-events: none;
    }

    .service-fee-gradient img {
      width: 100%;
      height: auto;
      display: block;
    }

    /* ===== INNER ===== */
    .service-fee-inner {
      max-width: 1100px;
      margin: 0 auto;
      text-align: center;
      position: relative;
      z-index: 2;
    }

    .service-fee-title {
      font-size: 40px;
      font-weight: 600;
      color: #fff;
      margin-bottom: 12px;
    }

    .service-fee-subtitle {
      max-width: 720px;
      margin: 0 auto 60px;
      font-size: 15px;
      line-height: 1.7;
      color: rgba(255, 255, 255, 0.7);
    }

    /* ===== TABLE ===== */
    .service-fee-table-wrapper {
      margin-top: 60px;
    }

    .service-fee-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }


    /* HEADER MAIN */
    .service-fee-table thead .table-head-main th {
      font-size: 17px;
      font-weight: 600;
      padding: 18px 12px;
    }

    /* HEADER SUB */
    .service-fee-table thead .table-head-sub th {
      font-size: 14.5px;
      font-weight: 500;
      padding: 14px 10px;
    }

    /* CELLS */
    .service-fee-table th,
    .service-fee-table td {
      text-align: center;
      padding: 14px 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      border-right: 1px solid rgba(255, 255, 255, 0.12);
      color: #fff;
      font-size: 13.5px;
      word-break: break-word;
    }

    .service-fee-table td:last-child,
    .service-fee-table th:last-child {
      border-right: none;
    }

    .service-fee-table tr:last-child td {
      border-bottom: none;
    }

    /* ===== MOBILE ===== */
    @media (max-width: 768px) {
      .service-fee {
        padding: 100px 14px 80px;
      }

      .service-fee-title {
        font-size: 30px;
      }

      .service-fee-subtitle {
        font-size: 14px;
        margin-bottom: 40px;
      }

      .service-fee-table {
        width: 100%;
      }

      .service-fee-table thead .table-head-main th {
        font-size: 13px;
      }

      .service-fee-table thead .table-head-sub th {
        font-size: 11.5px;
      }

      .service-fee-table td {
        font-size: 11.5px;
        padding: 10px 6px;
      }
    }
    .service-fee-table th {
      word-break: normal;
      white-space: normal;
    }
    /* ================= SERVICE FEE ANIMATION ================= */

    /* giữ layout gốc */
    .service-fee-title,
    .service-fee-subtitle {
      position: relative;
    }

    /* inner để animate */
    .service-fee-title-inner,
    .service-fee-subtitle-inner {
      display: inline-block;
      opacity: 1;
      transform: translateY(0);
    }

    /* PREPARE – trước khi animate */
    .js-animate .service-fee.is-prepare .service-fee-title-inner,
    .js-animate .service-fee.is-prepare .service-fee-subtitle-inner {
      visibility: hidden;
      opacity: 0;
      transform: translateY(40px);
    }

    /* ANIMATE IN */
    .js-animate .service-fee.is-animate .service-fee-title-inner,
    .js-animate .service-fee.is-animate .service-fee-subtitle-inner {
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
      transition: opacity 1.5s ease
      , transform 1.5s ease;
    }

    /* delay nhẹ cho subtitle */
    .js-animate .service-fee.is-animate .service-fee-subtitle-inner {
      transition-delay: 0.15s;
    }

    .price-scroll-float {
    position: fixed;
    right: 25px;
    bottom: 100px;
    z-index: 9998;

    padding: 12px 18px;
    border-radius: 999px;
    border: none;

    background: #ffffff;
    color: #020313;

    font-size: 14px;
    font-weight: 600;
    cursor: pointer;

    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);

    transition:
      bottom 0.3s ease,
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  .price-scroll-float:hover {
    transform: translateY(-2px);
  }

  body.contact-fab-open .price-scroll-float {
      bottom: 390px;
    }

  @media (max-width: 768px) {
    .price-scroll-float {
      right: 16px;
      bottom: 82px;

      padding: 10px 14px;
      font-size: 13px;
    }

    body.contact-fab-open .price-scroll-float {
        bottom: 300px;
      }
  }
</style>

