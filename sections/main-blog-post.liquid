<div class="section-background color-{{ section.settings.color_scheme }} blog-post-detail-bg"></div>
<div class="section color-{{ section.settings.color_scheme }} blog-post-detail">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
      blog-post-detail__inner
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    <a
      class="blog-post-detail__back"
      href="{{ blog.url | default: routes.blogs_url }}"
    >
      ←
    </a>

    <div id="article-body" class="blog-post-detail__panel">
      <a
        class="blog-post-detail__back"
        href="{{ blog.url | default: routes.blogs_url }}"
      >
        ←
      </a>
      <div class="blog-post-detail__panel-header">
        <span class="blog-post-detail__panel-date">
          {{ article.published_at | time_tag: format: 'date' }}
        </span>
        <h1 class="blog-post-detail__panel-title">
          {{ article.title }}
        </h1>
        <div class="blog-post-detail__panel-author">
          {{ 'placeholders.blog_post_author' | t | default: 'Author' }}:
          <span>{{ article.author }}</span>
        </div>
      </div>

      <div class="blog-post-detail__panel-content">
        {%- content_for 'block', id: 'blog-post-content', type: '_blog-post-content' %}
      </div>
    </div>

    {% content_for 'blocks' %}

    {% if blog.comments_enabled? %}
      <div class="blog-post-comments-container">
        <h2 class="h3">{{- 'blogs.article.comments_heading' | t: count: article.comments_count -}}</h2>

        <div class="blog-post-comments">
          {% paginate article.comments by 10 %}
            {% for comment in article.comments %}
              <div class="blog-post-comment">
                {{ comment.content }}
                <div class="blog-post-comment__author">
                  <span class="blog-post-comment__author-name">{{- comment.author -}}</span>
                  <span>{{- 'blogs.article.comment_author_separator' | t -}}</span>
                  <span class="blog-post-comment__date">
                    {{- comment.created_at | time_tag: format: 'date' -}}
                  </span>
                </div>
              </div>
            {% endfor %}

            <div class="blog-post-comments-pagination">
              {{- paginate | default_pagination -}}
            </div>
          {% endpaginate %}
        </div>

        {% render 'blog-comment-form', article: article, section_id: section.id %}
      </div>
    {% endif %}
  </div>
</div>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% stylesheet %}
  /* Blog detail styling to match app UI */
  .blog-post-detail-bg {
    background: #070918;
  }

  .blog-post-detail {
    background: #070918;
    color: #e8ecf7;
  }

  .blog-post-detail__inner {
    width: 100%;
    max-width: 1271px;
    margin: 0 auto;
    padding: 84px 16px 120px;
    box-sizing: border-box;
    display: grid;
    gap: 96px;
    position: relative;
  }

  .blog-post-detail__hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: center;
  }
  .blog-post-detail__hero-text {
    display: grid;
    gap: 20px;
    align-items: flex-start;
    justify-items: flex-start;
  }

  .blog-post-detail__date-chip {
    padding: 8px 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 37px;
    width: fit-content;
    color: #ffffff;
    font-size: 12px;
    box-shadow: 0 -4px 7px rgba(255, 255, 255, 0.1) inset, 0 4px 4px rgba(255, 255, 255, 0.1) inset;
  }

  .blog-post-detail__header .text-block--heading-1,
  .blog-post-detail__header .h1,
  .blog-post-detail__header h1 {
    font-size: clamp(32px, 6vw, 48px);
    line-height: 1.15;
    font-weight: 600;
    margin: 0;
    background: radial-gradient(50% 100% at 50% 50%, #ffffff 30%, rgba(255, 255, 255, 0.5) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .blog-post-detail__header,
  .blog-post-detail__header * {
    color: #ffffff;
  }

  .blog-post-detail__header .blog-post-details {
    color: #8fa3c8;
    font-size: 14px;
    margin-top: 6px;
  }

  .blog-post-detail__excerpt {
    font-size: 16px;
    line-height: 24px;
    color: #ffffff;
    max-width: 620px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-post-detail__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 18px;
    border-radius: 36px;
    background: #ffffff;
    color: #010314;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .blog-post-detail__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
  }

  .blog-post-detail__inner > .blog-post-detail__back {
    display: none;
  }

  .blog-post-detail__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-radius: 12px;
    background: rgba(4, 4, 4, 0.05);
    color: #2f2f2f;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    justify-self: start;
    margin-bottom: 10px;
  }

  .blog-post-detail__back:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
    background: rgba(4, 4, 4, 0.08);
  }

  .blog-post-detail__hero-image {
    display: none;
    width: 100%;
    height: 100%;
  }

  .blog-post-detail__hero-image img {
    width: 100%;
    height: 100%;
    max-height: 344px;
    object-fit: cover;
    border-radius: 18px;
  }

  @media (min-width: 768px) {
    .blog-post-detail__hero {
      grid-template-columns: minmax(0, 55%) minmax(0, 45%);
      gap: 32px;
    }

    .blog-post-detail__hero-image {
      display: block;
    }
  }

  .blog-post-detail__panel {
    width: 100%;
    max-width: 1271px;
    margin: 0 auto;
    background: #ffffff;
    color: #040404;
    border-radius: 40px;
    padding: 48px 16px 64px;
    box-sizing: border-box;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    display: grid;
    gap: 24px;
  }

  .blog-post-detail__panel-header {
    display: grid;
    gap: 12px;
  }

  .blog-post-detail__panel-date {
    font-size: 12px;
    font-weight: 500;
    color: #040404;
    opacity: 0.8;
  }

  .blog-post-detail__panel-title {
    font-size: 48px;
    line-height: 52px;
    letter-spacing: -1.04px;
    color: #2f2f2f;
    margin: 0;
  }

  .blog-post-detail__panel-author {
    font-size: 16px;
    line-height: 24px;
    color: #040404;
  }
  .blog-post-detail__panel-author span {
    color: #2f2f2f;
    font-weight: 500;
  }

  .blog-post-detail__panel-content {
    display: grid;
    gap: 18px;
    color: #040404;
  }

  .blog-post-detail__panel-content p {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
    color: #040404;
  }

  .blog-post-detail__panel-content h2 {
    font-size: clamp(24px, 4.5vw, 32px);
    line-height: 1.2;
    margin: 12px 0 6px;
    color: #2f2f2f;
  }

  .blog-post-detail__panel-content h3 {
    font-size: clamp(20px, 4vw, 26px);
    line-height: 1.25;
    margin: 10px 0 4px;
    color: #2f2f2f;
  }

  .blog-post-detail__panel-content a {
    color: #2146ff;
    text-decoration: underline;
  }

  .blog-post-detail__panel-content img,
  .blog-post-detail__panel-content figure img {
    width: 100%;
    height: auto;
    border-radius: 18px;
    object-fit: cover;
  }

  .blog-post-detail__panel-content blockquote {
    margin: 0;
    padding: 16px 18px;
    border-left: 3px solid #2146ff;
    background: rgba(0, 0, 0, 0.03);
    border-radius: 10px;
    color: #2f2f2f;
  }

  .blog-post-detail__panel-content ul,
  .blog-post-detail__panel-content ol {
    padding-left: 20px;
    display: grid;
    gap: 8px;
  }

  @media (min-width: 1024px) {
    .blog-post-detail__panel {
      padding: 108px 200px;
      gap: 28px;
    }
  }

  @media (max-width: 768px) {
    .blog-post-detail__inner {
      padding: 64px 16px 96px;
      gap: 64px;
    }

    .blog-post-detail__back {
      padding: 9px 12px;
      font-size: 13px;
      margin-bottom: 14px;
    }

    .blog-post-detail__panel {
      padding: 48px 18px 64px;
      border-radius: 30px;
    }

    .blog-post-detail__panel-title {
      font-size: clamp(28px, 7vw, 36px);
      line-height: 1.25;
    }
  }

  .blog-post-comments-container {
    width: 100%;
    max-width: var(--normal-content-width);
    margin: 0 auto;
  }

  .blog-post-comments {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xl);
  }

  .blog-post-comment__author {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    margin-top: var(--margin-md);
    font-size: var(--font-size--body-sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .blog-post-comments-pagination {
    display: flex;
    justify-content: center;
    gap: var(--gap-2xs);
  }

  .blog-post-comments-pagination,
  .blog-post-comments-pagination a {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a {
    display: block;
    padding: var(--padding-2xs) var(--padding-xs);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a:hover {
    border-bottom: 1px solid var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_post",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "class": "section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
