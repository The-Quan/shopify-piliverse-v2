<section class="why-us">
  <div class="container">

    <div class="container-heading">
      <h2 class="title">
        {{ section.settings.heading }}
      </h2>

      <p class="description">{{ section.settings.description }}</p>
    </div>

    <div class="btn-mobile">
      <a href="{{ section.settings.button_link }}" class="btn">
        {{ section.settings.button_text }}
      </a>
    </div>

    <div class="why-us-wrapper">

      <svg
        class="circle-svg"
        width="900"
        height="450"
        viewBox="0 100 500 300">
        <circle
          cx="250"
          cy="250"
          r="200"
          stroke="#ed66d0"
          fill="none"
          stroke-width="1" />
      </svg>

      <!-- LEFT SIDE -->
      <div class="side left">
        {% for block in section.blocks %}
          {% if block.settings.position == "left" %}
            <div
              class="item js-item"
              data-number="{{ block.settings.number }}"
              data-title="{{ block.settings.text }}"
              data-text="{{ block.settings.text }}"
              data-description="{{ block.settings.description }}"
              data-icon="{% if block.settings.icon != blank %}{{ block.settings.icon | image_url: width: 1600 }}{% endif %}">
              <div class="top">
                <div class="icon">
                  {% if block.settings.icon != blank %}
                    <img
                      src="{{ block.settings.icon | image_url: width: 1600 }}"
                      width="{{ block.settings.icon.width }}"
                      height="{{ block.settings.icon.height }}"
                      alt="">
                  {% endif %}
                </div>
                <div class="content">
                  <p>{{ block.settings.text }}</p>
                </div>
              </div>
              <div class="item-content">
                {{ block.settings.description }}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <!-- CENTER -->
      <div class="center">
        <div class="center-box">
          {% assign first_block = section.blocks | first %}

          {% if first_block %}
            <span class="number js-number">{{ first_block.settings.number }}</span>
            <h3 class="js-title">{{ first_block.settings.text }}</h3>
            <p class="js-text">{{ first_block.settings.description }}</p>
          {% endif %}

          <a href="{{ section.settings.button_link }}" class="btn">
            {{ section.settings.button_text }}
          </a>
        </div>
      </div>

      <!-- RIGHT SIDE -->
      <div class="side right">
        {% for block in section.blocks %}
          {% if block.settings.position == "right" %}
            <div
              class="item js-item"
              data-number="{{ block.settings.number }}"
              data-title="{{ block.settings.text }}"
              data-text="{{ block.settings.text }}"
              data-description="{{ block.settings.description }}"
              data-icon="{% if block.settings.icon != blank %}{{ block.settings.icon | image_url: width: 1600 }}{% endif %}">
              <div class="top-2">
                <div class="icon">
                  {% if block.settings.icon != blank %}
                    <img
                      src="{{ block.settings.icon | image_url: width: 1600 }}"
                      width="{{ block.settings.icon.width }}"
                      height="{{ block.settings.icon.height }}"
                      alt="">
                  {% endif %}
                </div>
                <div class="content">
                  <p>{{ block.settings.text }}</p>
                </div>
              </div>
              <div class="item-content">
                {{ block.settings.description }}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  .why-us {
    width: 100%;
    background: #020414;
    height: 800px;
    display: flex;
    justify-content: space-between;
  }
  .container {
    width: 1200px;
    margin: 0 auto;
  }

  .container-heading {
    padding: 0 10px;
    margin-bottom: 50px;
  }

  .container-heading .title {
    font-size: 28px;
    color: white;
    text-align: center;
  }

  .container-heading .description {
    font-size: 16px;
    color: white;
    text-align: center;
  }

  .why-us-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
  }

  .circle-svg {
    position: absolute;
    top: 59%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 0;
  }

  .side,
  .center {
    position: relative;
    z-index: 1;
  }


  .side {
    width: 30%;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }


  .side.left {
    align-items: flex-end;
    height: 500px;
  }

  .side.left .content {
    margin-top: 30px;
  }

  .side.left .content p {
    font-size: 18px;
  }

  .side.left .item-content {
    display: none;
  }

  .side.left .item {
    position: absolute;
    flex-direction: row-reverse;
    text-align: right;
  }

  .side.right {
    height: 500px;
    align-items: flex-start;
  }

  .side.right .content p {
    font-size: 18px;
  }

  .side.right .content {
    margin-top: 30px;
  }

  .side.right .item-content,
  .btn-mobile {
    display: none;
  }

  .side.right .item {
    position: absolute;
  }

  .top-2 {
    display: flex;
    flex-direction: row;
    gap: 20px;
  }

  .top {
    display: flex;
    flex-direction: row-reverse;
    gap: 20px;
  }


  .item {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 220px;
    cursor: pointer;
    transition: 0.3s;
  }

  .item p {
    color: white;
  }

  .icon {
    width: 82px;
    height: 82px;
    border-radius: 50%;
    background: black;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 3px solid #b14ad6;
  }

  .icon img {
    width: 65px;
    height: 65px;
    border-radius: 100%;
  }

  .center {
    display: flex;
    justify-content: center;
  }

  .center-box {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    max-width: 350px;
    height: 500px;
    padding: 60px 0;
  }

  .center-box .js-title {
    font-size: 25px;
    color: white;
    height: 20%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .center-box .js-text {
    color: white;
    height: 45%;
  }

  .center-box .number {
    height: 10%;
    font-size: 32px;
    font-weight: bold;
    color: #b14ad6;
  }

  .center-box h3 {
    margin: 10px 0;
  }

  .center-box p {
    font-size: 14px;
    color: #666;
  }


  .center {
    perspective: 1000px;
  }

  .center-box {
    transition: transform 0.6s ease
    , opacity 0.3s ease;
    transform-style: preserve-3d;
  }

  .center-box.flip-left {
    transform: rotateY(-90deg);
    opacity: 0;
  }

  .center-box.flip-right {
    transform: rotateY(90deg);
    opacity: 0;
  }

  .btn {
    width: 200px;
    margin: 0 auto;
    display: inline-block;
    margin-top: 20px;
    padding: 10px 20px;
    background: white;
    color: #010314;
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-radius: 25px;
  }

  .item.active .icon {
    box-shadow: 0 0 20px #b14ad6;
    transform: scale(1.1);
  }

  .reveal-up {
    opacity: 0;
    transform: translateY(60px);
    transition: all 1.6s ease;
  }

  .reveal-up.active {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-left {
    opacity: 0;
    transform: translateX(-80px);
    transition: all 1.6s ease;
  }

  .reveal-right {
    opacity: 0;
    transform: translateX(80px);
    transition: all 1.6s ease;
  }

  .reveal-left.active,
  .reveal-right.active {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 768px) {

    .why-us {
      height: auto;
      padding: 40px 0;
    }

    .container-heading {
      margin-bottom: 0;
    }


    .container-heading .description {
      font-size: 12px;
    }

    .btn-mobile {
      padding: 20px 10px;
    }

    .center {
      display: none;
    }

    .why-us-wrapper {
      flex-direction: column;
      align-items: stretch;
    }

    /* Ẩn vòng tròn */
    .circle-svg {
      display: none;
    }

    .side .item {
      position: relative !important;
      left: auto !important;
      top: auto !important;
      width: 100% !important;
    }

    .side {
      width: 95%;
      height: auto;
      margin: 0 auto;
    }

    .side.left {
      margin-bottom: 20px;
    }

    .side.left,
    .side.right {
      gap: 20px;
      align-items: stretch;
      height: auto;
    }
    .side.left .item {
      text-align: left;
    }

    .item {
      max-width: 100%;
      background: rgba(255, 255, 255, 0.02);
      padding: 12px;
      border-radius: 10px;
    }

    .icon {
      width: 55px;
      height: 55px;
    }
    .icon img {
      width: 40px;
      height: 40px;
    }
    .side.left .content,
    .side.right .content {
      margin-top: 15px;
    }

    .top,
    .top-2 {
      width: 100%;
      display: flex;
      gap: 10px;
      display: flex;
      flex-direction: row;
    }

    .item-content {
      display: none;
      margin: 0 10px;
      color: #ccc;
      font-size: 14px;
      border-left: 1px solid white;
      padding: 0 15px;
    }

    .side.left .item,
    .side.right .item {
      flex-direction: column;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }


    .btn {
      font-size: 13px;
    }

    .item.open .item-content,
    .btn-mobile {
      display: block !important;
    }


  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const items = document.querySelectorAll('.js-item');
  const centerBox = document.querySelector('.center-box');

  items.forEach(item => {
    item.addEventListener('click', function () {
      const isMobile = window.innerWidth <= 768;

      // MOBILE: bấm lần 1 mở, bấm lại lần 2 đóng
      if (isMobile) {
        const isOpen = this.classList.contains('open');

        items.forEach(el => {
          el.classList.remove('open');
          el.classList.remove('active');
        });

        if (!isOpen) {
          this.classList.add('open');
          this.classList.add('active');
        }

        return;
      }

      // DESKTOP: giữ logic cũ
      if (this.classList.contains('active')) return;

      const number = this.dataset.number;
      const title = this.dataset.title;
      const description = this.dataset.description;

      const isLeft = this.closest('.side.left');

      centerBox.classList.remove('flip-left', 'flip-right');

      if (isLeft) {
        centerBox.classList.add('flip-left');
      } else {
        centerBox.classList.add('flip-right');
      }

      setTimeout(() => {
        document.querySelector('.js-number').textContent = number;
        document.querySelector('.js-title').textContent = title;
        document.querySelector('.js-text').textContent = description;

        centerBox.classList.remove('flip-left', 'flip-right');
      }, 300);

      items.forEach(el => el.classList.remove('active'));
      this.classList.add('active');
    });
  });
});
</script>

<script>
  
    document.addEventListener('DOMContentLoaded', function () {
    const leftItems = document.querySelectorAll('.side.left .item');
    
    const centerY = 250; 
    const radius = 300;  
    const angleRange = 90; 
    
    const total = leftItems.length;
    
    leftItems.forEach((item, index) => {
      const step = total > 1 ? angleRange / (total - 1) : 0;
      const angle = -angleRange / 2 + step * index;
    
      const rad = angle * Math.PI / 180;
    
      const x = - Math.cos(rad) * radius;
      const y = Math.sin(rad) * radius;
    
      item.style.left = `${415 + x}px`;
      item.style.top = `${centerY + y}px`;
      item.style.width = `500px`;
    });
    });
    
    document.addEventListener('DOMContentLoaded', function () {
    const rightItems = document.querySelectorAll('.side.right .item');
    const container = document.querySelector('.side.right');
    
    const rect = container.getBoundingClientRect();
    const centerY = rect.height / 2;
    
    const radius = 300;
    const angleRange = 90;
    
    const total = rightItems.length;
    
    rightItems.forEach((item, index) => {
      const step = total > 1 ? angleRange / (total - 1) : 0;
      const angle = -angleRange / 2 + step * index;
    
      const rad = angle * Math.PI / 180;
    
      const x = - Math.cos(rad) * radius;
      const y = Math.sin(rad) * radius;
    
      item.style.left = `${-x - 280}px`;
      item.style.top = `${centerY + y}px`;
    });
    });
  
    document.addEventListener("DOMContentLoaded", function () {
  const heading = document.querySelector(".container-heading");
  const center = document.querySelector(".center");
  
  heading.classList.add("reveal-up");
  center.classList.add("reveal-up");
  
  const reveals = document.querySelectorAll(".reveal-up");
  
  function revealOnScroll() {
    const windowHeight = window.innerHeight;
  
    reveals.forEach(el => {
      const elementTop = el.getBoundingClientRect().top;
  
      if (elementTop < windowHeight - 100) {
        el.classList.add("active");
      }
    });
  }
  
  window.addEventListener("scroll", revealOnScroll);
  revealOnScroll();
  });
  
  document.addEventListener("DOMContentLoaded", function () {
  const leftSide = document.querySelector(".side.left");
  const rightSide = document.querySelector(".side.right");
  
  leftSide.classList.add("reveal-left");
  rightSide.classList.add("reveal-right");
  
  function revealOnScroll() {
    const windowHeight = window.innerHeight;
  
    [leftSide, rightSide].forEach(el => {
      const elementTop = el.getBoundingClientRect().top;
  
      if (elementTop < windowHeight - 100) {
        el.classList.add("active");
      }
    });
  }
  
  window.addEventListener("scroll", revealOnScroll);
  revealOnScroll();
  });
</script>

{% schema %}
  {
    "name": "Website Design Criteria",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Lý do bạn nên chọn chúng tôi"
      }, {
        "type": "text",
        "id": "description",
        "label": "Description",
        "default": "Lý do bạn nên chọn chúng tôi"
      }, {
        "type": "text",
        "id": "button_text",
        "label": "Button Text",
        "default": "Tư vấn báo giá"
      }, {
        "type": "url",
        "id": "button_link",
        "label": "Button Link"
      }
    ],
    "blocks": [
      {
        "type": "item",
        "name": "Item",
        "settings": [
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          },
          {
            "type": "text",
            "id": "number",
            "label": "Number"
          },
          {
            "type": "text",
            "id": "text",
            "label": "Text"
          },
          {
            "type": "textarea",
            "id": "description",
            "label": "Description"
          }, {
            "type": "select",
            "id": "position",
            "label": "Position",
            "options": [
              {
                "value": "left",
                "label": "Left"
              }, {
                "value": "right",
                "label": "Right"
              }
            ]
          }
        ]
      }
    ],
    "max_blocks": 8,
    "presets": [
      {
        "name": "Website Design Criteria"
      }
    ]
  }
{% endschema %}