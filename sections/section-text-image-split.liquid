{% comment %} 
        Text Image Split – CLEAN VERSION 
{% endcomment %}

<section class="split-section">

  {% if section.settings.bg_image != blank %}
    <div class="split-bg">
      <img
        src="{{ section.settings.bg_image | image_url: width: 2000 }}"
        alt=""
        loading="lazy">
    </div>
  {% endif %}

  <div class="split-container">
    <div class="split-grid">

      <!-- TEXT -->
      <div class="split-text animate-up">
        {% if section.settings.heading != blank %}
          <h2 class="split-title">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.content != blank %}
          <div class="split-desc">
            {{ section.settings.content }}
          </div>
        {% endif %}

        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link }}" class="split-btn">
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>

      <!-- IMAGE -->
      <div class="split-image animate-zoom">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            alt=""
            loading="lazy">
        {% endif %}
      </div>

    </div>
  </div>

  {% if section.settings.bottom_image != blank %}
    <div class="split-bottom-image">
      <img
        src="{{ section.settings.bottom_image | image_url: width: 2000 }}"
        alt=""
        loading="lazy">
    </div>
  {% endif %}

</section>

<style>
  /* ================= BASE ================= */
  .split-section {
    position: relative;
    background: #05061a;
    padding: 120px 20px;
    overflow: hidden;
    height: 130vh;
  }

  .split-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .split-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .split-container {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ================= DESKTOP ================= */
  .split-grid {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 56px;
    align-items: center;
  }

  .split-image {
    width: 420px;
  }

  .split-image img {
    width: 100%;
    display: block;
  }

  /* ================= TEXT ================= */
  .split-title {
    font-size: 42px;
    font-weight: 600;
    color: radial-gradient(50% 100% at 50% 50%, #FFFFFF 30%, rgba(255, 255, 255, 0.5) 100%);
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .split-desc {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 28px;
  }

  .split-btn {
    display: inline-block;
    padding: 12px 28px;
    border-radius: 999px;
    background: #fff;
    color: #000;
    font-weight: 600;
    text-decoration: none;
  }

  /* ================= BOTTOM GRADIENT ================= */
  .split-bottom-image {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    z-index: 3;
    pointer-events: none;
  }

  .split-bottom-image img {
    width: 100%;
  }
  /* ===== TEXT GRADIENT ===== */
  .split-title {
    color: transparent;
    background: radial-gradient(50% 100% at 50% 50%, #ffffff 30%, rgba(255, 255, 255, 0.5) 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  /* ================= ANIMATION ================= */
  .animate-up {
    opacity: 0;
    transform: translateY(40px);
    transition: 1.2s ease;
  }

  .animate-zoom {
    opacity: 0;
    transform: scale(1.1);
    transition: 1.2s ease;
  }

  .is-visible {
    opacity: 1;
    transform: none;
  }

  /* ================= TABLET ================= */
  @media (max-width: 1200px) {
    .split-container {
      max-width: 95%;
    }
  }

  /* ================= MOBILE ================= */
  @media (max-width: 991px) {

    .split-grid {
      position: relative;
      grid-template-columns: 1fr;
    }

    /* IMAGE – đẩy lên */
    .split-image {
      width: 280px;
      margin: 0 auto;
      transform: translateY(-40px);
      /* 👈 ĐẨY ẢNH LÊN */
    }

    .split-text {
      position: absolute;
      inset: 0;
      z-index: 2;

      display: flex;
      flex-direction: column;
      align-items: center;

      width: 95%;
      margin: 0 auto;
      padding: 0 16px;

      text-align: center;

      transform: translateY(60px);
    }

    .split-title {
      font-size: 24px;
      margin-bottom: 10px;
    }

    .split-desc {
      font-size: 14px;
      line-height: 1.6;
    }

    .split-btn {
      margin-top: 12px;
    }
  }


  /* ================= SMALL MOBILE ================= */
  @media (max-width: 575px) {
    .split-section {
     
      height: 90vh;
    }
    .split-image {
      width: 230px;
      transform: translateY(-100px);
    }
    .split-text {
      transform: translateY(150px);
    }
    .split-title {
      font-size: 30px;
    }

    .split-desc {
      font-size: 13px;
    }
  }
</style>

{% schema %}
  {
    "name": "Text Image Split",
    "tag": "section",
    "class": "section-text-image-split",
    "settings": [
      {
        "type": "image_picker",
        "id": "bg_image",
        "label": "Background image"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "About Us"
      },
      {
        "type": "richtext",
        "id": "content",
        "label": "Content",
        "default": "<p>Your content goes here</p>"
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Button text",
        "default": "Learn more"
      }, {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
      }, {
        "type": "image_picker",
        "id": "image",
        "label": "Right image"
      }, {
        "type": "image_picker",
        "id": "bottom_image",
        "label": "Bottom gradient image"
      }
    ],
    "presets": [
      {
        "name": "Text Image Split"
      }
    ]
  }
{% endschema %}

<script>
(function () {
  function initSplitAnimation(scope = document) {
    const elements = scope.querySelectorAll(
      '.section-text-image-split .animate-up, .section-text-image-split .animate-zoom'
    );

    if (!elements.length) return;

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );

    elements.forEach(el => {
      el.classList.add('is-visible'); 
      observer.observe(el);
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initSplitAnimation();
  });

  document.addEventListener('shopify:section:load', e => {
    initSplitAnimation(e.target);
  });
})();
</script>
