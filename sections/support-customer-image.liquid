<div class="support-customer-image">

  <div class="title-support-customer-image fade-up-support">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p>{{ section.settings.description }}</p>
    {% endif %}
  </div>

  <div class="support-customer-gallery swiper">

    <div class="swiper-wrapper">

      {% for block in section.blocks %}
        <div class="support-customer-gallery-item swiper-slide fade-up-support">

          <div class="customer-image">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 800 | image_tag }}
            {% endif %}
          </div>

          {% if block.settings.text != blank %}
            <p class="customer-text">
              {{ block.settings.text }}
            </p>
          {% endif %}

        </div>
      {% endfor %}

    </div>

  </div>

</div>


<style>

  .support-customer-image {
    width: 100%;
    height: auto;
    background: #020414;
    padding: 120px 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .title-support-customer-image,
  .support-customer-gallery {
    width: 1200px;
    margin: 0 auto;
  }

  .title-support-customer-image {
    color: white;
    text-align: center;
    margin-bottom: 30px;
  }

  .title-support-customer-image h2 {
    font-size: 42px;
    line-height: 1.3;
  }

  .title-support-customer-image p {
    font-size: 16px;
  }

  /* SWIPER */

  .support-customer-gallery {
    position: relative;
  }

  .support-customer-gallery .swiper-wrapper {
    align-items: stretch;
  }

  .support-customer-gallery-item {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* IMAGE */

  .customer-image {
    width: 100%;
    height: 450px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .customer-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .customer-image:hover img {
    transform: scale(1.15);
  }

  /* TEXT */

  .customer-text {
    font-size: 16px;
    color: white;
    text-align: center;
  }

  /* SWIPER BUTTON */

  .swiper-button-next,
  .swiper-button-prev {
    color: white;
  }

  .swiper-button-next:after,
  .swiper-button-prev:after {
    font-size: 22px;
  }

  /* PAGINATION */

  .swiper-pagination {
    margin-top: 30px;
    position: relative;
  }

  .swiper-pagination-bullet {
    background: white;
    opacity: 0.5;
  }

  .swiper-pagination-bullet-active {
    opacity: 1;
  }

  /* RESPONSIVE */

  @media (max-width: 1200px) {

    .title-support-customer-image,
    .support-customer-gallery {
      width: 90%;
    }

  }

  @media (max-width: 992px) {

    .title-support-customer-image h2 {
      font-size: 32px;
    }

    .customer-image {
      height: 350px;
    }

  }

  @media (max-width: 768px) {

    .support-customer-image {
      padding: 70px 0;
    }

    .title-support-customer-image h2 {
      font-size: 26px;
      padding: 20px 0;
    }

    .title-support-customer-image span {
      font-size: 14px;
      line-height: 1.6;
      display: block;
    }

    .customer-text {
      font-size: 13px;
    }

    .fade-up-support,
    .fade-up-support.show {
      opacity: 1 !important;
      transform: translateY(0) !important;
      transition: none !important;
    }

    .support-customer-gallery-item {
      transition-delay: 0s !important;
    }

    .customer-image img {
      transform: none !important;
      transition: none !important;
    }

    .customer-image:hover img {
      transform: none !important;
    }

  }

  /* ANIMATION */

  .fade-up-support {
    opacity: 0;
    transform: translateY(60px);
    transition: all 0.8s ease;
  }

  .fade-up-support.show {
    opacity: 1;
    transform: translateY(0);
  }

  .support-customer-gallery-item:nth-child(1) {
    transition-delay: 0.1s;
  }

  .support-customer-gallery-item:nth-child(2) {
    transition-delay: 0.2s;
  }

  .support-customer-gallery-item:nth-child(3) {
    transition-delay: 0.3s;
  }

  .support-customer-gallery-item:nth-child(4) {
    transition-delay: 0.4s;
  }


  
</style>


<script>
  document.addEventListener("DOMContentLoaded", function () {
    const supportGallery = document.querySelector(".support-customer-gallery");

    if (!supportGallery) return;

    new Swiper(".support-customer-gallery", {
      slidesPerView: 4,
      spaceBetween: 20,
      loop: true,

      autoplay: {
        delay: 3000,
        disableOnInteraction: false
      },

      breakpoints: {
        0: {
          slidesPerView: 1.2,
          autoplay: {
            delay: 3000,
            disableOnInteraction: false
          }
        },

        768: {
          slidesPerView: 2,
          autoplay: false
        },

        992: {
          slidesPerView: 3,
          autoplay: false
        },

        1200: {
          slidesPerView: 4,
          autoplay: false
        }
      }
    });
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
  
  const elements = document.querySelectorAll(".fade-up-support");
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add("show");
        observer.unobserve(entry.target); 
      }
    });
  }, {
    threshold: 0.2 
  });
  
  elements.forEach(el => observer.observe(el));
  
  });
</script>


{% schema %}
  {
    "name": "Support Customer Image",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Tiêu đề"
      }, {
        "type": "textarea",
        "id": "description",
        "label": "Mô tả"
      }
    ],
    "blocks": [
      {
        "type": "image",
        "name": "Image Item",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Select image"
          }, {
            "type": "text",
            "id": "text",
            "label": "Text dưới ảnh"
          }
        ]
      }
    ],
    "max_blocks": 4,
    "presets": [
      {
        "name": "Support Customer Image"
      }
    ]
  }
{% endschema %}