<section class="mosaic-gallery">

  <div class="mosaic-gallery-title fade-up">
    {% if section.settings.gallery_heading != blank %}
      <h2>{{ section.settings.gallery_heading }}</h2>
    {% endif %}

    {% if section.settings.gallery_description != blank %}
      <p class="gallery-description">
        {{ section.settings.gallery_description }}
      </p>
    {% endif %}
  </div>

  <div class="swiper mosaicSwiper">

    <div class="swiper-wrapper">

      {% for block in section.blocks %}
        <div class="swiper-slide mosaic-item fade-up" {{ block.shopify_attributes }}>

          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.image.alt | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy">
          {% endif %}

        </div>
      {% endfor %}

    </div>

  </div>

</section>

<style>

  .mosaic-gallery {
    background: #020414;
    padding: 40px 16px;
    width: 100%;
    height: auto;
    display: flex;
    flex-direction: column;
    gap: 50px;
  }

  .mosaic-gallery-title,
  .mosaic-grid {
    max-width: 1200px;
    height: auto;
    margin: 0 auto;
  }

  .mosaic-gallery-title {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mosaic-gallery-title h2 {
    color: white;
    font-size: 42px;
    margin-bottom: 20px;
    text-align: center;
  }

  .mosaic-gallery-title p {
    font-size: 16px;
    color: white;
    text-align: center;
  }


  .mosaic-item {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
  }

  .mosaic-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: 0.4s;
  }

  .mosaic-item:hover img {
    transform: scale(1.05);
  }


  .mosaic-big {
    grid-row: span 3;
  }


  .mosaic-small {
    grid-row: span 1;
  }

  .mosaicSwiper {
    max-width: 1200px;
    margin: 0 auto;
  }

  .mosaic-item {
    height: 320px;
    overflow: hidden;
    border-radius: 10px;
  }

  .mosaic-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: 0.4s;
  }

  .mosaic-item:hover img {
    transform: scale(1.05);
  }

  @media(min-width: 1200px) {

    .mosaicSwiper .swiper-slide {
      width: auto !important;
    }

    .mosaicSwiper .swiper-wrapper {
      display: grid;
      grid-template-columns: 2fr 1fr;
      grid-template-rows: repeat(3, 1fr);
      gap: 15px;
      height: 600px;
      grid-auto-flow: row;
    }

    .mosaic-item {
      height: 100%;
    }

    .mosaic-item:nth-child(1) {
      grid-row: 1 / 4;
    }

  }

  @media(max-width: 768px) {
    .mosaicSwiper {
      width: 100%;
      height: 300px;
    }

    .mosaic-big {
      grid-row: span 1;
    }

    .mosaic-item {
      height: 220px;
    }
    .mosaic-gallery-title h2{
      font-size: 24px;
    }

    .mosaic-gallery-title p {
      font-size:  14px;
    }
  }


  .fade-up {
    opacity: 0;
    transform: translateY(80px);
    transition: opacity 0.8s ease
    , transform 0.8s ease;
  }

  .fade-up.show {
    opacity: 1;
    transform: translateY(0);
  }

  .mosaic-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .mosaic-item:nth-child(2) {
    transition-delay: 0.2s;
  }
  .mosaic-item:nth-child(3) {
    transition-delay: 0.3s;
  }
  .mosaic-item:nth-child(4) {
    transition-delay: 0.4s;
  }

</style>

<script>
  let mosaicSwiperInstance = null;

  function initMosaicSwiper() {
    const swiperEl = document.querySelector(".mosaicSwiper");
    if (!swiperEl) return;

    const isDesktop = window.innerWidth >= 1200;

    // Desktop: tắt Swiper để CSS grid hoạt động
    if (isDesktop) {
      if (swiperEl.swiper) {
        swiperEl.swiper.destroy(true, true);
      }
      mosaicSwiperInstance = null;
      return;
    }

    // Mobile/tablet: bật Swiper
    if (swiperEl.swiper) {
      swiperEl.swiper.destroy(true, true);
    }

    mosaicSwiperInstance = new Swiper(".mosaicSwiper", {
      spaceBetween: 15,
      slidesPerView: 1.25,
      loop: true,

      autoplay: {
        delay: 2500,
        disableOnInteraction: false,
        pauseOnMouseEnter: false
      },

      grid: {
        rows: 1
      },

      breakpoints: {
        640: {
          slidesPerView: 2,
          grid: {
            rows: 1
          }
        },
        992: {
          slidesPerView: 2,
          grid: {
            rows: 1
          }
        }
      }
    });
  }

  document.addEventListener("shopify:section:load", initMosaicSwiper);
  window.addEventListener("load", initMosaicSwiper);
  window.addEventListener("resize", initMosaicSwiper);
</script>

{% schema %}
  {
    "name": "Mosaic Image Grid",
    "settings": [
      {
        "type": "text",
        "id": "gallery_heading",
        "label": "Tiêu đề Gallery"
      }, {
        "type": "textarea",
        "id": "gallery_description",
        "label": "Mô tả Gallery"
      }
    ],
    "blocks": [
      {
        "type": "image",
        "name": "Image",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Mosaic Image Grid"
      }
    ]
  }
{% endschema %}