{% comment %}
  Full Image Section – No Padding No Margin
{% endcomment %}

<section class="full-image-section">
  {% if section.settings.image != blank %}
    <img
      src="{{ section.settings.image | image_url: width: 3000 }}"
      alt=""
      loading="lazy">
  {% endif %}
</section>

<style>
/* ================= FULL IMAGE ONLY ================= */
.full-image-section {
    background-color: #000212;
  margin: 0;
  padding: 0;
  width: 100%;
  line-height: 0;
  
}

.full-image-section img {
  display: block;
  width: 60%;
  height: auto;
  margin: 0 auto;
  padding: 0;
}
</style>

{% schema %}
{
  "name": "Full Image Only",
  "tag": "section",
  "class": "section-full-image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Full Image Only"
    }
  ]
}
{% endschema %}
