{% liquid
  assign gen_id = section.id | replace: '_', '' | downcase
  assign selected_collection = collections[section.settings.collection]
  assign product_limit = section.settings.max_products | default: 4
  assign highlight_enabled = section.settings.enable_highlight
  assign highlight_product = section.settings.highlight_product
  assign products_reversed = selected_collection.products | reverse
%}

<section
  id="pricing-plans-{{ section.id }}"
  class="pricing-plans pricing-plans-{{ gen_id }}"
>
  {% if section.settings.scroll_pricing_table != blank %}
  <button
    type="button"
    class="price-scroll-float"
    data-target="#pricing-plans-{{ section.id }}"
  >
    {{ section.settings.scroll_pricing_table }}
  </button>
{% endif %}

  <div class="pricing-plans__inner">
    {% if section.settings.top_image %}
      <div class="bg-image-{{ gen_id }} is-top">
        {{ section.settings.top_image | image_url: width: 2400 | image_tag }}
      </div>
    {% endif %}

    <div class="pricing-plans-middle-{{ gen_id }}">
      <div class="pricing-plans-content-{{ gen_id }}">
        <div class="pricing-plans__header">
          {% if section.settings.heading != blank %}
            <h2 class="pricing-plans__title">
              {{ section.settings.heading }}
            </h2>
          {% endif %}
        </div>

        {% if selected_collection and selected_collection.products_count > 0 %}
          <div class="pricing-plans__cards">
            {% for product in products_reversed limit: product_limit %}
              {% assign features = product.metafields.custom.features.value %}
              {% assign is_highlight = false %}
              {% if highlight_enabled and highlight_product == product.id %}
                {% assign is_highlight = true %}
              {% endif %}

              <article class="pricing-plans__card{% if is_highlight %} is-highlight{% endif %}">
                <div class="pricing-plans__card-body">
                  <h3 class="pricing-plans__plan-title">
                    {{ product.title }}
                  </h3>

                  <div class="pricing-plans__price-row">
                    <span class="pricing-plans__price">
                      {{ product.price | money }}
                    </span>
                  </div>

                  {% if features %}
                    <div class="pricing-plans__features">
                      {% assign feature_icon_url = 'priceIcon.svg' | asset_url %}
                      {% for feature in features %}
                        <div class="pricing-plans__feature">
                          <span class="pricing-plans__feature-icon img">
                            <img
                              src="{{ feature_icon_url }}"
                              alt="Included"
                              loading="lazy"
                              width="16"
                              height="16"
                            >
                          </span>
                          <span class="pricing-plans__feature-text">
                            {{ feature }}
                          </span>
                        </div>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>

                {% if section.settings.cta_label != blank %}
                  {% unless section.settings.hide_cta_vietnam and localization.country.iso_code == 'VN' %}
                    <div class="pricing-plans__cta-wrap">
                      <a href="{{ product.url }}" class="pricing-plans__cta">
                        {{ section.settings.cta_label }}
                      </a>
                    </div>
                  {% endunless %}
                {% endif %}
              </article>
            {% endfor %}
          </div>

          <div class="pricing-plans__dots">
            {% for product in products_reversed limit: product_limit %}
              <span class="dot{% if forloop.first %} is-active{% endif %}"></span>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
                /* ===== SECTION ===== */
                #pricing-plans-{{ section.id }} {
                  background: #020313;
                  font-family: Inter, Arial, sans-serif;
                  color: #DFE1F4;
                  overflow-x: hidden;
                  --bg-overlap: 400px;
                }

                /* ===== INNER ===== */
                .pricing-plans__inner {
                  max-width: 1600px;
                  margin: 0 auto;
                  position: relative;
                }

              .bg-image-{{ gen_id }} {
                position: relative;
                left: 50%;
                right: 50%;
                margin-left: -50vw;
                margin-right: -50vw;

                width: 100vw;
                height: 700px;

                border-radius: 40px;
                overflow: hidden;
                z-index: 1;
              }

              .pricing-plans__cta-wrap {
                  margin-top: 28px;
                }

                .bg-image-{{ gen_id }} img {
                  width: 100%;
                  height: 100%;
                  object-fit: cover;
                }

                /* BG ANIMATION */
                .bg-image-{{ gen_id }}.is-top {
                  opacity: 0;
                  transform: translateY(140px);
                  transition:
                    opacity 2.1s cubic-bezier(.22,1,.36,1),
                    transform 2.1s cubic-bezier(.22,1,.36,1);
                }

                .bg-image-{{ gen_id }}.is-visible {
                  opacity: 1;
                  transform: translateY(0);
                }

                /* ===== MIDDLE (ĐÈ LÊN ẢNH) ===== */
                .pricing-plans-middle-{{ gen_id }} {
                  position: relative;
                  z-index: 2;
                  display: flex;
                  justify-content: center;
                  pointer-events: none;
                  margin-top: calc(-1 * var(--bg-overlap));
                }

                .pricing-plans-content-{{ gen_id }} {
                  pointer-events: auto;
                  width: 100%;
                  max-width: 1600px;
                  padding: 180px 24px 125px;
                }

                /* ===== HEADER ===== */
                .pricing-plans__header {
                  text-align: center;
                  margin-bottom: 72px;
                }

          .pricing-plans__title {
            font-size: 48px;
            font-weight: 500;
            line-height: 52px;
            letter-spacing: -1px;
            padding-bottom: 50px;

            background: radial-gradient(
              50% 100% at 50% 0%,
              #ffffff 30%,
              rgba(255, 255, 255, 0.5) 100%
            );

            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
          }


                .pricing-plans__subtitle {
                  margin-top: 16px;
                  font-size: 16px;
                  color: #DFE1F4;
                }

                /* ===== GRID ===== */
                .pricing-plans__cards {
                  display: grid;
                  grid-template-columns: repeat(4, minmax(300px, 1fr));
                  gap: 20px;
                }


                /* ===== CARD ===== */
                .pricing-plans__card {
                  background: #FFFFFF09;
                  border-radius: 20px;
                  padding: 20px 26px;
                  min-height: 560px;
                  display: flex;
                  flex-direction: column;
                  justify-content: space-between;
                  box-shadow: inset 0px 4px 1px -3px #FFFFFF40;
                  transition: all .3s ease;
                }

                .pricing-plans__card:hover {
                  background: #FFFFFF1A;
                }

                .pricing-plans__card.is-highlight {
                  background: #FFFFFF1A;
                  outline: 1px solid rgba(255,255,255,0.35);
                  transform: translateY(-4px);
                }

                /* ===== ANIMATIONS ===== */
                .pricing-plans--animate-ready .pricing-plans__title,
                .pricing-plans--animate-ready .pricing-plans__card {
                  opacity: 0;
                  transform: translateY(88px);
                  transition:
                    opacity 1.6s cubic-bezier(.18,.95,.2,1),
                    transform 1.6s cubic-bezier(.18,.95,.2,1);
                  transition-delay: var(--animate-delay, 0ms);
                  will-change: opacity, transform;
                }

                .pricing-plans--animate-ready .pricing-plans__title.is-visible {
                  opacity: 1;
                  transform: translateY(0);
                }

                .pricing-plans--animate-ready .pricing-plans__card.is-visible {
                  opacity: 1;
                  transform: translateY(0);
                }

                .pricing-plans--animate-ready .pricing-plans__card.is-visible.is-highlight {
                  transform: translateY(-4px);
                }

                /* ===== CONTENT ===== */
                .pricing-plans__plan-title {
                  font-size: 26px;
                  font-weight: 500;
                  color: #FFFFFF;
                }

                .pricing-plans__price-row {
                  margin-top: 18px;
                  display: flex;
                  justify-content: space-between;
                }

                .pricing-plans__features {
                  margin-top: 28px;
                }

                .pricing-plans__feature {
                  display: flex;
                  align-items: flex-start;
                  gap: 10px;
                  padding-top: 10px;
                  margin-top: 10px;
                  border-top: 1px solid #FFFFFF1A;
                }

                .pricing-plans__feature-icon {
                  width: 20px;
                  height: 20px;
                  display: inline-flex;
                  align-items: center;
                  justify-content: center;
                  flex-shrink: 0;
                  margin-top: 2px;
                }

                .pricing-plans__feature-icon.img img {
                  width: 16px;
                  height: 16px;
                  display: block;
                  object-fit: contain;
                }
                /* ===== CTA ===== */
                .pricing-plans__cta {
                  display: inline-block;
                  background: #FFFFFF;
                  color: #010314;
                  padding: 10px 20px;
                  border-radius: 999px;
                  font-weight: 500;
                  text-decoration: none;
                }

                /* ===== RESPONSIVE ===== */
             @media (max-width: 768px) {

        /* ===== GIẢM OVERLAP BG ===== */
        #pricing-plans-{{ section.id }} {
          --bg-overlap: 320px;
        }

        /* ===== BG IMAGE ===== */
        .bg-image-{{ gen_id }} {
          height: 360px;
          border-radius: 32px;
        }

        /* ===== CONTENT PADDING ===== */
        .pricing-plans-content-{{ gen_id }} {
          padding: 120px 16px 100px;
        }

        /* ===== HEADING ===== */
        .pricing-plans__title {
          font-size: 32px;
          line-height: 36px;
          padding-bottom: 120px;
        }

        /* ===== MOBILE SLIDER ===== */
      .pricing-plans__cards {
        display: flex;
        gap: 0;

        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        /* Allow both axes; JS will preventDefault only for horizontal drags */
        touch-action: auto;
        overscroll-behavior-x: contain;
        overscroll-behavior-y: auto;

        padding: 0;
      }

        .pricing-plans__card {
          flex: 0 0 100%;
          max-width: 100%;
          scroll-snap-align: start;
          cursor: grab;
        }

        .pricing-plans__cards.is-grabbing,
        .pricing-plans__card.is-grabbing {
          cursor: grabbing;
        }

        .pricing-plans__cards::-webkit-scrollbar {
          display: none;
        }
        .pricing-plans__cards {
          scrollbar-width: none;
        }
      }

      @media (max-width: 768px) {
      .pricing-plans__dots {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 14px;
      }

      .pricing-plans__dots .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.3);
        transition: all 0.25s ease;
      }

      .pricing-plans__dots .dot.is-active {
        background: #8b5cf6;
        transform: scale(1.4);
      }
    }

    .price-scroll-float {
    position: fixed;
    right: 25px;
    bottom: 100px;
    z-index: 9998;

    padding: 12px 18px;
    border-radius: 999px;
    border: none;

    background: #ffffff;
    color: #020313;

    font-size: 14px;
    font-weight: 600;
    cursor: pointer;

    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    transition:
      bottom 0.3s ease,
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  .price-scroll-float:hover {
    transform: translateY(-2px);
  }

  /* Khi contact đang mở thì đẩy nút bảng giá lên */
  body.contact-fab-open .price-scroll-float {
    bottom: 390px;
  }

  @media (max-width: 768px) {
    .price-scroll-float {
      right: 16px;
      bottom: 82px;

      padding: 10px 14px;
      font-size: 13px;
    }

    body.contact-fab-open .price-scroll-float {
      bottom: 300px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var priceBtn = document.querySelector('.price-scroll-float');

    if (!priceBtn) return;

    priceBtn.addEventListener('click', function () {
      var targetSelector = priceBtn.getAttribute('data-target');
      var target = document.querySelector(targetSelector);

      if (!target) return;

      var extraOffset = 350; 

      var targetPosition = target.getBoundingClientRect().top + window.pageYOffset + extraOffset;

      window.scrollTo({
        top: targetPosition,
        behavior: 'smooth',
      });
    });
  });
</script>

<script>
  (function () {
    const bg = document.querySelector('.bg-image-{{ gen_id }}.is-top');
    if (!bg) return;

    const observer = new IntersectionObserver(
      ([entry]) => {
        bg.classList.toggle('is-visible', entry.isIntersecting);
      },
      { threshold: 0.05 }
    );

    observer.observe(bg);
  })();
</script>

<script>
  (function () {
    const section = document.querySelector('#pricing-plans-{{ section.id }}');
    if (!section) return;

    const track = section.querySelector('.pricing-plans__cards');
    const cards = section.querySelectorAll('.pricing-plans__card');
    const dots = section.querySelectorAll('.pricing-plans__dots .dot');

    if (!track || !dots.length || !cards.length) return;

    const mobileMatch = window.matchMedia('(max-width: 768px)');

    track.addEventListener('scroll', () => {
      const index = Math.round(track.scrollLeft / track.offsetWidth);
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === index);
      });
    });

    // Enable click/drag (mouse) horizontal scrolling when in mobile layout.
    let isDragging = false;
    let dragStartX = 0;
    let dragStartScroll = 0;
    let dragStartY = 0;

    let horizontalLock = false;
    let pointerId = null;

    const startDrag = (event) => {
      if (!mobileMatch.matches) return;
      isDragging = true;
      dragStartX = event.clientX;
      dragStartY = event.clientY;
      dragStartScroll = track.scrollLeft;
      track.classList.add('is-grabbing');
      horizontalLock = false;
      pointerId = event.pointerId;
      if (pointerId != null && track.setPointerCapture) {
        track.setPointerCapture(pointerId);
      }
    };

    const onDrag = (event) => {
      if (!isDragging) return;
      const deltaX = event.clientX - dragStartX;
      const deltaY = event.clientY - dragStartY;

      // Lock into horizontal drag only when movement is clearly horizontal.
      if (!horizontalLock) {
        if (Math.abs(deltaX) > Math.abs(deltaY) + 6) {
          horizontalLock = true;
        } else if (Math.abs(deltaY) > Math.abs(deltaX) + 6) {
          endDrag();
          return;
        }
      }

      if (horizontalLock) {
        event.preventDefault();
        track.scrollLeft = dragStartScroll - deltaX;
      }
    };

    const endDrag = () => {
      isDragging = false;
      track.classList.remove('is-grabbing');
      if (pointerId != null && track.releasePointerCapture) {
        try {
          track.releasePointerCapture(pointerId);
        } catch (e) {}
      }
      pointerId = null;
    };

    track.addEventListener('pointerdown', startDrag, { passive: true });
    window.addEventListener('pointermove', onDrag, { passive: false });
    window.addEventListener('pointerup', endDrag, { passive: true });
    window.addEventListener('pointercancel', endDrag, { passive: true });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        track.scrollTo({
          left: index * track.offsetWidth,
          behavior: 'smooth',
        });
      });
    });
  })();
</script>

<script>
  (function () {
    const section = document.querySelector('#pricing-plans-{{ section.id }}');
    if (!section) return;

    const animatedItems = section.querySelectorAll('.pricing-plans__title, .pricing-plans__card');
    if (!animatedItems.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    section.classList.add('pricing-plans--animate-ready');

    if (prefersReducedMotion) {
      animatedItems.forEach((el) => el.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
          } else {
            entry.target.classList.remove('is-visible');
          }
        });
      },
      { threshold: 0.35 }
    );

    animatedItems.forEach((el, index) => {
      // Stagger cards for clearer motion; heading stays instant.
      if (el.classList.contains('pricing-plans__card')) {
        el.style.setProperty('--animate-delay', `${160 * index}ms`);
      }
      observer.observe(el);
    });
  })();
</script>

{% schema %}
{
  "name": "Pricing plans",
  "settings": [
    { "type": "image_picker", "id": "top_image", "label": "Top background image" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "max_products",
      "label": "Max products",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "hide_cta_vietnam",
      "label": "Hide CTA for Vietnam market",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Try now"
    },
    {
      "type": "checkbox",
      "id": "enable_highlight",
      "label": "Enable highlight"
    },
    {
      "type": "product",
      "id": "highlight_product",
      "label": "Highlight product"
    },
    {
      "type": "text",
      "id": "scroll_pricing_table",
      "label": "Scroll Pricing Table"
    }
  ],
  "presets": [{ "name": "Pricing plans" }]
}
{% endschema %}
