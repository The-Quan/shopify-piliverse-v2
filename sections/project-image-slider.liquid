<div class="project-slider">

  <div class="title-slider">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p>{{ section.settings.description }}</p>
    {% endif %}
  </div>

  <div class="swiper projectSwiper">
    <div class="swiper-wrapper">

      {% for block in section.blocks %}
        <div class="swiper-slide" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image
 | image_url: width: 1200
 | image_tag:
 class: 'slider-image',
 loading: 'lazy',
 widths: '400,600,800,1000,1200',
 sizes: '(min-width: 990px) 1200px, 100vw'
            }}
          {% endif %}
        </div>
      {% endfor %}

    </div>
  </div>
</div>


<style>
  .project-slider {
    background: #020414;
    padding: 60px 0;
  }

  .project-slider .title-slider {
    max-width: 1200px;
    margin: 0 auto;
    height: 150px;
    text-align: center;
  }

  .project-slider .title-slider h2 {
    color: white;

  }

  .title-slider h2 {
    color: white;
    opacity: 0;
    transform: translateY(100px);
    transition: opacity 1.5s ease
    , transform 1.5s ease;
  }

  .title-slider p {
    color: white;
    font-size: 16px;
    margin-bottom: 30px;
    opacity: 0;
    transform: translateY(100px);
    transition: opacity 1.5s ease
    , transform 1.5s ease;
  }

  .title-slider h2.show-title {
    opacity: 1;
    transform: translateY(0);
  }

  .title-slider h2.show-title,
  .title-slider p.show-title {
    opacity: 1;
    transform: translateY(0);
  }

  .project-slider .swiper-slide {
    width: 100%;
    height: 500px;
    overflow: hidden;
  }

  .project-slider .swiper.projectSwiper {
    max-width: 1200px;
    height: auto;
  }

  .slider-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .swiper.projectSwiper {
    margin-top: 30px;
  }

  .swiper-slide {
    opacity: 0;
    transform: translateY(60px);
    transition: opacity 1.5s ease
    , transform 1.5s ease;
  }

  .swiper-slide.show-slide {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 990px) {

    .project-slider .title-slider {
      height: auto;
      padding: 40px 20px;
    }

    .project-slider .title-slider h2 {
      font-size: 28px;
      line-height: 1.3;
    }

    .title-slider p {
      font-size: 16px;
      display: block;
      margin-top: 10px;
    }

    .project-slider .swiper-slide {
      height: auto;
    }

  }

  /* Mobile */
  @media (max-width: 640px) {

    .project-slider {
      padding: 20px 0;
    }

    .project-slider .title-slider {
      padding: 30px 15px;
    }

    .project-slider .title-slider h2 {
      font-size: 22px;
    }

    .title-slider p {
      font-size: 14px;
    }

    .project-slider .swiper.projectSwiper {
      padding: 0 15px;
    }

    .project-slider .swiper-slide {
      height: auto;
    }

    .slider-image {
      border-radius: 10px;
    }

  }

  .swiper-slide:nth-child(1) {
    transition-delay: 0.1s
  }
  .swiper-slide:nth-child(2) {
    transition-delay: 0.2s
  }
  .swiper-slide:nth-child(3) {
    transition-delay: 0.3s
  }
  .swiper-slide:nth-child(4) {
    transition-delay: 0.4s
  }
  .swiper-slide:nth-child(5) {
    transition-delay: 0.5s
  }
  .swiper-slide:nth-child(6) {
    transition-delay: 0.6s
  }
</style>

<script>
  
  function initprojectSlider(){
  new Swiper(".projectSwiper", {
    spaceBetween: 20,
    loop: true,
  
    slidesPerView: 1,
      speed: 800,
      autoplay: {
      delay: 2000, 
      disableOnInteraction: false,
      pauseOnMouseEnter: true
    },
  
   breakpoints: {
  0: {
    slidesPerView: 1.2
  },
  640: {
    slidesPerView: 2
  },
  990: {
    slidesPerView: 3
  },
  1200: {
    slidesPerView: 4
  }
  },
  
    pagination: {
      el: ".swiper-pagination",
      clickable: true,
    },
  
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    }
  });
  }
  
  document.addEventListener("DOMContentLoaded", initprojectSlider);
  
  document.addEventListener("shopify:section:load", initprojectSlider);
  
  function initScrollAnimation(){
  
  const section = document.querySelector(".project-slider");
  const slides = document.querySelectorAll(".projectSwiper .swiper-slide");
  
  const observer = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
  
      if(entry.isIntersecting){
  
        slides.forEach((slide,index)=>{
          setTimeout(()=>{
            slide.classList.add("show-slide");
          }, index * 150);
        });
  
      }else if(entry.boundingClientRect.top > 0){
  
        slides.forEach(slide=>{
          slide.classList.remove("show-slide");
        });
  
      }
  
    });
  },{
    threshold:0.15,
    rootMargin:"0px 0px -100px 0px"
  });
  
  observer.observe(section);
  }
  
  document.addEventListener("DOMContentLoaded", initScrollAnimation);
  document.addEventListener("shopify:section:load", initScrollAnimation);
  
  function initTitleAnimation(){
  
  const titles = document.querySelectorAll(".title-slider h2, .title-slider p");
  
  const observer = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
  
      if(entry.isIntersecting){
        entry.target.classList.add("show-title");
      }else if(entry.boundingClientRect.top > 0){
        entry.target.classList.remove("show-title");
      }
  
    });
  },{
    threshold:0.2,
    rootMargin:"0px 0px -80px 0px"
  });
  
  titles.forEach(title=>{
    observer.observe(title);
  });
  
  }
  
  document.addEventListener("DOMContentLoaded", initTitleAnimation);
  document.addEventListener("shopify:section:load", initTitleAnimation);
  
   const sliderEl = document.querySelector(".projectSwiper");
  
  sliderEl.addEventListener("touchstart", () => {
    swiper.autoplay.stop();
  });
  
  sliderEl.addEventListener("touchend", () => {
    swiper.autoplay.start();
  });
</script>

{% schema %}
  {
    "name": "Project Image Slider",
    "tag": "section",
    "class": "section-project-slider",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Tiêu đề"
      }, {
        "type": "textarea",
        "id": "description",
        "label": "Mô tả"
      }
    ],
    "blocks": [
      {
        "type": "slide",
        "name": "Slide image",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Project Image Slider"
      }
    ]
  }
{% endschema %}