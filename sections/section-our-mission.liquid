{% comment %} 
    Mission Section – Slide Up (Core Services Logic) 
{% endcomment %}

<section class="mission-section section-mission-slide">

  <div class="mission-container">
    {% if section.settings.heading != blank %}
      <h2 class="mission-title">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.content != blank %}
      <div class="mission-desc">
        {{ section.settings.content }}
      </div>
    {% endif %}
  </div>

</section>

<style>
  /* ================= BASE ================= */
  .mission-section {
    position: relative;
    padding-top: 100px;
    background: #000212;
    text-align: center;
    overflow: hidden;
  }

  .mission-container {
    max-width: 900px;
    margin: 0 auto;
  }

  /* ================= TITLE ================= */
  .mission-title {
    font-size: 48px;
    font-weight: 600;
    margin-bottom: 24px;

    color: transparent;
    background: radial-gradient(50% 100% at 50% 50%, #ffffff 35%, rgba(255, 255, 255, 0.55) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    line-height: 1.2;
  }

  /* ================= DESC (GRADIENT TEXT) ================= */
  .mission-desc {
    font-size: 16px;
    line-height: 1.8;

    color: transparent;
    background: radial-gradient(50% 100% at 50% 50%, #ffffff 30%, rgba(255, 255, 255, 0.5) 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  /* ================= SCROLL ANIMATION ================= */
.section-mission-slide .mission-container {
  opacity: 1;
  transform: none;
}

.js-animate
.section-mission-slide.is-prepare
.mission-container {
  opacity: 0;
  transform: translateY(40px);
}

.js-animate
.section-mission-slide.is-animate
.mission-container {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 1.5s ease, transform 1.5s ease;
}



  /* ================= MOBILE ================= */
  @media (max-width: 768px) {
    .mission-section {
      padding: 50px 16px;
    }

    .mission-title {
      font-size: 28px;
    }

    .mission-desc {
      font-size: 14px;
    }
  }
</style>

{% schema %}
  {
    "name": "Mission – Slide Up",
    "tag": "section",
    "class": "section-mission-slide",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Our Mission"
      }, {
        "type": "richtext",
        "id": "content",
        "label": "Content",
        "default": "<p>Your mission description goes here.</p>"
      }
    ],
    "presets": [
      {
        "name": "Mission – Slide Up"
      }
    ]
  }
{% endschema %}
<script>
document.addEventListener('DOMContentLoaded', () => {
  const section = document.querySelector('.section-mission-slide');
  if (!section) return;

  document.documentElement.classList.add('js-animate');

  let lastScrollY = window.scrollY;
  let hasAnimated = false;

  const observer = new IntersectionObserver(
    ([entry]) => {
      const currentScrollY = window.scrollY;
      const scrollingDown = currentScrollY > lastScrollY;
      lastScrollY = currentScrollY;

      // ENTER viewport
      if (entry.isIntersecting) {
        if (scrollingDown) {
          // ⏬ từ trên xuống → animate
          section.classList.remove('is-prepare');
          section.classList.add('is-animate');
          hasAnimated = true;
        } else {
          // ⏫ từ dưới lên → hiện ngay, không animate
          section.classList.remove('is-prepare', 'is-animate');
        }
      }

      // EXIT viewport (để lần sau còn animate lại)
      if (!entry.isIntersecting) {
        section.classList.remove('is-animate');
        section.classList.add('is-prepare');
      }
    },
    { threshold: 0.3 }
  );

  // Chuẩn bị trạng thái ban đầu
  section.classList.add('is-prepare');
  observer.observe(section);
});
</script>
