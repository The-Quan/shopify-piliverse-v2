<div class="camp-image">

  <div class="title-camp-image fade-up-camp">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p>{{ section.settings.description }}</p>
    {% endif %}
  </div>

  <div class="swiper campSwiper">

    <div class="swiper-wrapper">

      {% for block in section.blocks %}
        <div class="swiper-slide camp-gallery-item fade-up-camp" {{ block.shopify_attributes }}>

          {% if block.settings.image != blank %}
            <div class="camp-image-click" data-img="{{ block.settings.image | image_url: width: 1600 }}">
              {{ block.settings.image
 | image_url: width: 800
 | image_tag }}
            </div>
          {% endif %}

        </div>
      {% endfor %}

    </div>

    {% render 'camp-lightbox' %}

  </div>

</div>
<script src="https://cdn.jsdelivr.net/npm/@panzoom/panzoom/dist/panzoom.min.js" defer></script>
<style>
  .camp-image {
    width: 100%;
    height: auto;
    background: #020414;
    padding: 80px 0;
  }

  .title-camp-image,
  .campSwiper {
    width: 1200px;
    margin: 0 auto;
  }

  .title-camp-image {
    color: white;
    text-align: center;
    margin-bottom: 40px;
  }

  .title-camp-image h2 {
    font-size: 38px;
    line-height: 1.4;
    margin-bottom: 10px;
  }

  .title-camp-image p {
    font-size: 16px;
    opacity: 0.8;
  }

  .camp-gallery-item {
    height: 320px;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .camp-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .camp-gallery-item:hover img {
    transform: scale(1.08);
  }

  .camp-image-click {
    width: 100%;
    height: 100%;
    cursor: pointer;
  }

  .camp-lightbox {
    border: none;
    padding: 0;
    background: transparent;
  }

  .camp-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.90);
  }

  .camp-lightbox-inner {
    max-width: 95vw;
    height: 250px;
  }

  .camp-lightbox-img {
    max-width: 100%;
    height: 100%;
  }

  .camp-lightbox-close {
    position: fixed;
    top: 50px;
    right: 20px;
    font-size: 40px;
    color: white;
    cursor: pointer;
  }


  .camp-lightbox-controls {
    width: 100%;
    position: fixed;
    bottom: 50px;
    display: flex;
    justify-content: center;
    gap: 10px;
  }

  .camp-lightbox-controls button {
    width: 45px;
    height: 45px;
    font-size: 24px;
    border: none;
    border-radius: 6px;
    background: white;
    cursor: pointer;
  }

  .camp-lightbox-controls button:hover {
    background: #ddd;
  }


  @media (max-width: 1200px) {

    .title-camp-image,
    .campSwiper {
      width: 90%;
    }

  }


  @media (max-width: 992px) {

    .title-camp-image h2 {
      font-size: 30px;
    }

    .camp-gallery {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }

    .camp-gallery-item {
      height: 100%;
    }

  }


  @media (max-width: 768px) {

    .camp-image {
      padding: 60px 20px;
    }

    .campSwiper {
      width: 100%;
      height: 300px;
    }

    .title-camp-image h2 {
      font-size: 24px;
    }

    .title-camp-image p {
      font-size: 14px;
      line-height: 1.6;
    }

    .camp-gallery-item {
      height: 100%;
    }

    .camp-gallery-item img {
      transform: none !important;
      transition: none !important;
    }

    .camp-gallery-item:hover img {
      transform: none !important;
    }

  }

  .fade-up-camp {
    opacity: 0;
    transform: translateY(70px);
    transition: opacity 0.8s ease
    , transform 0.8s ease;
  }

  .fade-up-camp.show {
    opacity: 1;
    transform: translateY(0);
  }

  .camp-gallery-item:nth-child(1) {
    transition-delay: 0.1s;
  }

  .camp-gallery-item:nth-child(2) {
    transition-delay: 0.2s;
  }

  .camp-gallery-item:nth-child(3) {
    transition-delay: 0.3s;
  }

  .camp-gallery-item:nth-child(4) {
    transition-delay: 0.4s;
  }

  .camp-gallery-item:nth-child(5) {
    transition-delay: 0.5s;
  }

  .camp-gallery-item:nth-child(6) {
    transition-delay: 0.6s;
  }

</style>

<script>
  let campSwiperInstance = null;

  function initCampSwiper() {
    const campSwiperEl = document.querySelector(".campSwiper");

    if (!campSwiperEl) return;

    if (campSwiperInstance) {
      campSwiperInstance.destroy(true, true);
    }

    campSwiperInstance = new Swiper(".campSwiper", {
      spaceBetween: 15,
      slidesPerView: 2,
      slidesPerGroup: 1,
      loop: true,
      speed: 700,

      autoplay: {
        delay: 3000,
        disableOnInteraction: false,
        pauseOnMouseEnter: true
      },

      grid: {
        rows: 2,
        fill: "row"
      },

      breakpoints: {
        0: {
          slidesPerView: 1.25,
          slidesPerGroup: 1,
          grid: {
            rows: 1
          }
        },

        640: {
          slidesPerView: 2,
          slidesPerGroup: 1,
          grid: {
            rows: 1
          }
        },

        992: {
          slidesPerView: 2,
          slidesPerGroup: 1,
          grid: {
            rows: 2,
            fill: "row"
          }
        },

        1200: {
          slidesPerView: 2,
          slidesPerGroup: 1,
          grid: {
            rows: 2,
            fill: "row"
          }
        }
      }
    });
  }

  document.addEventListener("DOMContentLoaded", initCampSwiper);
  document.addEventListener("shopify:section:load", initCampSwiper);
</script>

<script>
  function initCampLightbox(){
  const zoomIn = document.querySelector(".camp-zoom-in");
  const zoomOut = document.querySelector(".camp-zoom-out");
  
  const items=document.querySelectorAll(".camp-image-click");
  const lightbox=document.querySelector(".camp-lightbox");
  const lightboxImg=document.querySelector(".camp-lightbox-img");
  const close=document.querySelector(".camp-lightbox-close");
  
  let panzoom;
  
  items.forEach(item=>{
  item.addEventListener("click",()=>{
  
  if(window.innerWidth > 768){
    return; 
  }
  
  lightboxImg.src=item.dataset.img;
  
  lightbox.showModal();
  
  setTimeout(()=>{
  
  panzoom = Panzoom(lightboxImg,{
  maxScale:5,
  minScale:1,
  contain:"outside"
  });
  
  lightbox.addEventListener("wheel",panzoom.zoomWithWheel);
  
  },100);
  
  });
  });
  
  close.addEventListener("click",()=>{
  lightbox.close();
  
  if(panzoom){
  panzoom.destroy();
  }
  });
  
  zoomIn.addEventListener("click",()=>{
  if(panzoom) panzoom.zoomIn();
  });
  
  zoomOut.addEventListener("click",()=>{
  if(panzoom) panzoom.zoomOut();
  });
  
  }
  
  document.addEventListener("DOMContentLoaded", initCampLightbox);
  document.addEventListener("shopify:section:load", initCampLightbox);
</script>

<script>
  function initFadeUpAnimation() {
  const elements = document.querySelectorAll('.fade-up-camp');
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('show');
        observer.unobserve(entry.target); 
      }
    });
  }, {
    threshold: 0.2
  });
  
  elements.forEach(el => observer.observe(el));
  }
  
  document.addEventListener("DOMContentLoaded", initFadeUpAnimation);
  document.addEventListener("shopify:section:load", initFadeUpAnimation);
</script>

{% schema %}
  {
    "name": "Camp Image",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Tiêu đề"
      }, {
        "type": "textarea",
        "id": "description",
        "label": "Mô tả"
      }
    ],
    "blocks": [
      {
        "type": "image",
        "name": "Image Item",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Select image"
          }
        ]
      }
    ],
    "max_blocks": 4,
    "presets": [
      {
        "name": "Camp Image"
      }
    ]
  }
{% endschema %}